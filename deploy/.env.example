# ULOO V2 - Development Environment Example
# Copy to .env and adjust values as needed

# Database (existing lightrag-pgvector container)
DB_USERNAME=lightrag
DB_PASSWORD=lightrag123
DB_DATABASE=dify
DB_PLUGIN_DATABASE=dify_plugin

# Redis is exposed by the existing host container. plugin_daemon reaches it
# through Docker Desktop's host gateway; no shared compose network is required.
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=

# Plugin Daemon
PLUGIN_DAEMON_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
PLUGIN_DIFY_INNER_API_KEY=QaHbTe77CtuXmsfyhR7+vRjI/+XbV1AaFy691iy+kGDv2Jvy0/eAh8Y1

# ULOO Core / Dify Console BFF
# Use the same long random value for ULOO Core's ULOO_API_TOKEN and Dify API's
# ULOO_CORE_API_TOKEN. This credential is server-to-server only.
ULOO_CORE_URL=http://host.docker.internal:8200
ULOO_CORE_API_TOKEN=replace-with-a-long-random-service-token

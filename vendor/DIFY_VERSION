# ULOO vendor baseline record.
#
# vendor/dify is a NESTED git repository with its own .git directory, deliberately
# excluded by the root .gitignore. It is NOT a submodule, so a fresh clone of this
# repository does not contain Dify source at all -- the root repo only tracks this
# file. Everything below is what a new machine needs in order to recreate it.
#
# Recreate:
#
#   git clone --depth 1 --branch <upstream_ref> <upstream> vendor/dify
#   git -C vendor/dify checkout -b <integration_branch>
#   git -C vendor/dify apply --check ../../patches/dify-uloo.patch
#   git -C vendor/dify apply ../../patches/dify-uloo.patch
#
# Remote convention (implementation plan section 2.1): `origin` must point at the
# team's own fork and `upstream` at the official repository. Only `upstream` is
# configured here, because the fork URL is not recorded anywhere in this project.
# Do not add an `origin` that points at the official repository -- that makes
# `git push origin` look legitimate while targeting someone else's repo.

dify_version = 1.16.1
upstream = https://github.com/langgenius/dify.git
upstream_ref = 1.16.1
integration_branch = uloo/integration
local_baseline_commit = cbd4e083927a20c69f026819b5abb6bb80773097
uloo_patch_file = patches/dify-uloo.patch
uloo_patch_sha256 = 0de85f296b197561bdbfe17137602cf1f327efaf5b89fe47f49cff5cb9122faa
# Keep dify_version in sync with vendor/dify/web/package.json.

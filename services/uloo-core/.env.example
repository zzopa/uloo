# ==============================================================================
# ULOO Core - 系统核心环境配置示例模板 (.env.example)
# ==============================================================================
# 使用指南：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 切换模型建议直接修改第 5 节的【通用 3 行参数】（Base URL、API Key、Model Name），即可全局无缝切换任何模型。
# 3. 修改后重启服务生效。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务与日志配置 (Application & Logging)
# ------------------------------------------------------------------------------
ULOO_APP_NAME="ULOO Core"
ULOO_DEBUG=false
ULOO_LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 2. PostgreSQL 数据库配置 (Database Connection)
# ------------------------------------------------------------------------------
ULOO_DB_HOST="localhost"
ULOO_DB_PORT=5432
ULOO_DB_USERNAME="lightrag"
ULOO_DB_PASSWORD="lightrag123"
ULOO_DB_DATABASE="uloo"
ULOO_DB_SCHEMA="public"

# ------------------------------------------------------------------------------
# 3. Redis 缓存与队列配置 (Redis Cache)
# ------------------------------------------------------------------------------
ULOO_REDIS_HOST="localhost"
ULOO_REDIS_PORT=6379
ULOO_REDIS_PASSWORD=""
ULOO_REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. API 访问与安全服务令牌 (API Authentication)
# ------------------------------------------------------------------------------
ULOO_API_PREFIX="/api/v1"
ULOO_API_TOKEN="uloo-dev-service-token-2026-local"

# ------------------------------------------------------------------------------
# 5. 通用大语言模型配置 (Universal LLM - 极简即插即用模式 ⭐推荐)
# ------------------------------------------------------------------------------
# 换模型只需改这 3 行！全局所有智能体均会自动适配：
ULOO_LLM_BASE_URL="http://172.26.197.154:3000/v1"
ULOO_LLM_API_KEY="sk-8mWhuPRMKYU9g5uQk8lykkbK14wRGNZ81fF5HEjhsfUklpdI"
ULOO_LLM_MODEL="DeepSeek-V3.1"

# 任务总时限预算（秒，推荐 900 秒）
ULOO_MODEL_TIMEOUT_SECONDS=900

# 是否启用 Agno 多智能体框架协同
ULOO_AGNO_ENABLED=true

# ------------------------------------------------------------------------------
# 5.1 多提供商高级配置 (Advanced Multi-Provider - 可选/向下兼容)
# ------------------------------------------------------------------------------
# 示例：若需指定多模型供应商端点
# ULOO_MODEL_PROVIDERS='{"deepseek":"https://api.deepseek.com/v1","openai":"https://api.openai.com/v1"}'
# ULOO_MODEL_PROVIDER_API_KEYS='{"deepseek":"sk-...","openai":"sk-..."}'
ULOO_MODEL_PROVIDERS='{"deepseek":"http://172.26.197.154:3000/v1"}'
ULOO_MODEL_PROVIDER_API_KEYS='{"deepseek":"sk-8mWhuPRMKYU9g5uQk8lykkbK14wRGNZ81fF5HEjhsfUklpdI"}'
ULOO_MODEL_PROVIDER_ALIASES='{"langgenius/deepseek/deepseek":"deepseek"}'
ULOO_MODEL_CATALOG='{"deepseek":["DeepSeek-V3.1","deepseek-chat","deepseek-reasoner"]}'
ULOO_PLANNER_MODEL_REF="deepseek:DeepSeek-V3.1"

# ------------------------------------------------------------------------------
# 6. Dify 知识库与工作流联动配置 (Dify Integration)
# ------------------------------------------------------------------------------
ULOO_DIFY_API_URL="http://localhost:5001"
ULOO_DIFY_INNER_API_KEY="QaHbTe77CtuXmsfyhR7+vRjI/+XbV1AaFy691iy+kGDv2Jvy0/eAh8Y1"

# 工作区与 Dify 账户/应用上下文绑定映射（JSON 格式，由各工作区 ID 映射对应的 Dify 凭证）
ULOO_DIFY_WORKSPACE_CALLERS='{"39dc2f4f-2dc3-4cc5-af5f-daad8ee83b6b":{"app_id":"97c4bff0-9c53-46af-9eef-59503ef17b85","user_id":"d99c7a94-8833-4449-8596-b46970904fb7"}}'

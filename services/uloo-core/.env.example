# ULOO Core - Development Environment Example
# Copy to .env and adjust values

# Application
ULOO_APP_NAME=ULOO Core
ULOO_DEBUG=true
ULOO_LOG_LEVEL=INFO

# Database
ULOO_DB_HOST=localhost
ULOO_DB_PORT=5432
ULOO_DB_USERNAME=lightrag
ULOO_DB_PASSWORD=lightrag123
ULOO_DB_DATABASE=uloo

# Redis
ULOO_REDIS_HOST=localhost
ULOO_REDIS_PORT=6379
ULOO_REDIS_PASSWORD=
ULOO_REDIS_DB=2

# API
ULOO_API_PREFIX=/api/v1
ULOO_API_TOKEN=replace-with-a-long-random-service-token

# Agno
ULOO_AGNO_ENABLED=true

# Model providers
ULOO_MODEL_PROVIDERS={}

# Dify-owned tool runtime (server-only; leave blank until configured)
ULOO_DIFY_API_URL=http://localhost:5001
ULOO_DIFY_INNER_API_KEY=
ULOO_DIFY_WORKSPACE_CALLERS={}

# ULOO Core - SiliconFlow model configuration
#
# Usage:
# 1. Copy these four variables into services/uloo-core/.env if they are absent.
# 2. Put your SiliconFlow API key between the empty quotes below.
# 3. Restart ULOO Core. Never put this key into Dify Web or an Agent form.
#
# SiliconFlow exposes chat completions at:
# https://api.siliconflow.cn/v1/chat/completions
# ULOO uses an OpenAI-compatible client, so its base URL must stop at /v1.

ULOO_MODEL_PROVIDERS={"siliconflow":"https://api.siliconflow.cn/v1"}
ULOO_MODEL_PROVIDER_API_KEYS={"siliconflow":""}
ULOO_MODEL_TIMEOUT_SECONDS=300
ULOO_PLANNER_MODEL_REF=siliconflow:deepseek-ai/DeepSeek-V4-Flash

# Agent model_ref value to select in ULOO:
# siliconflow:deepseek-ai/DeepSeek-V4-Flash

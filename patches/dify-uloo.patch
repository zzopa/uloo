index 0000000000000000000000000000000000000000..f972192825e3b3e23337a93abc45f3a36649d410
--- /dev/null
+++ b/web/features/uloo/runs/detail.tsx
@@ -0,0 +1,329 @@
+// AI生成
+'use client'
+
+import { useState } from 'react'
+import { Button } from '@langgenius/dify-ui/button'
+import { toast } from '@langgenius/dify-ui/toast'
+import { useMutation, useQuery } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import Link from '@/next/link'
+import { useRouter } from '@/next/navigation'
+import { consoleQuery } from '@/service/client'
+import { getUlooErrorInfo } from '../agents/error'
+import { createUlooRoutes } from '../routes'
+import { UlooPageHeading } from '../shared/page-heading'
+import { UlooPreviewBanner } from '../shared/preview-banner'
+import { UlooUnavailableState } from '../shared/unavailable-state'
+
+const EVENTS = [
+  {
+    time: '15:21:02',
+    agent: '需求分析 Agent',
+    text: '完成目标澄清，输出 14 条验收标准',
+    state: 'succeeded',
+  },
+  {
+    time: '15:21:18',
+    agent: '架构设计 Agent',
+    text: '生成服务边界与接口依赖图',
+    state: 'succeeded',
+  },
+  {
+    time: '15:21:36',
+    agent: '风险审查 Agent',
+    text: '正在复核预算、超时与恢复策略',
+    state: 'running',
+  },
+] as const
+
+export function UlooRunDetail({ runId, preview = false }: { runId: string; preview?: boolean }) {
+  const { t } = useTranslation('uloo')
+  const router = useRouter()
+  const routes = createUlooRoutes(preview)
+  const [showConfig, setShowConfig] = useState(false)
+  const runQuery = useQuery({
+    ...consoleQuery.uloo.runs.byRunId.get.queryOptions({
+      input: { params: { run_id: runId } },
+    }),
+    enabled: !preview,
+    retry: 1,
+  })
+  const startRun = useMutation(consoleQuery.uloo.tasks.byTaskId.runs.post.mutationOptions())
+
+  function retryRun() {
+    if (!run?.task_id) return
+    startRun.mutate(
+      { params: { task_id: run.task_id }, body: {} },
+      {
+        onSuccess: (newRun: { id: string }) => router.push(routes.run(newRun.id)),
+        onError: (error: unknown) => toast.error(getUlooErrorInfo(error).message),
+      },
+    )
+  }
+
+  if (!preview && (runQuery.isError || !runQuery.data))
+    return <UlooUnavailableState runtimeHref={routes.runtime} />
+
+  const run = runQuery.data
+  const status = preview ? 'running' : (run?.status ?? 'running')
+  const events = preview
+    ? EVENTS.map((event, index) => ({
+        id: event.time,
+        time: event.time,
+        source: event.agent,
+        text: event.text,
+        state: event.state,
+        sequence: index + 1,
+      }))
+    : (run?.events ?? []).map((event) => ({
+        id: event.id,
+        time: event.created_at ? new Date(event.created_at).toLocaleTimeString() : '—',
+        source:
+          typeof event.payload.name === 'string'
+            ? event.payload.name
+            : (event.source_id ?? event.source_type),
+        text: typeof event.payload.message === 'string' ? event.payload.message : event.event_type,
+        state: event.status ?? 'running',
+        sequence: event.sequence,
+        output: event.event_type === 'agent.completed' ? event.payload.output : undefined,
+      }))
+
+  // Timing analysis
+  const startedAt = run?.started_at ? new Date(run.started_at) : null
+  const finishedAt = run?.finished_at ? new Date(run.finished_at) : null
+  const durationMs = startedAt && finishedAt ? finishedAt.getTime() - startedAt.getTime() : null
+  const durationText = durationMs != null
+    ? durationMs < 1000 ? `${durationMs}ms` : `${(durationMs / 1000).toFixed(1)}s`
+    : '—'
+
+  // Usage breakdown
+  const totalTokens = run?.usage?.total_tokens ?? 0
+  const promptTokens = run?.usage?.prompt_tokens ?? 0
+  const completionTokens = run?.usage?.completion_tokens ?? 0
+
+  // Error analysis
+  const isFailed = status === 'failed'
+  const errorCode = run?.error_code ?? ''
+  const errorMessage = run?.error_message ?? ''
+  const errorSuggestions: Record<string, string> = {
+    MODEL_ERROR: t(($) => $.errorSuggestionModel),
+    TIMEOUT: t(($) => $.errorSuggestionTimeout),
+    INVALID_TEAM_CONFIGURATION: t(($) => $.errorSuggestionTeam),
+    RuntimeConfigurationError: t(($) => $.errorSuggestionRuntime),
+  }
+  const suggestion = errorCode ? (errorSuggestions[errorCode] ?? t(($) => $.errorSuggestionGeneric)) : ''
+
+  // Status badge class
+  const statusBadgeClass = {
+    running: 'bg-components-badge-status-light-warning-bg text-components-badge-status-light-warning-text',
+    succeeded: 'bg-components-badge-status-light-success-bg text-components-badge-status-light-success-text',
+    failed: 'bg-components-badge-status-light-error-bg text-components-badge-status-light-error-text',
+  }[status as string] ?? 'bg-background-section-burn text-text-tertiary'
+
+  return (
+    <div className="space-y-6">
+      <UlooPageHeading
+        title={runId}
+        description={t(($) => $.runsPageHint)}
+        icon="i-ri-pulse-line"
+        backHref={routes.runs}
+        backLabel={t(($) => $.runs)}
+        badge={
+          <span className={`rounded-md px-2 py-1 text-[11px] font-semibold ${statusBadgeClass}`}>
+            {status}
+          </span>
+        }
+        actions={preview ? <UlooPreviewBanner /> : undefined}
+      />
+      <section className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
+        {[
+          [t(($) => $.taskId), preview ? 'demo-new' : (run?.task_id ?? '—')],
+          [t(($) => $.teams), preview ? '产品研发协同组' : (run?.team_id ?? '—')],
+          [t(($) => $.runtimeVersion), 'agno 1.8.4'],
+          [t(($) => $.traceId), preview ? 'tr_demo_93ac8f' : (run?.agno_run_id ?? '—')],
+        ].map(([label, value]) => (
+          <div
+            key={label}
+            className="rounded-xl border border-components-panel-border bg-background-default p-4"
+          >
+            <div className="text-xs text-text-tertiary">{label}</div>

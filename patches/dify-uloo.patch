@@ -0,0 +1,59 @@
+'use client'
+
+import { Button } from '@langgenius/dify-ui/button'
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
+import Link from 'next/link'
+import { buildIntegrationPath } from '@/app/components/integrations/routes'
+import { get, post } from '@/service/base'
+
+type DifyTool = {
+  key: string
+  name: string
+  description: string
+  provider_name: string
+  enabled: boolean
+  unavailable_reason: string
+  config: { provider_type: string; tool_schema: Record<string, unknown> }
+}
+
+export function DifyToolCatalog({ imported }: { imported: string[] }) {
+  const client = useQueryClient()
+  const catalog = useQuery({
+    queryKey: ['uloo', 'dify-tools'],
+    queryFn: () => get<{ tools: DifyTool[]; unavailable: { provider_name: string; message: string }[] }>('/uloo/dify-tools'),
+  })
+  const mutation = useMutation({
+    mutationFn: (key: string) => post('/uloo/dify-tools/import', { body: { key } }),
+    onSuccess: () => { void client.invalidateQueries({ queryKey: ['uloo', 'tools'] }) },
+  })
+  return (
+    <section className="space-y-3 rounded-xl border border-components-panel-border p-5">
+      <div className="flex items-center justify-between gap-3">
+        <h2 className="font-semibold">Dify 工具目录</h2>
+        <Link href={buildIntegrationPath('builtin')}>在 Dify 中管理工具</Link>
+      </div>
+      <p>从 Dify 导入工具引用，在智能体或技能中绑定。插件、MCP、凭据和工作流继续在 Dify 中管理。</p>
+      <div className="flex gap-4">
+        <Link href={buildIntegrationPath('mcp')}>MCP 服务</Link>
+        <Link href={buildIntegrationPath('custom-tool')}>自定义 API 工具</Link>
+        <Link href={buildIntegrationPath('workflow-tool')}>工作流工具</Link>
+        <Button disabled={catalog.isFetching} onClick={() => { void catalog.refetch() }}>刷新目录</Button>
+      </div>
+      {catalog.isLoading && <p role="status">正在读取 Dify 工具…</p>}
+      {(catalog.isError || mutation.isError) && <p role="alert">{mutation.error?.message ?? catalog.error?.message}</p>}
+      {catalog.data?.unavailable.map(item => <p role="alert" key={item.provider_name}>{item.provider_name}：{item.message}</p>)}
+      {catalog.data?.tools.length === 0 && <p>当前工作区没有可导入的工具，请先在 Dify 中添加工具。</p>}
+      {catalog.data?.tools.map(item => (
+        <article key={item.key} className="space-y-2 border-t border-components-panel-border pt-3">
+          <h3>{item.name} · {item.provider_name} · {item.config.provider_type}</h3>
+          <p>{item.description}</p>
+          {!item.enabled && <p>{item.unavailable_reason}</p>}
+          <details><summary>查看调用参数</summary><pre className="overflow-auto text-xs">{JSON.stringify(item.config.tool_schema, null, 2)}</pre></details>
+          <Button disabled={!item.enabled || imported.includes(item.key) || mutation.isPending} onClick={() => mutation.mutate(item.key)}>
+            {imported.includes(item.key) ? '已导入，可绑定智能体' : '导入工具引用'}
+          </Button>
+        </article>
+      ))}
+    </section>
+  )
+}
diff --git a/web/features/uloo/tools/library.tsx b/web/features/uloo/tools/library.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a95a856a37743fb8904fd778ba74213f80e0cd33
--- /dev/null
+++ b/web/features/uloo/tools/library.tsx
@@ -0,0 +1,371 @@
+// AI生成
+'use client'
+
+import { Button } from '@langgenius/dify-ui/button'
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import InlineDeleteConfirm from '@/app/components/base/inline-delete-confirm'
+import { del, get, patch, post } from '@/service/base'
+import { UlooPageHeading } from '../shared/page-heading'
+import { UlooPreviewBanner } from '../shared/preview-banner'
+
+export type Resource = {
+  key: string
+  name: string
+  description: string
+  enabled: boolean
+  version: number
+  config: {
+    tool_type?: string
+    provider_type?: string
+    provider_id?: string
+    tool_name?: string
+    tool_schema?: Record<string, unknown>
+    adapter?: string
+    query_prefix?: string
+    max_results?: number
+    instructions?: string[]
+    tool_refs?: string[]
+    scenarios?: string
+    steps?: string[]
+    result_format?: string
+    quality_checks?: string[]
+  }
+}
+export type ResourceKind = 'tools' | 'skills'
+export const resourceQuery = (kind: ResourceKind) => ({
+  queryKey: ['uloo', kind],
+  queryFn: () => get<Resource[]>(`/uloo/${kind}`),
+})
+
+export function UlooResourceLibrary({
+  kind,
+  preview = false,
+}: {
+  kind: ResourceKind
+  preview?: boolean
+}) {
+  const { t } = useTranslation('uloo')
+  const client = useQueryClient()
+  const catalog = useQuery({ ...resourceQuery(kind), enabled: !preview })
+  const [deleting, setDeleting] = useState<string>()
+  const [editing, setEditing] = useState<Resource | null>()
+  const mutation = useMutation({
+    mutationFn: async ({ action, item }: { action: 'save' | 'delete'; item: Resource }) => {
+      const url = `/uloo/${kind}/${encodeURIComponent(item.key)}`
+      if (action === 'delete') return del(url)
+      const { version, ...body } = item
+      if (!editing) return post(`/uloo/${kind}`, { body })
+      const { key: _key, ...update } = body
+      return patch(url, { body: { ...update, expected_version: version } })
+    },
+    onSuccess: () => {
+      setEditing(undefined)
+      setDeleting(undefined)
+      void client.invalidateQueries({ queryKey: ['uloo', kind] })
+    },
+  })
+  return (
+    <div className="space-y-5">
+      <UlooPageHeading
+        title={kind === 'tools' ? t(($) => $.toolLibrary) : t(($) => $.skillLibrary)}
+        description={t(($) => $.resourceLibraryHint)}
+        icon="i-ri-tools-line"
+        actions={
+          preview ? (
+            <UlooPreviewBanner />
+          ) : kind === 'tools' ? null : (
+            <Button
+              disabled={mutation.isPending}
+              onClick={() => {
+                mutation.reset()
+                setEditing(null)
+              }}
+            >
+              {t(($) => $.addResource)}
+            </Button>
+          )
+        }
+      />
+      {catalog.isLoading && <p role="status">{t(($) => $.toolCatalogLoading)}</p>}
+      {(catalog.isError || mutation.isError) && (
+        <p role="alert">{String(mutation.error?.message ?? catalog.error?.message)}</p>
+      )}
+      {editing !== undefined && (
+        <ResourceEditor
+          key={editing?.key ?? 'new'}
+          kind={kind}
+          resource={editing}
+          pending={mutation.isPending}
+          onCancel={() => setEditing(undefined)}
+          onSave={(item) => mutation.mutate({ action: 'save', item })}
+        />
+      )}
+      {catalog.data?.map((item) => (
+        <article
+          key={item.key}
+          className="space-y-2 rounded-xl border border-components-panel-border p-5"
+        >
+          <h2 className="font-semibold">
+            {item.name} <span className="font-mono text-xs">{item.key}</span>
+          </h2>
+          <p>{item.description}</p>
+          <p>
+            {item.enabled ? t(($) => $.enabled) : t(($) => $.disabled)} · v{item.version}
+          </p>
+          {kind === 'skills' && (
+            <>
+              {item.config.scenarios && (
+                <p className="text-sm text-text-secondary">{t(($) => $.skillScenarios)}: {item.config.scenarios}</p>
+              )}
+              <p className="text-sm whitespace-pre-wrap">{item.config.instructions?.join('\n')}</p>
+              {item.config.steps && item.config.steps.length > 0 && (
+                <ol className="text-sm list-decimal pl-5">
+                  {item.config.steps.map((step, i) => <li key={i}>{step}</li>)}
+                </ol>
+              )}
+            </>
+          )}
+          {kind === 'tools' && item.config.tool_type === 'dify' ? (
+            <p className="text-sm text-text-tertiary">{t(($) => $.difyManagedHint)}</p>
+          ) : (
+          <div className="flex gap-2">
+            <Button
+              disabled={mutation.isPending}
+              onClick={() => {
+                mutation.reset()
+                setEditing(item)
+              }}
+            >
+              {t(($) => $.editResource)}
+            </Button>
+            {deleting === item.key ? (
+              <InlineDeleteConfirm
+                title={t(($) => $.deleteResourceConfirm)}
+                confirmText={t(($) => $.deleteResource)}
+                cancelText={t(($) => $.cancel)}
+                onCancel={() => setDeleting(undefined)}
+                onConfirm={() => {
+                  if (!mutation.isPending) mutation.mutate({ action: 'delete', item })
+                }}
+              />
+            ) : (
+              item.key !== 'web-search' && (
+                <Button
+                  disabled={mutation.isPending}
+                  onClick={() => {
+                    mutation.reset()
+                    setDeleting(item.key)
+                  }}
+                >
+                  {t(($) => $.deleteResource)}
+                </Button>
+              )
+            )}
+          </div>
+          )}
+        </article>
+      ))}
+      {!preview && catalog.data?.length === 0 && <p>{t(($) => $.emptyResourceLibrary)}</p>}
+    </div>
+  )
+}
+
+function ResourceEditor({
+  kind,
+  resource,
+  pending,
+  onSave,
+  onCancel,
+}: {
+  kind: ResourceKind
+  resource: Resource | null
+  pending: boolean
+  onSave: (item: Resource) => void
+  onCancel: () => void
+}) {
+  const { t } = useTranslation('uloo')
+  const tools = useQuery({ ...resourceQuery('tools'), enabled: kind === 'skills' })
+  const [selected, setSelected] = useState(resource?.config.tool_refs ?? [])
+  const control =
+    'block w-full rounded-lg border border-components-panel-border bg-background-default p-2'
+  return (
+    <form
+      className="space-y-3 rounded-xl border border-components-panel-border p-5"
+      onSubmit={(event) => {
+        event.preventDefault()
+        const form = new FormData(event.currentTarget)
+        onSave({
+          key: String(form.get('key')).trim(),
+          name: String(form.get('name')).trim(),
+          description: String(form.get('description')),
+          version: resource?.version ?? 0,
+          enabled: form.get('enabled') === 'on',
+          config:
+            kind === 'tools'
+              ? resource?.config.tool_type === 'dify' ? resource.config : {
+                  adapter: 'web-search',
+                  query_prefix: String(form.get('prefix')),
+                  max_results: Number(form.get('count')),
+                }
+              : {
+                  instructions: String(form.get('instructions'))
+                    .split('\n')
+                    .map((line) => line.trim())
+                    .filter(Boolean),
+                  tool_refs: selected,
+                  scenarios: String(form.get('scenarios') ?? ''),
+                  steps: String(form.get('steps') ?? '')
+                    .split('\n')
+                    .map((line) => line.trim())
+                    .filter(Boolean),
+                  result_format: String(form.get('result_format') ?? ''),
+                  quality_checks: String(form.get('quality_checks') ?? '')
+                    .split('\n')
+                    .map((line) => line.trim())
+                    .filter(Boolean),
+                },
+        })
+      }}
+    >
+      <label className="block">
+        {t(($) => $.agentKey)}
+        <input
+          className={control}
+          name="key"
+          required
+          readOnly={!!resource}
+          pattern="[A-Za-z][A-Za-z0-9._-]*"
+          maxLength={128}
+          defaultValue={resource?.key}
+        />
+      </label>
+      <label className="block">
+        {t(($) => $.resourceName)}
+        <input
+          className={control}
+          name="name"
+          required
+          maxLength={256}
+          defaultValue={resource?.name}
+        />
+      </label>
+      <label className="block">
+        {t(($) => $.description)}
+        <textarea
+          className={control}
+          name="description"
+          maxLength={2000}
+          defaultValue={resource?.description}
+        />
+      </label>
+      {kind === 'tools' ? (
+        resource?.config.tool_type === 'dify' ? <p>Dify 工具引用：{resource.config.provider_type} / {resource.config.tool_name}。工具参数和连接配置在 Dify 中管理。</p> : <>
+          <p>{t(($) => $.searchAdapterHint)}</p>
+          <label className="block">
+            {t(($) => $.searchPrefix)}
+            <input
+              className={control}
+              name="prefix"
+              maxLength={200}
+              defaultValue={resource?.config.query_prefix ?? ''}
+            />
+          </label>
+          <label className="block">
+            {t(($) => $.searchCount)}
+            <input
+              className={control}
+              name="count"
+              type="number"
+              required
+              min={1}
+              max={8}
+              defaultValue={resource?.config.max_results ?? 5}
+            />
+          </label>
+        </>
+      ) : (
+        <>
+          <label className="block">
+            {t(($) => $.skillScenarios)}
+            <textarea
+              className={control}
+              name="scenarios"
+              maxLength={2000}
+              defaultValue={resource?.config.scenarios ?? ''}
+            />
+          </label>
+          <label className="block">
+            {t(($) => $.skillInstructions)}
+            <textarea
+              className={control}
+              name="instructions"
+              required
+              defaultValue={resource?.config.instructions?.join('\n')}
+            />
+          </label>
+          <label className="block">
+            {t(($) => $.skillSteps)}
+            <textarea
+              className={control}
+              name="steps"
+              defaultValue={resource?.config.steps?.join('\n')}
+            />
+          </label>
+          <fieldset>
+            <legend>{t(($) => $.skillTools)}</legend>
+            {tools.isError && <p role="alert">{t(($) => $.toolCatalogError)}</p>}
+            {[...new Set([...(tools.data ?? []).map((item) => item.key), ...selected])].map(
+              (key) => (
+                <label key={key} className="mr-4 inline-flex gap-2">
+                  <input
+                    type="checkbox"
+                    checked={selected.includes(key)}
+                    onChange={(event) =>
+                      setSelected(
+                        event.target.checked
+                          ? [...selected, key]
+                          : selected.filter((ref) => ref !== key),
+                      )
+                    }
+                  />
+                  {key}
+                </label>
+              ),
+            )}
+          </fieldset>
+          <label className="block">
+            {t(($) => $.skillResultFormat)}
+            <textarea
+              className={control}
+              name="result_format"
+              maxLength={2000}
+              defaultValue={resource?.config.result_format ?? ''}
+            />
+          </label>
+          <label className="block">
+            {t(($) => $.skillQualityChecks)}
+            <textarea
+              className={control}
+              name="quality_checks"
+              defaultValue={resource?.config.quality_checks?.join('\n')}
+            />
+          </label>
+        </>
+      )}
+      <label className="flex gap-2">
+        <input name="enabled" type="checkbox" defaultChecked={resource?.enabled ?? true} />
+        {t(($) => $.enabled)}
+      </label>
+      <div className="flex gap-2">
+        <Button type="submit" disabled={pending}>
+          {t(($) => $.save)}
+        </Button>
+        <Button type="button" disabled={pending} onClick={onCancel}>
+          {t(($) => $.cancel)}
+        </Button>
+      </div>
+    </form>
+  )
+}

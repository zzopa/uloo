+          onClick={onDelete}
+        >
+          <span className="i-ri-delete-bin-line" />
+        </button>
+      </div>
+    </article>
+  )
+}
+
+export function UlooAgentsPage({ preview = false }: { preview?: boolean }) {
+  const { t } = useTranslation('uloo')
+  const routes = createUlooRoutes(preview)
+  const [search, setSearch] = useState('')
+  const deferredSearch = useDeferredValue(search.trim())
+  const [status, setStatus] = useState<StatusFilter>('all')
+  const [offset, setOffset] = useState(0)
+  const [editingAgent, setEditingAgent] = useState<UlooAgentResponse>()
+  const [editorOpen, setEditorOpen] = useState(false)
+  const [deletingAgent, setDeletingAgent] = useState<UlooAgentResponse>()
+  const [debuggingAgent, setDebuggingAgent] = useState<UlooAgentResponse>()
+  const [previewAgents, setPreviewAgents] = useState<UlooAgentResponse[]>([DEMO_AGENT])
+  const deleteAgent = useMutation(consoleQuery.uloo.agents.byAgentId.delete.mutationOptions())
+  const agents = useQuery({
+    ...consoleQuery.uloo.agents.get.queryOptions({
+      input: {
+        query: {
+          q: deferredSearch || undefined,
+          enabled: status === 'all' ? undefined : status === 'enabled',
+          offset,
+          limit: PAGE_SIZE,
+        },
+      },
+    }),
+    enabled: !preview,
+  })
+
+  const matchingPreviewAgents = previewAgents.filter((agent) => {
+    const matchesStatus =
+      status === 'all' || (status === 'enabled' ? agent.enabled : !agent.enabled)
+    if (!matchesStatus) return false
+    if (!deferredSearch) return true
+    const query = deferredSearch.toLocaleLowerCase()
+    return [agent.name, agent.key, agent.role].some((value) =>
+      value.toLocaleLowerCase().includes(query),
+    )
+  })
+  const items = preview
+    ? matchingPreviewAgents.slice(offset, offset + PAGE_SIZE)
+    : (agents.data?.items ?? [])
+  const total = preview ? matchingPreviewAgents.length : (agents.data?.total ?? 0)
+  const page = Math.floor(offset / PAGE_SIZE) + 1
+  const pageCount = Math.max(1, Math.ceil(total / PAGE_SIZE))
+  const hasFilters = Boolean(search || status !== 'all')
+  const statusOptions = [
+    { value: 'all', label: t(($) => $.all) },
+    { value: 'enabled', label: t(($) => $.enabled) },
+    { value: 'disabled', label: t(($) => $.disabled) },
+  ] satisfies Array<{ value: StatusFilter; label: string }>
+
+  function refresh() {
+    if (preview) return
+    void agents.refetch()
+  }
+
+  function openCreate() {
+    setEditingAgent(undefined)
+    setEditorOpen(true)
+  }
+
+  function openEdit(agent: UlooAgentResponse) {
+    setEditingAgent(agent)
+    setEditorOpen(true)
+  }
+
+  function confirmDelete() {
+    if (!deletingAgent || deleteAgent.isPending) return
+    if (preview) {
+      setPreviewAgents((current) => current.filter((agent) => agent.id !== deletingAgent.id))
+      toast.success(t(($) => $.agentDeleted))
+      setDeletingAgent(undefined)
+      return
+    }
+    deleteAgent.mutate(
+      { params: { agent_id: deletingAgent.id } },
+      {
+        onSuccess: () => {
+          toast.success(t(($) => $.agentDeleted))
+          setDeletingAgent(undefined)
+          refresh()
+        },
+        onError: (error) => toast.error(getUlooErrorInfo(error).message),
+      },
+    )
+  }
+
+  function savePreviewAgent(body: UlooAgentCreatePayload) {
+    const timestamp = new Date().toISOString()
+    if (editingAgent) {
+      setPreviewAgents((current) =>
+        current.map((agent) =>
+          agent.id === editingAgent.id
+            ? {
+                ...agent,
+                ...body,
+                description: body.description ?? null,
+                instructions: body.instructions ?? [],
+                tool_refs: body.tool_refs ?? [],
+        skill_refs: body.skill_refs ?? [],
+                knowledge_refs: body.knowledge_refs ?? [],
+                output_schema: body.output_schema ?? null,
+                enabled: body.enabled ?? true,
+                version: agent.version + 1,
+                updated_at: timestamp,
+              }
+            : agent,
+        ),
+      )
+      return
+    }
+
+    setPreviewAgents((current) => [
+      {
+        ...body,
+        id: crypto.randomUUID(),
+        description: body.description ?? null,
+        instructions: body.instructions ?? [],
+        tool_refs: body.tool_refs ?? [],
+        skill_refs: body.skill_refs ?? [],
+        knowledge_refs: body.knowledge_refs ?? [],
+        output_schema: body.output_schema ?? null,
+        enabled: body.enabled ?? true,
+        version: 1,
+        created_at: timestamp,
+        updated_at: timestamp,
+      },
+      ...current,
+    ])
+  }
+
+  function togglePreviewAgent(agentId: string) {
+    setPreviewAgents((current) =>
+      current.map((agent) =>
+        agent.id === agentId
+          ? {
+              ...agent,
+              enabled: !agent.enabled,
+              version: agent.version + 1,
+              updated_at: new Date().toISOString(),
+            }
+          : agent,
+      ),
+    )
+  }
+
+  const error = agents.isError ? getUlooErrorInfo(agents.error) : undefined
+
+  return (
+    <div className="space-y-5">
+      <section className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
+        <div>
+          <div className="flex items-center gap-2">
+            <div className="flex size-9 items-center justify-center rounded-xl bg-background-section-burn text-text-accent">
+              <span className="i-ri-robot-2-line text-lg" />
+            </div>
+            <h1 className="text-2xl font-semibold text-text-primary">{t(($) => $.agents)}</h1>
+          </div>
+          <p className="mt-2 max-w-2xl text-sm text-text-secondary">{t(($) => $.agentsPageHint)}</p>
+        </div>
+        <div className="flex items-center gap-3">
+          <Link href={routes.skills} className="text-sm text-text-accent">{t(($) => $.skillLibrary)}</Link>
+        <Button variant="primary" className="shrink-0 gap-1" onClick={openCreate}>
+          <span className="i-ri-add-line" />
+          {t(($) => $.createAgent)}
+        </Button>
+        </div>
+      </section>
+
+      <section className="rounded-2xl border border-components-panel-border bg-background-default p-4 shadow-xs">
+        <div className="flex flex-col gap-3 sm:flex-row sm:items-center">
+          <SearchInput
+            aria-label={t(($) => $.searchAgents)}
+            className="h-9 w-full sm:w-72"
+            value={search}
+            placeholder={t(($) => $.searchAgents)}
+            onValueChange={(value) => {
+              setSearch(value)
+              setOffset(0)
+            }}
+          />
+          <div className="flex gap-1 rounded-lg bg-background-section-burn p-1">
+            {statusOptions.map((option) => (
+              <button
+                key={option.value}
+                type="button"
+                className={`rounded-md px-3 py-1.5 text-xs font-medium transition-colors ${status === option.value ? 'bg-background-default text-text-primary shadow-xs' : 'text-text-tertiary hover:text-text-secondary'}`}
+                onClick={() => {
+                  setStatus(option.value)
+                  setOffset(0)
+                }}
+              >
+                {option.label}
+              </button>
+            ))}
+          </div>
+          <div className="text-xs text-text-tertiary sm:ml-auto">
+            {t(($) => $.agentTotal, { count: total })}
+          </div>
+        </div>
+      </section>
+
+      {preview && (
+        <section className="border-components-badge-status-light-info-border bg-components-badge-status-light-info-bg text-components-badge-status-light-info-text rounded-xl border px-4 py-3 text-sm">
+          {t(($) => $.agentsPreviewHint)}
+        </section>
+      )}
+
+      {error && (
+        <section className="border-components-badge-status-light-error-border rounded-xl border bg-components-badge-status-light-error-bg p-4">
+          <div className="text-components-badge-status-light-error-text font-medium">
+            {error.message}
+          </div>
+          {(error.traceId || error.requestId) && (
+            <div className="mt-1 font-mono text-xs text-text-tertiary">
+              {t(($) => $.traceId)} {error.traceId || error.requestId}
+            </div>
+          )}
+          <Button className="mt-3" size="small" variant="secondary" onClick={refresh}>
+            {t(($) => $.retry)}
+          </Button>
+        </section>
+      )}
+
+      {!preview && agents.isLoading && (
+        <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
+          {Array.from({ length: 6 }, (_, index) => (
+            <div
+              key={index}
+              className="h-52 animate-pulse rounded-xl border border-components-card-border bg-background-section-burn"
+            />
+          ))}
+        </div>
+      )}
+
+      {!agents.isLoading && !error && items.length > 0 && (
+        <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
+          {items.map((agent) => (
+            <AgentCard
+              key={agent.id}
+              agent={agent}
+              preview={preview}
+              onDebug={() => setDebuggingAgent(agent)}
+              onEdit={() => openEdit(agent)}
+              onChanged={refresh}
+              onDelete={() => setDeletingAgent(agent)}
+              onPreviewToggle={() => togglePreviewAgent(agent.id)}
+              detailHref={routes.agent(agent.id)}
+            />
+          ))}
+        </div>
+      )}
+
+      {!agents.isLoading && !error && items.length === 0 && (
+        <section className="flex min-h-72 flex-col items-center justify-center rounded-2xl border border-dashed border-components-panel-border bg-background-default px-6 text-center">
+          <div className="flex size-12 items-center justify-center rounded-xl bg-background-section-burn text-text-tertiary">
+            <span
+              className={hasFilters ? 'i-ri-search-line text-xl' : 'i-ri-robot-2-line text-xl'}
+            />
+          </div>
+          <h2 className="mt-4 text-base font-semibold text-text-primary">
+            {hasFilters ? t(($) => $.noMatchingAgents) : t(($) => $.noAgents)}
+          </h2>
+          <p className="mt-1 max-w-md text-sm text-text-tertiary">
+            {hasFilters ? t(($) => $.noMatchingAgentsHint) : t(($) => $.noAgentsHint)}
+          </p>
+          {!hasFilters && (
+            <Button className="mt-5" variant="secondary" onClick={openCreate}>
+              {t(($) => $.createFirstAgent)}
+            </Button>
+          )}
+        </section>
+      )}
+
+      {pageCount > 1 && (
+        <div className="flex items-center justify-center gap-3">
+          <Button
+            size="small"
+            variant="secondary"
+            disabled={page <= 1}
+            onClick={() => setOffset(Math.max(0, offset - PAGE_SIZE))}
+          >
+            {t(($) => $.previous)}
+          </Button>
+          <span className="text-xs text-text-tertiary">
+            {page} / {pageCount}
+          </span>
+          <Button
+            size="small"
+            variant="secondary"
+            disabled={page >= pageCount}
+            onClick={() => setOffset(offset + PAGE_SIZE)}
+          >
+            {t(($) => $.next)}
+          </Button>
+        </div>
+      )}
+
+      <UlooAgentFormDialog
+        agent={editingAgent}
+        open={editorOpen}
+        preview={preview}
+        onPreviewSave={savePreviewAgent}
+        onOpenChange={setEditorOpen}
+        onSaved={refresh}
+      />
+
+      <UlooAgentDebugDialog
+        agent={debuggingAgent}
+        open={Boolean(debuggingAgent)}
+        preview={preview}
+        onOpenChange={(open) => !open && setDebuggingAgent(undefined)}
+      />
+
+      <AlertDialog
+        open={Boolean(deletingAgent)}
+        onOpenChange={(open) => !open && setDeletingAgent(undefined)}
+      >
+        <AlertDialogContent>
+          <AlertDialogTitle>
+            {t(($) => $.deleteAgentTitle, { name: deletingAgent?.name ?? '' })}
+          </AlertDialogTitle>

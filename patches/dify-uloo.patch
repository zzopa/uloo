+  await userEvent.click(screen.getByRole('button', { name: 'uloo.addResource' }))
+  await userEvent.type(screen.getByLabelText('uloo.agentKey'), 'research')
+  await userEvent.type(screen.getByLabelText('uloo.resourceName'), 'Research')
+  await userEvent.type(

@@ -0,0 +1,179 @@
+'use client'
+
+import type { UlooAgentResponse } from '@dify/contracts/api/console/uloo/types.gen'
+import { useQuery } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import Link from '@/next/link'
+import { consoleQuery } from '@/service/client'
+import { createUlooRoutes } from '../routes'
+import { UlooPageHeading } from '../shared/page-heading'
+import { UlooPreviewBanner } from '../shared/preview-banner'
+
+const DEMO_AGENT: UlooAgentResponse = {
+  id: 'demo-agent-requirements',
+  key: 'requirement-analyst',
+  name: '需求分析 Agent',
+  description: '把模糊需求整理成目标、范围和验收标准。',
+  role: '需求分析与任务规划',
+  model_ref: 'openai-compatible:gpt-4o-mini',
+  instructions: ['复述目标并识别关键约束', '只提出影响方案的必要问题', '输出可验证的验收标准'],
+  skill_refs: [],
+  tool_refs: ['knowledge-search'],
+  knowledge_refs: ['product-requirements'],
+  output_schema: { type: 'object' },
+  enabled: true,
+  version: 3,
+}
+
+export function UlooAgentDetail({
+  agentId,
+  preview = false,
+}: {
+  agentId: string
+  preview?: boolean
+}) {
+  const { t } = useTranslation('uloo')
+  const routes = createUlooRoutes(preview)
+  const query = useQuery({
+    ...consoleQuery.uloo.agents.byAgentId.get.queryOptions({
+      input: { params: { agent_id: agentId } },
+    }),
+    enabled: !preview,
+    retry: 1,
+  })
+  const agent = preview ? { ...DEMO_AGENT, id: agentId } : query.data
+
+  if (!preview && query.isLoading)
+    return <div className="h-72 animate-pulse rounded-2xl bg-background-section-burn" />
+  if (!agent) {
+    return (
+      <section className="rounded-2xl border border-components-panel-border bg-background-default p-8 text-center">
+        <h1 className="text-base font-semibold text-text-primary">
+          {t(($) => $.coreUnavailableTitle)}
+        </h1>
+        <p className="mt-2 text-sm text-text-tertiary">{t(($) => $.coreUnavailableDetail)}</p>
+        <Link
+          href={routes.agents}
+          className="mt-5 inline-flex text-sm font-medium text-text-accent"
+        >
+          {t(($) => $.agents)}
+        </Link>
+      </section>
+    )
+  }
+
+  return (
+    <div className="space-y-6">
+      <UlooPageHeading
+        title={agent.name}
+        description={`${agent.key} · v${agent.version}`}
+        icon="i-ri-robot-2-line"
+        backHref={routes.agents}
+        backLabel={t(($) => $.agents)}
+        badge={
+          <span
+            className={`rounded-md px-2 py-1 text-[11px] font-semibold ${agent.enabled ? 'text-components-badge-status-light-success-text bg-components-badge-status-light-success-bg' : 'bg-components-badge-bg-dimm text-text-tertiary'}`}
+          >
+            {agent.enabled ? t(($) => $.enabled) : t(($) => $.disabled)}
+          </span>
+        }
+        actions={preview ? <UlooPreviewBanner /> : undefined}
+      />
+      <div className="grid gap-5 xl:grid-cols-[1fr_380px]">
+        <section className="space-y-5 rounded-2xl border border-components-panel-border bg-background-default p-6">
+          <div>
+            <div className="text-xs font-medium text-text-tertiary">{t(($) => $.agentRole)}</div>
+            <p className="mt-2 text-sm leading-6 text-text-primary">{agent.role}</p>
+          </div>
+          <div>
+            <div className="text-xs font-medium text-text-tertiary">{t(($) => $.instructions)}</div>
+            <ol className="mt-3 space-y-2">
+              {agent.instructions.map((instruction, index) => (
+                <li
+                  key={instruction}
+                  className="flex gap-3 rounded-xl bg-background-section-burn p-3 text-sm text-text-secondary"
+                >
+                  <span className="font-mono text-xs text-text-quaternary">{index + 1}</span>
+                  {instruction}
+                </li>
+              ))}
+            </ol>
+          </div>
+          <div>
+            <div className="text-xs font-medium text-text-tertiary">{t(($) => $.outputSchema)}</div>
+            <pre className="mt-3 overflow-x-auto rounded-xl bg-background-section-burn p-4 font-mono text-xs leading-5 text-text-secondary">
+              {JSON.stringify(agent.output_schema, null, 2)}
+            </pre>
+          </div>
+        </section>
+        <aside className="space-y-4">
+          <section className="rounded-2xl border border-components-panel-border bg-background-default p-5">
+            <h2 className="text-sm font-semibold text-text-primary">
+              {t(($) => $.modelReference)}
+            </h2>
+            <div className="mt-3 rounded-lg bg-background-section-burn p-3 font-mono text-xs text-text-primary">
+              {agent.model_ref}
+            </div>
+          </section>
+          <section className="rounded-2xl border border-components-panel-border bg-background-default p-5">
+            <h2 className="text-sm font-semibold text-text-primary">
+              {t(($) => $.toolReferences)}
+            </h2>
+            <div className="mt-3 flex flex-wrap gap-2">
+              {agent.tool_refs.length ? (
+                agent.tool_refs.map((tool) => (
+                  <span
+                    key={tool}
+                    className="rounded-md border border-divider-subtle px-2 py-1 text-xs text-text-secondary"
+                  >
+                    {tool}
+                  </span>
+                ))
+              ) : (

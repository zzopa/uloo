diff --git a/web/features/uloo/agents/workflow-picker.tsx b/web/features/uloo/agents/workflow-picker.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f47051a0dc2be5e41e6ef581e54a128dd290bbf7
--- /dev/null
+++ b/web/features/uloo/agents/workflow-picker.tsx
@@ -0,0 +1,91 @@
+// AI生成
+'use client'
+
+import { Checkbox } from '@langgenius/dify-ui/checkbox'
+import { useQuery } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+
+type DifyWorkflow = {
+  id: string
+  name: string
+  description?: string
+  mode?: string
+  icon?: string
+  icon_background?: string | null
+}
+
+/**
+ * S1-8: Workflow picker that fetches Dify workspace workflow apps directly,
+ * so the user can select workflows as agent tools without manual ID entry.
+ */
+export function UlooWorkflowPicker({
+  selected,
+  onChange,
+  preview = false,
+}: {
+  selected: string[]
+  onChange: (refs: string[]) => void
+  preview?: boolean
+}) {
+  const { t } = useTranslation('uloo')
+  const workflows = useQuery({
+    queryKey: ['uloo-dify-workflows-picker'],
+    queryFn: async () => {
+      const res = await fetch('/console/api/uloo/dify-workflows')
+      if (!res.ok) return { workflows: [] as DifyWorkflow[] }
+      return res.json() as Promise<{ workflows: DifyWorkflow[] }>
+    },
+    enabled: !preview,
+    retry: false,
+  })
+
+  const available = workflows.data?.workflows ?? []
+  const refs = [...new Set([...available.map((w) => w.id), ...selected])]
+
+  function handleToggle(ref: string, checked: boolean) {
+    onChange(checked ? [...selected, ref] : selected.filter((item) => item !== ref))
+  }
+
+  function getWorkflowInfo(ref: string): DifyWorkflow | undefined {
+    return available.find((w) => w.id === ref)
+  }
+
+  return (
+    <fieldset className="space-y-2 rounded-xl border border-components-panel-border p-3 sm:col-span-2">
+      <legend className="px-1 text-sm font-medium">
+        {t(($) => $.workflowReferences)}
+      </legend>
+      {workflows.isLoading && <p role="status">{t(($) => $.toolCatalogLoading)}</p>}
+      {workflows.isError && <p role="alert">{t(($) => $.toolCatalogError)}</p>}
+      {!workflows.isLoading && !workflows.isError && !refs.length && (
+        <p>{t(($) => $.noRegisteredTools)}</p>
+      )}
+      {refs.map((ref) => {
+        const info = getWorkflowInfo(ref)
+        return (
+          <label key={ref} className="flex items-start gap-2 text-sm">
+            <Checkbox
+              checked={selected.includes(ref)}
+              onCheckedChange={(checked) => handleToggle(ref, checked === true)}
+            />
+            <span>
+              <span className="font-medium">
+                {info?.icon && <span className="mr-1">{info.icon}</span>}
+                {info?.name ?? ref}
+                {info && (
+                  <span className="ml-1.5 rounded bg-components-badge-status-light-success-bg px-1.5 py-0.5 text-[10px] font-medium text-components-badge-status-light-success-text">
+                    Workflow
+                  </span>
+                )}
+              </span>
+              <span className="ml-2 font-mono text-xs text-text-tertiary">{ref}</span>
+              {info?.description && (
+                <span className="block text-xs text-text-tertiary">{info.description}</span>
+              )}
+            </span>
+          </label>
+        )
+      })}
+    </fieldset>
+  )
+}

+                "mode": row.mode.value if hasattr(row.mode, "value") else str(row.mode),
+                "icon_type": row.icon_type.value if row.icon_type and hasattr(row.icon_type, "value") else None,
+                "icon": row.icon or "",
+                "icon_background": row.icon_background,
+                "created_at": row.created_at.isoformat() if row.created_at else None,
+            }
+        )
+
+    return {"workflows": workflows_out}
diff --git a/api/tests/unit_tests/controllers/console/test_uloo_proxy.py b/api/tests/unit_tests/controllers/console/test_uloo_proxy.py
new file mode 100644
index 0000000000000000000000000000000000000000..dd3aef0a25ce18f127a04b7314a1cc5f2578b46a
--- /dev/null
+++ b/api/tests/unit_tests/controllers/console/test_uloo_proxy.py
@@ -0,0 +1,209 @@
+from __future__ import annotations
+
+import json
+
+import httpx
+import pytest
+from flask import Flask
+from werkzeug.exceptions import NotFound
+
+from controllers.console import bp
+from controllers.console.uloo_proxy import (
+    ALLOWED_ROOT_SEGMENTS,
+    _forward_headers,
+    _proxy_response,
+    _uloo_error,
+    _upstream_url,
+    _validate_upstream_path,
+)
+
+
+def _upstream(content_type: str, body: bytes, status_code: int = 200) -> httpx.Response:
+    return httpx.Response(
+        status_code=status_code,
+        headers={"content-type": content_type},
+        content=body,
+        request=httpx.Request("GET", "http://uloo.local/api/v1/agents"),
+    )
+
+
+def test_route_is_registered_on_the_console_blueprint() -> None:
+    """The browser only ever reaches /console/api/uloo/**, per plan section 5.2."""
+    app = Flask(__name__)
+    app.register_blueprint(bp)
+
+    rules = [rule for rule in app.url_map.iter_rules() if "uloo" in rule.rule]
+    proxy_rule = next(rule for rule in rules if rule.rule == "/console/api/uloo/<path:upstream_path>")
+    assert {"GET", "POST", "PATCH", "PUT", "DELETE"} <= proxy_rule.methods
+
+    typed_routes = {rule.rule for rule in rules}
+    assert "/console/api/uloo/agents" in typed_routes
+    assert "/console/api/uloo/agents/<uuid:agent_id>" in typed_routes
+    assert "/console/api/uloo/agents/<uuid:agent_id>/validate" in typed_routes
+    assert "/console/api/uloo/agents/<uuid:agent_id>/test-runs" in typed_routes
+    assert "/console/api/uloo/tasks" in typed_routes
+    assert "/console/api/uloo/tasks/<uuid:task_id>" in typed_routes
+    assert "/console/api/uloo/tasks/<uuid:task_id>/plan" in typed_routes
+    assert "/console/api/uloo/tasks/<uuid:task_id>/approve" in typed_routes
+    assert "/console/api/uloo/tasks/<uuid:task_id>/runs" in typed_routes
+    assert "/console/api/uloo/runs" in typed_routes
+    assert "/console/api/uloo/runs/<uuid:run_id>" in typed_routes
+    assert "/console/api/uloo/runs/<uuid:run_id>/events" in typed_routes
+
+
+def test_allowlisted_root_segments_cover_the_plan_contract() -> None:
+    assert ALLOWED_ROOT_SEGMENTS == {"tools", "skills", "agents", "teams", "tasks", "runs", "memories", "memory-proposals"}
+
+
+@pytest.mark.parametrize(
+    "path",
+    [
+        "tools",
+        "skills/research",
+        "agents",
+        "agents/0f1c/validate",
+        "teams/by-key/content-team",
+        "tasks",
+        "tasks/0f1c",
+        "runs/0f1c/events",
+        "runs/0f1c/stream",
+        "memories/search",
+        "memory-proposals/0f1c/commit",
+    ],
+)
+def test_allowlisted_paths_are_forwarded(path: str) -> None:
+    assert _validate_upstream_path(path) == path
+
+
+@pytest.mark.parametrize(
+    "path",
+    [
+        "",
+        "workflows/anything",
+        "agents/../secrets",
+        "agents/%2e%2e/secrets",
+        "agents\\..\\secrets",
+        "agents//secrets",
+        "agents/x/..",
+        "agents%2f..%2fadmin",
+    ],
+)
+def test_paths_outside_the_allowlist_are_rejected(path: str) -> None:
+    """The proxy must never be usable as an arbitrary URL or traversal device."""
+    with pytest.raises(NotFound):
+        _validate_upstream_path(path)
+
+
+def test_upstream_url_is_composed_under_the_configured_origin(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr("controllers.console.uloo_proxy.dify_config.ULOO_CORE_URL", "http://core.internal:8200")
+
+    assert _upstream_url("agents") == "http://core.internal:8200/api/v1/agents"
+    assert (
+        _upstream_url("teams/by-key/content-team")
+        == "http://core.internal:8200/api/v1/teams/by-key/content-team"
+    )
+
+
+def test_upstream_url_tolerates_a_trailing_slash(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr("controllers.console.uloo_proxy.dify_config.ULOO_CORE_URL", "http://core.internal:8200/")
+
+    assert _upstream_url("runs/0f1c/stream") == "http://core.internal:8200/api/v1/runs/0f1c/stream"
+
+
+def test_forward_headers_inject_credential_and_correlation_ids(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr("controllers.console.uloo_proxy.dify_config.ULOO_CORE_API_TOKEN", "service-token")
+
+    app = Flask(__name__)
+    with app.test_request_context(
+        "/console/api/uloo/agents",
+        headers={"X-Request-ID": "req-1", "X-Trace-ID": "trace-1"},
+    ):
+        headers = _forward_headers()
+
+    assert headers["Authorization"] == "Bearer service-token"
+    assert headers["X-Request-ID"] == "req-1"
+    assert headers["X-Trace-ID"] == "trace-1"
+    assert headers["X-ULOO-Source"] == "dify-console-bff"
+
+
+def test_forward_headers_omit_authorization_without_a_configured_token(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr("controllers.console.uloo_proxy.dify_config.ULOO_CORE_API_TOKEN", None)
+
+    app = Flask(__name__)
+    with app.test_request_context("/console/api/uloo/agents"):
+        headers = _forward_headers()
+
+    assert "Authorization" not in headers
+
+
+def test_sse_response_is_streamed_not_buffered(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr("controllers.console.uloo_proxy.dify_config.ULOO_CORE_API_TOKEN", None)
+
+    app = Flask(__name__)
+    with app.test_request_context("/console/api/uloo/runs/0f1c/stream"):
+        response = _proxy_response(
+            _upstream("text/event-stream", b'data: {"sequence": 1}\n\n'), tenant_id="tenant-1"
+        )
+
+        assert response.status_code == 200
+        assert response.headers["Content-Type"].startswith("text/event-stream")
+        assert response.headers["X-Accel-Buffering"] == "no"
+        assert response.headers["Cache-Control"] == "no-cache"
+        assert response.headers["X-ULOO-Status"] == "streaming"
+        assert b"sequence" in b"".join(response.iter_encoded())
+
+
+def test_compressed_stream_is_refused(monkeypatch: pytest.MonkeyPatch) -> None:
+    """A gzipped stream cannot be forwarded incrementally, so it must not be faked."""
+    monkeypatch.setattr("controllers.console.uloo_proxy.dify_config.ULOO_CORE_API_TOKEN", None)
+
+    upstream = _upstream("text/event-stream", b"data: {}\n\n")
+    upstream.headers["content-encoding"] = "gzip"
+
+    response = _proxy_response(upstream, tenant_id="tenant-1")
+
+    assert response.status_code == 502
+    assert response.get_json()["code"] == "RUNTIME_UNAVAILABLE"
+
+
+def test_json_response_is_buffered_and_passed_through(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr("controllers.console.uloo_proxy.dify_config.ULOO_CORE_API_TOKEN", None)
+
+    response = _proxy_response(_upstream("application/json", b'{"id": "0f1c"}'), tenant_id="tenant-1")
+
+    assert response.status_code == 200
+    assert json.loads(response.get_data(as_text=True)) == {"id": "0f1c"}
+
+
+def test_upstream_error_status_and_body_are_preserved(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Error codes are part of the contract, so the browser must receive them intact."""
+    monkeypatch.setattr("controllers.console.uloo_proxy.dify_config.ULOO_CORE_API_TOKEN", None)
+
+    body = b'{"status":"error","code":"AGENT_NOT_FOUND","message":"missing"}'
+    response = _proxy_response(_upstream("application/json", body, status_code=404), tenant_id="tenant-1")
+
+    assert response.status_code == 404
+    assert json.loads(response.get_data(as_text=True))["code"] == "AGENT_NOT_FOUND"
+
+
+def test_error_body_uses_the_plan_error_codes() -> None:
+    response = _uloo_error(503, "RUNTIME_UNAVAILABLE", "ULOO Core is unavailable")
+
+    assert response.status_code == 503
+    body = response.get_json()
+    assert body["code"] == "RUNTIME_UNAVAILABLE"
+    assert body["message"] == "ULOO Core is unavailable"
+    assert body["request_id"] == response.headers["X-Request-ID"]
+    assert body["trace_id"] == response.headers["X-Trace-ID"]
+
+
+def test_browser_preflight_does_not_require_login_or_forward_to_core() -> None:
+    app = Flask(__name__)
+    app.register_blueprint(bp)
+    with app.test_client() as client:
+        response = client.options('/console/api/uloo/tools', headers={'Origin': 'http://localhost:3000', 'Access-Control-Request-Method': 'GET'})
+    assert response.status_code == 200
+    assert 'GET' in response.headers['Allow']
+    assert 'PATCH' in response.headers['Allow']

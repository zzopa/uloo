+it('selects tools and skills for the Agent and excludes disabled resources', async () => {
+  load.mockResolvedValue([
+    { ...tool, enabled: false },
+    { ...tool, key: 'research', name: 'Research', enabled: true },
+  ])
+  const change = vi.fn()
+  mount(<UlooToolPicker kind="skills" selected={[]} onChange={change} />)
+  await userEvent.click(await screen.findByRole('checkbox', { name: /research/ }))
+  expect(change).toHaveBeenCalledWith(['research'])
+  expect(screen.queryByRole('checkbox', { name: /web-search/ })).not.toBeInTheDocument()

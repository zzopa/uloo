+// AI生成
+'use client'
+
+import { useState } from 'react'
+import { useQuery } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import Link from '@/next/link'
+import { consoleQuery } from '@/service/client'
+import { createUlooRoutes } from '../routes'
+import { UlooPageHeading } from '../shared/page-heading'
+import { UlooPreviewBanner } from '../shared/preview-banner'
+import { UlooUnavailableState } from '../shared/unavailable-state'
+
+const DEMO_RUNS = [
+  {
+    id: 'demo-run-001',
+    task: '多智能体产品规划',
+    team: '产品研发协同组',
+    status: 'running',
+    time: '刚刚',
+    usage: '8,420 tokens',
+  },
+  {
+    id: 'demo-run-002',
+    task: '竞品分析报告',
+    team: '市场分析组',
+    status: 'succeeded',
+    time: '昨天 16:42',
+    usage: '12,680 tokens',
+  },
+  {
+    id: 'demo-run-003',
+    task: '技术风险复核',
+    team: '技术评审组',
+    status: 'failed',
+    time: '9月22日 10:18',
+    usage: '3,105 tokens',
+  },
+] as const
+
+const STATUS_CLASS = {
+  running:
+    'bg-components-badge-status-light-warning-bg text-components-badge-status-light-warning-text',
+  succeeded:
+    'bg-components-badge-status-light-success-bg text-components-badge-status-light-success-text',
+  failed: 'bg-components-badge-status-light-error-bg text-components-badge-status-light-error-text',
+}
+
+export function UlooRunsPage({ preview = false }: { preview?: boolean }) {
+  const { t } = useTranslation('uloo')
+  const routes = createUlooRoutes(preview)
+  const [statusFilter, setStatusFilter] = useState<string>('all')
+  const runsQuery = useQuery({
+    ...consoleQuery.uloo.runs.get.queryOptions({ input: { query: { limit: 100 } } }),
+    enabled: !preview,
+    retry: 1,
+  })
+
+  function formatDuration(startedAt: string | null, finishedAt: string | null): string {
+    if (!startedAt || !finishedAt) return '—'
+    const ms = new Date(finishedAt).getTime() - new Date(startedAt).getTime()
+    if (ms < 0) return '—'
+    return ms < 1000 ? `${ms}ms` : `${(ms / 1000).toFixed(1)}s`
+  }
+
+  const allRuns = preview
+    ? DEMO_RUNS
+    : (runsQuery.data?.items ?? []).map((run) => ({
+        id: run.id,
+        task: run.task_id,
+        team: run.team_id,
+        status: run.status,
+        time: run.created_at ? new Date(run.created_at).toLocaleString() : '—',
+        usage: run.usage?.total_tokens ? `${run.usage.total_tokens} tokens` : '—',
+        duration: formatDuration(run.started_at ?? null, run.finished_at ?? null),
+      }))
+  const runs = statusFilter === 'all' ? allRuns : allRuns.filter((run) => run.status === statusFilter)
+  const filterTabs = [
+    { key: 'all', label: t(($) => $.all) },
+    { key: 'running', label: t(($) => $.taskStatusRunning) },
+    { key: 'succeeded', label: t(($) => $.taskStatusSucceeded) },
+    { key: 'failed', label: t(($) => $.taskStatusFailed) },
+  ]
+
+  return (
+    <div className="space-y-6">
+      <UlooPageHeading
+        title={t(($) => $.runs)}
+        description={t(($) => $.runsPageHint)}
+        icon="i-ri-pulse-line"
+        actions={preview ? <UlooPreviewBanner /> : undefined}
+      />
+      {runsQuery.isError && !preview ? (
+        <UlooUnavailableState runtimeHref={routes.runtime} />
+      ) : (
+        <>
+          <section className="flex flex-wrap gap-2 rounded-xl border border-components-panel-border bg-background-default p-3">
+            {filterTabs.map((tab) => (
+              <button
+                key={tab.key}
+                type="button"
+                onClick={() => setStatusFilter(tab.key)}
+                className={`rounded-lg px-3 py-2 text-xs font-medium ${statusFilter === tab.key ? 'bg-state-accent-active text-text-accent' : 'text-text-tertiary hover:bg-state-base-hover'}`}
+              >
+                {tab.label}
+              </button>
+            ))}
+          </section>
+          <section className="overflow-hidden rounded-2xl border border-components-panel-border bg-background-default shadow-xs">
+            <div className="overflow-x-auto">
+              <table className="w-full min-w-[760px] text-left text-sm">
+                <thead className="border-b border-divider-subtle text-xs text-text-tertiary">
+                  <tr>
+                    <th className="px-5 py-3 font-medium">Run</th>
+                    <th className="px-5 py-3 font-medium">{t(($) => $.taskDetailTitle)}</th>
+                    <th className="px-5 py-3 font-medium">{t(($) => $.teams)}</th>
+                    <th className="px-5 py-3 font-medium">Status</th>
+                    <th className="px-5 py-3 font-medium">{t(($) => $.runDuration)}</th>
+                    <th className="px-5 py-3 font-medium">Usage</th>
+                    <th className="px-5 py-3 text-right font-medium">
+                      {t(($) => $.taskCreatedAt)}
+                    </th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {runs.map((run) => (
+                    <tr
+                      key={run.id}
+                      className="border-b border-divider-subtle last:border-0 hover:bg-state-base-hover"
+                    >
+                      <td className="px-5 py-4">
+                        <Link
+                          href={routes.run(run.id)}
+                          className="font-mono text-xs font-semibold text-text-accent"
+                        >
+                          {run.id}
+                        </Link>
+                      </td>
+                      <td className="px-5 py-4 font-medium text-text-primary">{run.task}</td>
+                      <td className="px-5 py-4 text-text-secondary">{run.team}</td>
+                      <td className="px-5 py-4">
+                        <span
+                          className={`rounded-md px-2 py-1 text-[11px] font-semibold ${STATUS_CLASS[run.status as keyof typeof STATUS_CLASS] ?? 'bg-background-section-burn text-text-tertiary'}`}
+                        >
+                          {run.status}
+                        </span>
+                      </td>
+                      <td className="px-5 py-4 font-mono text-xs text-text-tertiary">
+                        {'duration' in run ? run.duration : '—'}
+                      </td>
+                      <td className="px-5 py-4 font-mono text-xs text-text-tertiary">
+                        {run.usage}
+                      </td>
+                      <td className="px-5 py-4 text-right text-xs text-text-tertiary">
+                        {run.time}
+                      </td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+          </section>
+        </>
+      )}
+    </div>
+  )
+}

+                  <span className="i-ri-brain-line text-lg" />
+                </div>
+                <div className="min-w-0 flex-1">
+                  <h2 className="font-medium text-text-primary">{memory.title}</h2>
+                  <div className="mt-1 flex flex-wrap gap-2 text-xs text-text-tertiary">

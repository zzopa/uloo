+
+it('confirms deletion and shows binding errors without removing the resource', async () => {
+  load.mockImplementation((url: string) => Promise.resolve(url.endsWith('dify-tools') ? { tools: [], unavailable: [] } : [{ ...tool, key: 'research' }]))

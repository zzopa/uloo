+# AI生成
+"""Public tool references for Agno; Dify retains connections and credentials."""
+
+import hashlib
+import logging
+
+from sqlalchemy import select
+
+from core.tools.entities.tool_entities import ToolParameter, ToolProviderType
+from core.tools.tool_manager import ToolManager
+from extensions.ext_database import db
+from models.tools import WorkflowToolProvider
+from services.tools.tools_transform_service import ToolTransformService
+
+logger = logging.getLogger(__name__)
+
+# Map Dify ToolProviderType to user-facing category labels (S1-5).
+_PROVIDER_TYPE_CATEGORIES = {
+    "builtin": "内置",
+    "plugin": "插件",
+    "api": "API",
+    "workflow": "工作流",
+    "mcp": "MCP",
+}
+
+
+def _provider_type_category(provider_type) -> str:
+    """Return a user-facing category label for the tool provider type."""
+    return _PROVIDER_TYPE_CATEGORIES.get(provider_type.value, provider_type.value)
+
+
+def list_uloo_tool_catalog(user_id: str, tenant_id: str) -> dict:
+    tools, unavailable = [], []
+    providers = []
+    for category in ("builtin", "api", "workflow", "mcp"):
+        try:
+            providers.extend(ToolManager.list_providers_from_api(user_id, tenant_id, category))
+        except Exception:
+            logger.warning("Cannot load ULOO tool category %s", category)
+            unavailable.append({"provider_name": category, "message": "工具目录暂不可用，请检查 Dify 服务"})
+    for provider in providers:
+        try:
+            provider_id = provider.server_identifier if provider.type == ToolProviderType.MCP else provider.id
+            match provider.type:
+                case ToolProviderType.BUILT_IN | ToolProviderType.PLUGIN:
+                    controller = ToolManager.get_builtin_provider(provider.id, tenant_id)
+                    declarations = controller.get_tools()
+                case ToolProviderType.API:
+                    controller, _ = ToolManager.get_api_provider_controller(tenant_id, provider.id)
+                    declarations = controller.get_tools(tenant_id)
+                case ToolProviderType.MCP:
+                    declarations = ToolManager.get_mcp_provider_controller(tenant_id, provider_id).get_tools()
+                case ToolProviderType.WORKFLOW:
+                    row = db.session.scalar(
+                        select(WorkflowToolProvider).where(
+                            WorkflowToolProvider.tenant_id == tenant_id, WorkflowToolProvider.id == provider.id
+                        )
+                    )
+                    if row is None:
+                        raise ValueError("Workflow provider missing")
+                    declarations = ToolTransformService.workflow_provider_to_controller(db_provider=row).get_tools(
+                        tenant_id
+                    )
+                case _:
+                    continue
+            for tool in declarations:
+                identity = f"{provider.type.value}:{provider_id}:{tool.entity.identity.name}"
+                required_form = [
+                    p.name
+                    for p in tool.entity.parameters or []
+                    if p.form != ToolParameter.ToolParameterForm.LLM and p.required and p.default is None
+                ]
+                tools.append(
+                    {
+                        "key": "dify-" + hashlib.sha256(identity.encode()).hexdigest()[:32],
+                        "name": tool.entity.identity.label.zh_Hans or tool.entity.identity.name,
+                        "description": tool.entity.description.llm or "",
+                        "provider_name": provider.label.zh_Hans or provider.name,
+                        "provider_type": provider.type.value,
+                        "category": _provider_type_category(provider.type),
+                        "enabled": not required_form,
+                        "unavailable_reason": "需要在 Dify 工作流中配置参数：" + ", ".join(required_form)
+                        if required_form
+                        else "",
+                        "config": {
+                            "tool_type": "dify",
+                            "provider_type": provider.type.value,
+                            "provider_id": provider_id,
+                            "tool_name": tool.entity.identity.name,
+                            "tool_schema": tool.get_llm_parameters_json_schema(),
+                        },
+                    }
+                )
+        except Exception:
+            logger.warning("Cannot load ULOO tool catalog for provider %s", provider.id)
+            unavailable.append(
+                {"provider_name": provider.name, "message": "工具提供者暂不可用，请在 Dify 集成页面检查"}
+            )
+    return {"tools": tools, "unavailable": unavailable}

diff --git a/web/features/uloo/teams/live.tsx b/web/features/uloo/teams/live.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b45f1b4198b6ed8a240bbfa1cf4c19c957bd8640
--- /dev/null
+++ b/web/features/uloo/teams/live.tsx
@@ -0,0 +1,438 @@
+// AI生成
+'use client'
+
+import type { UlooAgentResponse } from '@dify/contracts/api/console/uloo/types.gen'
+import { Button } from '@langgenius/dify-ui/button'
+import { Checkbox } from '@langgenius/dify-ui/checkbox'
+import {
+  Dialog,
+  DialogCloseButton,
+  DialogContent,
+  DialogDescription,
+  DialogTitle,
+} from '@langgenius/dify-ui/dialog'
+import { Field, FieldControl, FieldLabel } from '@langgenius/dify-ui/field'
+import { Form } from '@langgenius/dify-ui/form'
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectItemText,
+  SelectTrigger,
+} from '@langgenius/dify-ui/select'
+import { Textarea } from '@langgenius/dify-ui/textarea'
+import { toast } from '@langgenius/dify-ui/toast'
+import { useMutation, useQuery } from '@tanstack/react-query'
+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import Link from '@/next/link'
+import { get, patch, post } from '@/service/base'
+import { consoleQuery } from '@/service/client'
+import { getUlooErrorInfo } from '../agents/error'
+import { createUlooRoutes } from '../routes'
+import { UlooPageHeading } from '../shared/page-heading'
+import { UlooUnavailableState } from '../shared/unavailable-state'
+
+type Team = {
+  id: string
+  key: string
+  name: string
+  description: string | null
+  mode: string
+  member_agent_ids: string[]
+  leader_agent_id: string | null
+  instructions: string[]
+  limits: { timeout_seconds: number; max_iterations: number; max_tokens: number; total_token_budget?: number }
+  review_policy?: { max_rounds: number; require_unanimous: boolean; criteria: string[] }
+  completion?: { all_members_executed: boolean; no_unresolved_errors: boolean; custom: string }
+  handoff_context?: string
+  enabled: boolean
+  version: number
+}
+
+function TeamForm({
+  team,
+  onSaved,
+  onClose,
+}: {
+  team?: Team
+  onSaved: () => void
+  onClose: () => void
+}) {
+  const { t } = useTranslation('uloo')
+  const [mode, setMode] = useState(team?.mode ?? 'coordinate')
+  const [members, setMembers] = useState(team?.member_agent_ids ?? [])
+  const [leader, setLeader] = useState(team?.leader_agent_id ?? '')
+  const [error, setError] = useState('')
+  const [requireUnanimous, setRequireUnanimous] = useState(team?.review_policy?.require_unanimous ?? false)
+  const [allMembersExecuted, setAllMembersExecuted] = useState(team?.completion?.all_members_executed ?? true)
+  const [noUnresolvedErrors, setNoUnresolvedErrors] = useState(team?.completion?.no_unresolved_errors ?? true)
+  const agentsQuery = useQuery(
+    consoleQuery.uloo.agents.get.queryOptions({ input: { query: { enabled: true, limit: 100 } } }),
+  )
+  const save = useMutation({
+    mutationFn: (values: {
+      key: string
+      name: string
+      description: string
+      instructions: string
+      timeout: string
+      totalBudget: string
+      maxRounds: string
+      reviewCriteria: string
+      handoffContext: string
+      completionCustom: string
+    }) => {
+      const body = {
+        name: values.name.trim(),
+        description: values.description.trim() || null,
+        mode,
+        member_agent_ids: members,
+        leader_agent_id: leader,
+        instructions: values.instructions
+          .split('\n')
+          .map((line) => line.trim())
+          .filter(Boolean),
+        limits: {
+          max_iterations: team?.limits.max_iterations ?? 8,
+          max_tokens: team?.limits.max_tokens ?? 4096,
+          timeout_seconds: Number(values.timeout),
+          total_token_budget: Number(values.totalBudget),
+        },
+        review_policy: {
+          max_rounds: Number(values.maxRounds),
+          require_unanimous: requireUnanimous,
+          criteria: values.reviewCriteria.split('\n').map((l) => l.trim()).filter(Boolean),
+        },
+        completion: {
+          all_members_executed: allMembersExecuted,
+          no_unresolved_errors: noUnresolvedErrors,
+          custom: values.completionCustom.trim(),
+        },
+        handoff_context: values.handoffContext.trim(),
+      }
+      return team
+        ? patch<Team>(`/uloo/teams/${team.id}`, {
+            body: { ...body, expected_version: team.version },
+          })
+        : post<Team>('/uloo/teams', { body: { ...body, key: values.key.trim() } })
+    },
+    onSuccess: () => {
+      toast.success(t(($) => $.teamSaved))
+      onSaved()
+      onClose()
+    },
+    onError: (error) => setError(getUlooErrorInfo(error).message),
+  })
+
+  return (
+    <Form<{
+      key: string
+      name: string
+      description: string
+      instructions: string
+      timeout: string
+      totalBudget: string
+      maxRounds: string
+      reviewCriteria: string
+      handoffContext: string
+      completionCustom: string
+    }>
+      className="space-y-4 p-6"
+      onFormSubmit={(values) => {
+        if (!members.length || !members.includes(leader)) {
+          setError(t(($) => $.teamSelectionRequired))
+          return
+        }
+        save.mutate(values)
+      }}
+    >
+      <Field name="name">
+        <FieldLabel>{t(($) => $.agentName)}</FieldLabel>
+        <FieldControl required maxLength={256} defaultValue={team?.name ?? ''} />
+      </Field>
+      <Field name="key">
+        <FieldLabel>{t(($) => $.agentKey)}</FieldLabel>
+        <FieldControl
+          required
+          readOnly={Boolean(team)}
+          pattern="[A-Za-z0-9][A-Za-z0-9._-]*"
+          maxLength={128}
+          defaultValue={team?.key ?? ''}
+        />
+      </Field>
+      <Field name="description">
+        <FieldLabel>{t(($) => $.description)}</FieldLabel>
+        <Textarea defaultValue={team?.description ?? ''} />
+      </Field>
+      <Select value={mode} onValueChange={(value) => setMode(value ?? 'coordinate')}>
+        <SelectTrigger aria-label={t(($) => $.modes)}>{mode}</SelectTrigger>
+        <SelectContent>
+          {['coordinate', 'route', 'collaborate'].map((value) => (
+            <SelectItem key={value} value={value}>
+              <SelectItemText>{value}</SelectItemText>
+            </SelectItem>
+          ))}
+        </SelectContent>
+      </Select>
+      <fieldset className="space-y-2">
+        <legend className="mb-2 text-sm font-medium">{t(($) => $.agents)}</legend>
+        {agentsQuery.isError && <p role="alert">{getUlooErrorInfo(agentsQuery.error).message}</p>}
+        {(agentsQuery.data?.items ?? []).map((agent: UlooAgentResponse) => (
+          <label key={agent.id} className="flex items-center gap-2 text-sm">
+            <Checkbox
+              checked={members.includes(agent.id)}
+              onCheckedChange={(checked) => {
+                setMembers(
+                  checked ? [...members, agent.id] : members.filter((id) => id !== agent.id),
+                )
+                if (!checked && leader === agent.id) setLeader('')
+              }}
+            />
+            {agent.name} · {agent.role}
+          </label>
+        ))}
+      </fieldset>
+      <Select value={leader} onValueChange={(value) => setLeader(value ?? '')}>
+        <SelectTrigger aria-label={t(($) => $.teamLeader)}>
+          {agentsQuery.data?.items.find((agent) => agent.id === leader)?.name ??
+            t(($) => $.teamLeader)}
+        </SelectTrigger>
+        <SelectContent>
+          {(agentsQuery.data?.items ?? [])
+            .filter((agent) => members.includes(agent.id))
+            .map((agent) => (
+              <SelectItem key={agent.id} value={agent.id}>
+                <SelectItemText>{agent.name}</SelectItemText>
+              </SelectItem>
+            ))}
+        </SelectContent>
+      </Select>
+      <Field name="instructions">
+        <FieldLabel>{t(($) => $.instructions)}</FieldLabel>
+        <Textarea defaultValue={team?.instructions.join('\n') ?? ''} />
+      </Field>
+      <Field name="timeout">
+        <FieldLabel>{t(($) => $.teamTimeout)}</FieldLabel>
+        <FieldControl
+          type="number"
+          required
+          min={1}
+          max={3600}
+          defaultValue={String(team?.limits.timeout_seconds ?? 300)}
+        />
+      </Field>
+      <Field name="totalBudget">
+        <FieldLabel>{t(($) => $.teamTotalBudget)}</FieldLabel>
+        <FieldControl
+          type="number"
+          required
+          min={1}
+          max={10000000}
+          defaultValue={String(team?.limits.total_token_budget ?? 200000)}
+        />
+      </Field>
+      <Field name="handoffContext">
+        <FieldLabel>{t(($) => $.teamHandoffContext)}</FieldLabel>
+        <Textarea defaultValue={team?.handoff_context ?? ''} />
+      </Field>
+      <fieldset className="space-y-2">
+        <legend className="mb-2 text-sm font-medium">{t(($) => $.teamReviewPolicy)}</legend>
+        <Field name="maxRounds">
+          <FieldLabel>{t(($) => $.teamMaxReviewRounds)}</FieldLabel>
+          <FieldControl
+            type="number"
+            required
+            min={1}
+            max={10}
+            defaultValue={String(team?.review_policy?.max_rounds ?? 3)}
+          />
+        </Field>
+        <label className="flex items-center gap-2 text-sm">
+          <Checkbox
+            checked={requireUnanimous}
+            onCheckedChange={(checked) => setRequireUnanimous(Boolean(checked))}
+          />
+          {t(($) => $.teamRequireUnanimous)}
+        </label>
+        <Field name="reviewCriteria">
+          <FieldLabel>{t(($) => $.teamReviewCriteria)}</FieldLabel>
+          <Textarea defaultValue={team?.review_policy?.criteria.join('\n') ?? ''} />
+        </Field>
+      </fieldset>
+      <fieldset className="space-y-2">
+        <legend className="mb-2 text-sm font-medium">{t(($) => $.teamCompletion)}</legend>
+        <label className="flex items-center gap-2 text-sm">
+          <Checkbox
+            checked={allMembersExecuted}
+            onCheckedChange={(checked) => setAllMembersExecuted(Boolean(checked))}
+          />
+          {t(($) => $.teamCompletionAllMembers)}
+        </label>
+        <label className="flex items-center gap-2 text-sm">
+          <Checkbox
+            checked={noUnresolvedErrors}
+            onCheckedChange={(checked) => setNoUnresolvedErrors(Boolean(checked))}
+          />
+          {t(($) => $.teamCompletionNoErrors)}
+        </label>
+        <Field name="completionCustom">
+          <FieldLabel>{t(($) => $.teamCompletionCustom)}</FieldLabel>
+          <Textarea defaultValue={team?.completion?.custom ?? ''} />
+        </Field>
+      </fieldset>
+      {error && (
+        <p role="alert" className="text-sm text-text-destructive">
+          {error}
+        </p>
+      )}
+      <div className="flex justify-end gap-2">
+        <Button type="button" variant="secondary" onClick={onClose}>
+          {t(($) => $.cancel)}
+        </Button>
+        <Button type="submit" loading={save.isPending}>
+          {t(($) => $.save)}
+        </Button>
+      </div>
+    </Form>
+  )
+}
+
+function TeamDialog({
+  team,
+  open,
+  onOpenChange,
+  onSaved,
+}: {
+  team?: Team
+  open: boolean
+  onOpenChange: (open: boolean) => void
+  onSaved: () => void
+}) {
+  const { t } = useTranslation('uloo')
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange} disablePointerDismissal>
+      <DialogContent className="max-h-[calc(100dvh-2rem)] w-[640px] max-w-[calc(100vw-2rem)] overflow-y-auto">
+        <DialogCloseButton />
+        <DialogTitle>{team ? t(($) => $.editTeam) : t(($) => $.createTeam)}</DialogTitle>
+        <DialogDescription>{t(($) => $.teamsPageHint)}</DialogDescription>
+        <TeamForm
+          key={`${team?.version ?? 0}-${open}`}
+          team={team}
+          onSaved={onSaved}
+          onClose={() => onOpenChange(false)}
+        />
+      </DialogContent>
+    </Dialog>
+  )
+}
+
+export function UlooLiveTeamsPage() {
+  const { t } = useTranslation('uloo')
+  const routes = createUlooRoutes()
+  const [open, setOpen] = useState(false)
+  const teams = useQuery({
+    queryKey: ['uloo', 'teams', 'live'],
+    queryFn: () => get<{ items: Team[] }>('/uloo/teams', { params: { limit: 100, enabled: true } }),
+  })
+  return (
+    <div className="space-y-6">
+      <UlooPageHeading
+        title={t(($) => $.teams)}
+        description={t(($) => $.teamsPageHint)}
+        icon="i-ri-team-line"
+        actions={<Button onClick={() => setOpen(true)}>{t(($) => $.createTeam)}</Button>}
+      />
+      {teams.isLoading && <p role="status">Loading…</p>}
+      {teams.isError && <UlooUnavailableState runtimeHref={routes.runtime} />}
+      {teams.data?.items.length === 0 && <p>{t(($) => $.noTeams)}</p>}
+      <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
+        {teams.data?.items.map((team) => (
+          <Link
+            key={team.id}
+            href={routes.team(team.id)}
+            className="rounded-2xl border border-components-panel-border bg-background-default p-5"
+          >
+            <h2 className="font-semibold text-text-primary">{team.name}</h2>
+            <p className="mt-2 text-sm text-text-secondary">
+              {team.mode} · {team.member_agent_ids.length} Agents · v{team.version}
+            </p>
+            <p className="mt-3 text-sm text-text-tertiary">{team.description}</p>
+          </Link>
+        ))}
+      </section>
+      <TeamDialog
+        open={open}
+        onOpenChange={setOpen}
+        onSaved={() => {
+          void teams.refetch()
+        }}
+      />
+    </div>
+  )
+}
+
+export function UlooLiveTeamDetail({ teamId }: { teamId: string }) {
+  const { t } = useTranslation('uloo')
+  const routes = createUlooRoutes()
+  const [open, setOpen] = useState(false)
+  const teamQuery = useQuery({
+    queryKey: ['uloo', 'team', teamId],
+    queryFn: () => get<Team>(`/uloo/teams/${teamId}`),
+  })
+  const agents = useQuery(
+    consoleQuery.uloo.agents.get.queryOptions({ input: { query: { limit: 100 } } }),
+  )
+  const validate = useMutation({
+    mutationFn: () => post<{ valid: boolean; errors: string[] }>(`/uloo/teams/${teamId}/validate`),
+  })
+  if (teamQuery.isLoading) return <p role="status">Loading…</p>
+  if (!teamQuery.data || teamQuery.isError)
+    return <UlooUnavailableState runtimeHref={routes.runtime} />
+  const team = teamQuery.data
+  return (
+    <div className="space-y-6">
+      <UlooPageHeading
+        title={team.name}
+        description={`${team.mode} · v${team.version}`}
+        icon="i-ri-team-line"
+        backHref={routes.teams}
+        backLabel={t(($) => $.teams)}
+        actions={<Button onClick={() => setOpen(true)}>{t(($) => $.editTeam)}</Button>}
+      />
+      <p>{team.description}</p>
+      <section className="space-y-3">
+        {team.member_agent_ids.map((id) => (
+          <Link
+            key={id}
+            href={routes.agent(id)}
+            className="block rounded-xl border border-components-panel-border bg-background-default p-4"
+          >
+            {agents.data?.items.find((agent) => agent.id === id)?.name ?? id}
+            {id === team.leader_agent_id ? ` · ${t(($) => $.teamLeader)}` : ''}
+          </Link>
+        ))}
+      </section>
+      <pre className="rounded-xl bg-background-section-burn p-4 text-sm whitespace-pre-wrap">
+        {team.instructions.join('\n')}
+      </pre>
+      <Button loading={validate.isPending} onClick={() => validate.mutate()}>
+        {t(($) => $.validateTeam)}
+      </Button>
+      {validate.data && (
+        <p role="status">
+          {validate.data.valid ? t(($) => $.teamValid) : validate.data.errors.join('; ')}
+        </p>
+      )}
+      {validate.isError && <p role="alert">{getUlooErrorInfo(validate.error).message}</p>}
+      <TeamDialog
+        team={team}
+        open={open}
+        onOpenChange={setOpen}
+        onSaved={() => {
+          void teamQuery.refetch()
+        }}
+      />
+    </div>
+  )
+}

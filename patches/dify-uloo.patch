+  load.mockImplementation((url: string) => Promise.resolve(url.endsWith('dify-tools') ? { tools: [], unavailable: [] } : url.endsWith('skills') ? [] : [tool]))
+  save.mockResolvedValue({})
+  update.mockResolvedValue({})
+})
+it('shows Dify tool references as read-only without edit or delete buttons', async () => {
+  load.mockImplementation((url: string) => Promise.resolve(url.endsWith('dify-tools') ? { tools: [], unavailable: [] } : [
+    tool,
+    {
+      key: 'dify-search',
+      name: 'Dify Search',
+      description: 'A Dify-managed tool',
+      config: { tool_type: 'dify', provider_type: 'mcp', tool_name: 'search' },
+      enabled: true,
+      version: 1,
+    },
+  ]))
+  mount(<UlooToolsPage />)
+  await waitFor(() => expect(screen.getByText('Dify Search')).toBeInTheDocument())
+  // Only the builtin web-search tool should have an edit button; the Dify tool should not
+  const editButtons = await screen.findAllByRole('button', { name: 'uloo.editResource' })
+  expect(editButtons).toHaveLength(1)

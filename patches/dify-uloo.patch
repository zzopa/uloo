+'use client'
+
+import { Button } from '@langgenius/dify-ui/button'
+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import Link from '@/next/link'
+import { createUlooRoutes } from './routes'
+import { UlooTaskStageTracker } from './task-stage-tracker'
+
+type DemoPhase = 'planned' | 'running' | 'delivered'
+
+type DemoTask = {
+  title: string
+  query: string
+  initialPhase: DemoPhase
+  createdAt: string
+}
+
+const DEMO_TASKS: Record<string, DemoTask> = {
+  'demo-running': {
+    title: '某项目技术方案',
+    query: '为某项目输出技术方案，覆盖架构选型、实施步骤和风险清单。',
+    initialPhase: 'running',
+    createdAt: '2026-09-23 14:20',
+  },
+  'demo-done': {
+    title: '竞品分析报告',
+    query: '调研竞品 A/B/C 的核心能力、价格和定位，输出对比报告。',
+    initialPhase: 'delivered',
+    createdAt: '2026-09-22 12:10',
+  },
+  'demo-new': {
+    title: '多智能体产品规划',
+    query: '把“做一个多智能体平台”整理成可验收的产品方案。',
+    initialPhase: 'planned',
+    createdAt: '2026-09-23 15:00',
+  },
+}
+
+const DEMO_PLAN = [
+  {
+    agent: '需求分析 Agent',
+    icon: 'i-ri-file-search-line',
+    title: '澄清目标与验收边界',
+    output: '用户场景、范围边界和验收清单',
+  },
+  {
+    agent: '架构设计 Agent',
+    icon: 'i-ri-node-tree',
+    title: '设计多智能体协同架构',
+    output: '模块架构、接口边界和数据流',
+  },
+  {
+    agent: '风险审查 Agent',
+    icon: 'i-ri-shield-check-line',
+    title: '审查实施风险与依赖',
+    output: '风险分级、应对措施和里程碑',
+  },
+]
+
+const DEMO_EVENTS = [
+  { agent: '需求分析 Agent', detail: '已输出 6 个核心场景与 14 条验收标准', state: 'done' },
+  { agent: '架构设计 Agent', detail: '已完成控制平面、运行时与记忆层边界', state: 'done' },
+  { agent: '风险审查 Agent', detail: '正在核对 SSE、预算限制与失败恢复策略', state: 'running' },
+]
+
+export function UlooTaskDetailPreview({ taskId }: { taskId: string }) {
+  const { t } = useTranslation('uloo')
+  const routes = createUlooRoutes(true)
+  const fallback = DEMO_TASKS['demo-new']!
+  const task = DEMO_TASKS[taskId] ?? fallback
+  const [phase, setPhase] = useState<DemoPhase>(task.initialPhase)
+  const phaseIndex = phase === 'planned' ? 1 : phase === 'running' ? 2 : 3
+
+  function advanceDemo() {
+    setPhase((current) => (current === 'planned' ? 'running' : 'delivered'))
+  }
+
+  return (
+    <div className="space-y-5">
+      <div className="border-components-badge-status-light-warning-border text-components-badge-status-light-warning-text inline-flex items-center gap-2 rounded-full border bg-components-badge-status-light-warning-bg px-3 py-1 text-xs font-medium">
+        <span className="i-ri-flask-line" />
+        {t(($) => $.previewFlowLabel)}
+      </div>
+
+      <div className="flex items-center justify-between gap-3">
+        <div className="min-w-0">
+          <Link
+            href={routes.tasks}
+            className="text-xs font-medium text-text-tertiary hover:text-text-accent"
+          >
+            ← {t(($) => $.backToTasks)}
+          </Link>
+          <h1 className="mt-1 truncate text-xl font-semibold text-text-primary">{task.title}</h1>
+          <div className="mt-1 text-xs text-text-tertiary">{task.createdAt}</div>
+        </div>
+        <Link
+          href={routes.root}
+          className="shrink-0 rounded-lg border border-components-button-secondary-border px-3 py-1.5 text-xs font-medium text-components-button-secondary-text hover:bg-state-base-hover"
+        >
+          {t(($) => $.newTask)}
+        </Link>
+      </div>
+
+      <UlooTaskStageTracker activeIndex={phaseIndex} />
+
+      <div className="grid gap-4 xl:grid-cols-[0.8fr_1.2fr]">
+        <section className="rounded-2xl border border-components-panel-border bg-background-default p-5">
+          <h2 className="text-sm font-semibold text-text-primary">{t(($) => $.taskMeta)}</h2>
+          <div className="mt-3 rounded-lg bg-background-section-burn px-4 py-3">

+# AI生成
+"""ULOO dataset catalog: surface Dify workspace knowledge datasets for the agent selector.
+
+The agent editor needs a list of available knowledge datasets so the user can
+pick them from a dropdown instead of typing references by hand.  This service
+reads the Dify workspace datasets and returns a flat, UI-friendly list.
+"""
+
+import logging
+
+from extensions.ext_database import db
+from models.dataset import Dataset
+from sqlalchemy import select
+
+logger = logging.getLogger(__name__)
+
+
+def list_uloo_dataset_catalog(tenant_id: str) -> dict:
+    """Return knowledge datasets configured in the Dify workspace.
+
+    Structure::
+
+        {
+          "datasets": [
+            {
+              "id": "abc-123",
+              "name": "产品手册",
+              "description": "...",
+              "doc_count": 42,
+              "word_count": 12000,
+              "embedding_model": "text-embedding-3-small",
+              "embedding_model_provider": "openai",
+              "created_at": "2025-01-01T00:00:00Z"
+            },
+            ...
+          ]
+        }
+    """
+    datasets_out: list[dict] = []
+
+    try:
+        rows = db.session.scalars(
+            select(Dataset).where(Dataset.tenant_id == tenant_id).order_by(Dataset.created_at.desc())
+        ).all()
+    except Exception:
+        logger.warning("Cannot load ULOO dataset catalog for tenant %s", tenant_id, exc_info=True)
+        return {"datasets": []}
+
+    for row in rows:
+        datasets_out.append(
+            {
+                "id": str(row.id),
+                "name": row.name,
+                "description": row.description or "",
+                "doc_count": row.document_count or 0,
+                "word_count": row.word_count or 0,
+                "embedding_model": row.embedding_model or "",
+                "embedding_model_provider": row.embedding_model_provider or "",
+                "created_at": row.created_at.isoformat() if row.created_at else None,
+            }
+        )
+
+    return {"datasets": datasets_out}

diff --git a/web/features/uloo/__tests__/live-teams.test.tsx b/web/features/uloo/__tests__/live-teams.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..314fbbf35ea17d15e3f25790145867ddab24cfa9
--- /dev/null
+++ b/web/features/uloo/__tests__/live-teams.test.tsx
@@ -0,0 +1,112 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { fireEvent, render, screen, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { UlooLiveTeamDetail, UlooLiveTeamsPage } from '../teams/live'
+
+const { get, post, patch } = vi.hoisted(() => ({ get: vi.fn(), post: vi.fn(), patch: vi.fn() }))
+vi.mock('@/service/base', () => ({ get, post, patch }))
+vi.mock('@/service/client', () => ({
+  consoleQuery: {
+    uloo: {
+      agents: {
+        get: {
+          queryOptions: () => ({
+            queryKey: ['agents'],
+            queryFn: async () => ({
+              items: [{ id: 'analyst-1', name: 'Real analyst', role: 'Research' }],
+            }),
+          }),
+        },
+      },
+    },
+  },
+}))
+
+const team = {
+  id: 'team-1',
+  key: 'team-real',
+  name: 'Real DeepSeek team',
+  description: 'Real definitions',
+  mode: 'coordinate',
+  member_agent_ids: ['analyst-1'],
+  leader_agent_id: 'analyst-1',
+  instructions: ['Verify actual findings'],
+  limits: { timeout_seconds: 300, max_iterations: 8, max_tokens: 4096 },
+  enabled: true,
+  version: 2,
+}
+
+function renderPage(component: React.ReactNode) {
+  const client = new QueryClient({
+    defaultOptions: { queries: { retry: false }, mutations: { retry: false } },
+  })
+  return render(<QueryClientProvider client={client}>{component}</QueryClientProvider>)
+}
+
+describe('live ULOO teams', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    get.mockImplementation((url: string) =>
+      Promise.resolve(url === '/uloo/teams' ? { items: [team] } : team),
+    )
+    post.mockResolvedValue({ valid: false, errors: ['Model provider is not configured'] })
+  })
+
+  it('lists backend teams and links to the actual detail', async () => {
+    renderPage(<UlooLiveTeamsPage />)
+    expect(await screen.findByRole('link', { name: /Real DeepSeek team/ })).toHaveAttribute(
+      'href',
+      '/uloo/resources/teams/team-1',
+    )
+    expect(screen.queryByText('产品研发协同组')).not.toBeInTheDocument()
+  })
+
+  it('shows member definitions and real validation errors', async () => {
+    renderPage(<UlooLiveTeamDetail teamId="team-1" />)
+    expect(await screen.findByText('Real DeepSeek team')).toBeInTheDocument()
+    expect(await screen.findByRole('link', { name: /Real analyst/ })).toHaveAttribute(
+      'href',
+      '/uloo/resources/agents/analyst-1',
+    )
+    fireEvent.click(screen.getByRole('button', { name: 'uloo.validateTeam' }))
+    expect(await screen.findByText('Model provider is not configured')).toBeInTheDocument()
+    expect(post).toHaveBeenCalledWith('/uloo/teams/team-1/validate')
+  })
+
+  it('does not submit a team without selected members and leader', async () => {
+    renderPage(<UlooLiveTeamsPage />)
+    await screen.findByRole('link', { name: /Real DeepSeek team/ })
+    fireEvent.click(screen.getByRole('button', { name: 'uloo.createTeam' }))
+    fireEvent.change(screen.getByLabelText('uloo.agentName'), { target: { value: 'New team' } })
+    fireEvent.change(screen.getByLabelText('uloo.agentKey'), { target: { value: 'new-team' } })
+    fireEvent.submit(screen.getByRole('button', { name: 'uloo.save' }).closest('form')!)
+    await waitFor(() => expect(screen.getByText('uloo.teamSelectionRequired')).toBeInTheDocument())
+    expect(post).not.toHaveBeenCalled()
+  })
+
+  it('creates an executable team from the selected member and coordination lead', async () => {
+    const user = userEvent.setup()
+    post.mockResolvedValue(team)
+    renderPage(<UlooLiveTeamsPage />)
+    await screen.findByRole('link', { name: /Real DeepSeek team/ })
+    fireEvent.click(screen.getByRole('button', { name: 'uloo.createTeam' }))
+    fireEvent.change(screen.getByLabelText('uloo.agentName'), { target: { value: 'New team' } })
+    fireEvent.change(screen.getByLabelText('uloo.agentKey'), { target: { value: 'new-team' } })
+    await user.click(await screen.findByRole('checkbox', { name: /Real analyst/ }))
+    await user.click(screen.getByLabelText('uloo.teamLeader'))
+    await user.click(await screen.findByRole('option', { name: 'Real analyst' }))
+    fireEvent.submit(screen.getByRole('button', { name: 'uloo.save' }).closest('form')!)
+    await waitFor(() =>
+      expect(post).toHaveBeenCalledWith('/uloo/teams', {
+        body: expect.objectContaining({
+          key: 'new-team',
+          name: 'New team',
+          mode: 'coordinate',
+          member_agent_ids: ['analyst-1'],
+          leader_agent_id: 'analyst-1',
+        }),
+      }),
+    )
+  })
+})

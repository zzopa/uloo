+
+type StatusFilter = 'all' | 'enabled' | 'disabled'
+
+function AgentCard({
+  agent,
+  preview,
+  onEdit,
+  onDebug,
+  onChanged,
+  onDelete,
+  onPreviewToggle,
+  detailHref,
+}: {
+  agent: UlooAgentResponse
+  preview?: boolean
+  onEdit: () => void
+  onDebug: () => void
+  onChanged: () => void
+  onDelete: () => void
+  onPreviewToggle: () => void
+  detailHref: string
+}) {
+  const { t } = useTranslation('uloo')
+  const updateAgent = useMutation(consoleQuery.uloo.agents.byAgentId.patch.mutationOptions())
+  const validateAgent = useMutation(
+    consoleQuery.uloo.agents.byAgentId.validate.post.mutationOptions(),
+  )
+
+  function toggleEnabled() {
+    if (preview) {
+      onPreviewToggle()
+      toast.success(agent.enabled ? t(($) => $.agentDisabled) : t(($) => $.agentEnabled))
+      return
+    }
+    updateAgent.mutate(
+      {
+        params: { agent_id: agent.id },
+        body: { enabled: !agent.enabled, expected_version: agent.version },
+      },
+      {
+        onSuccess: () => {
+          toast.success(agent.enabled ? t(($) => $.agentDisabled) : t(($) => $.agentEnabled))
+          onChanged()
+        },
+        onError: (error) => toast.error(getUlooErrorInfo(error).message),
+      },
+    )
+  }
+
+  function validate() {
+    if (preview) {
+      toast.success(t(($) => $.previewValidationPassed))
+      return
+    }
+    validateAgent.mutate(
+      { params: { agent_id: agent.id } },
+      {
+        onSuccess: (result) => {
+          if (result.valid) toast.success(t(($) => $.validationPassed))
+          else toast.error(result.errors.join(' · '))
+        },
+        onError: (error) => toast.error(getUlooErrorInfo(error).message),
+      },
+    )
+  }
+
+  return (
+    <article className="flex min-h-52 min-w-0 flex-col rounded-xl border border-components-card-border bg-components-card-bg shadow-xs transition-shadow hover:shadow-md">
+      <div className="flex min-w-0 flex-1 flex-col p-4">
+        <div className="flex items-start gap-3">
+          <div className="flex size-10 shrink-0 items-center justify-center rounded-xl bg-background-section-burn text-text-accent">
+            <span className="i-ri-robot-2-line text-xl" />
+          </div>
+          <div className="min-w-0 flex-1">
+            <div className="flex items-center gap-2">
+              <h2 className="truncate text-sm font-semibold text-text-primary">
+                <Link href={detailHref} className="hover:text-text-accent">
+                  {agent.name}
+                </Link>
+              </h2>
+              <span
+                className={`shrink-0 rounded-md px-1.5 py-0.5 text-[10px] font-semibold ${agent.enabled ? 'text-components-badge-status-light-success-text bg-components-badge-status-light-success-bg' : 'bg-components-badge-bg-dimm text-text-tertiary'}`}
+              >
+                {agent.enabled ? t(($) => $.enabled) : t(($) => $.disabled)}

diff --git a/web/features/uloo/__tests__/dashboard.test.tsx b/web/features/uloo/__tests__/dashboard.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0327ba622956c68e0aedf9d3f23e8ff9287749b3
--- /dev/null
+++ b/web/features/uloo/__tests__/dashboard.test.tsx
@@ -0,0 +1,170 @@
+import { fireEvent, screen, waitFor } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { UlooDashboard } from '@/features/uloo/dashboard'
+import { UlooTasksList } from '@/features/uloo/tasks-list'
+import { renderWithConsoleQuery } from '@/test/console/query-data'
+
+const push = vi.fn()
+
+vi.mock('@/next/navigation', () => ({
+  useRouter: vi.fn(() => ({ push, replace: vi.fn(), prefetch: vi.fn() })),
+  usePathname: vi.fn(() => '/uloo'),
+  useParams: vi.fn(() => ({})),
+}))
+
+vi.mock('@/hooks/use-document-title', () => ({ default: vi.fn() }))
+
+type FetchHandler = (input: RequestInfo | URL, init?: RequestInit) => Promise<Response>
+
+const urlOf = (input: RequestInfo | URL): string =>
+  input instanceof Request ? input.url : String(input)
+const methodOf = (input: RequestInfo | URL, init?: RequestInit): string =>
+  init?.method ?? (input instanceof Request ? input.method : 'GET')
+
+const jsonResponse = (body: unknown, status = 200): Promise<Response> =>
+  Promise.resolve(
+    new Response(JSON.stringify(body), {
+      status,
+      headers: { 'Content-Type': 'application/json' },
+    }),
+  )
+
+const baseStub =
+  (tasks: unknown[], handler?: FetchHandler): FetchHandler =>
+  (input, init) => {
+    const url = urlOf(input)
+    const method = methodOf(input, init)
+    if (method === 'GET' && url.includes('/uloo/teams'))
+      return jsonResponse({ items: [], total: 0, offset: 0, limit: 100 })
+    if (method === 'GET' && url.includes('/uloo/tasks'))
+      return jsonResponse({ items: tasks, total: tasks.length, offset: 0, limit: 6 })
+    return handler?.(input, init) ?? jsonResponse({ error: 'not found' }, 404)
+  }
+
+const stubFetch = (handler: FetchHandler) => {
+  const mock = vi.fn(handler)
+  vi.stubGlobal('fetch', mock as typeof fetch)
+  return mock
+}
+
+describe('UlooDashboard task entry', () => {
+  it('shows preview tasks with workbench links without requesting production data', () => {
+    const fetchMock = stubFetch(baseStub([]))
+    renderWithConsoleQuery(<UlooTasksList preview />)
+    expect(screen.getByRole('link', { name: '某项目技术方案' })).toHaveAttribute(
+      'href',
+      '/uloo-preview/tasks/demo-running',
+    )
+    expect(screen.getByRole('link', { name: '竞品分析报告' })).toHaveAttribute(
+      'href',
+      '/uloo-preview/tasks/demo-done',
+    )
+    expect(fetchMock).not.toHaveBeenCalled()
+  })
+  beforeEach(() => {
+    push.mockClear()
+    vi.unstubAllGlobals()
+  })
+
+  it('renders the hero input, examples, and recent tasks', async () => {
+    stubFetch(
+      baseStub([
+        {
+          id: 'task-1',
+          title: '调研竞品方案',
+          query: '调研竞品并输出对比报告',
+          status: 'running',
+          created_at: new Date().toISOString(),
+        },
+      ]),
+    )
+    renderWithConsoleQuery(<UlooDashboard />)
+
+    expect(screen.getByPlaceholderText('uloo.taskInputPlaceholder')).toBeInTheDocument()
+    expect(screen.getByText('uloo.taskHeroTitle')).toBeInTheDocument()
+    await waitFor(() => {
+      expect(screen.getByText('调研竞品方案')).toBeInTheDocument()
+    })
+  })
+
+  it('blocks empty submissions (no navigation, no request)', async () => {
+    const fetchMock = stubFetch(baseStub([]))
+    renderWithConsoleQuery(<UlooDashboard />)
+    fireEvent.click(screen.getByRole('button', { name: /uloo\.planTask/i }))
+
+    expect(push).not.toHaveBeenCalled()
+    // Only the two initial GETs happened; no POST was issued.
+    expect(
+      fetchMock.mock.calls.every(
+        ([, init]: [RequestInfo | URL, RequestInit?]) => (init?.method ?? 'GET') === 'GET',
+      ),
+    ).toBe(true)
+  })
+
+  it('fills the input when an example is clicked', async () => {
+    stubFetch(baseStub([]))
+    renderWithConsoleQuery(<UlooDashboard />)
+    fireEvent.click(screen.getByRole('button', { name: /uloo\.exampleCompetitor/i }))
+    const textarea = screen.getByPlaceholderText('uloo.taskInputPlaceholder') as HTMLTextAreaElement
+    expect(textarea.value).toContain('uloo.exampleCompetitor')
+  })
+
+  it('creates a task and navigates to the task workspace', async () => {
+    const seen: string[] = []
+    stubFetch(
+      baseStub([], (input, init) => {
+        const url = urlOf(input)
+        const method = methodOf(input, init)
+        seen.push(`${method} ${url}`)
+        if (method === 'POST' && url.includes('/uloo/tasks')) {
+          if (url.includes('/plan')) {
+            return jsonResponse(
+              {
+                id: 'plan-1',
+                task_id: 'task-new',
+                version: 1,
+                summary: '执行计划',
+                assumptions: [],
+                questions: [],
+                recommended_team_id: 'team-1',
+                steps: [],
+                approval_status: 'pending',
+                runtime_type: 'agno',
+                is_mock: false,
+              },
+              201,
+            )
+          }
+          return jsonResponse({
+            id: 'task-new',
+            title: '调研竞品 A/B/C，输出对比报告',
+            query: '调研竞品 A/B/C，输出对比报告',
+            status: 'draft',
+            session_id: 'session-1',
+            current_plan_version: 1,
+            plans: [],
+            created_at: new Date().toISOString(),
+            updated_at: new Date().toISOString(),
+          })
+        }
+        return jsonResponse({ error: 'not found' }, 404)
+      }),
+    )
+    renderWithConsoleQuery(<UlooDashboard />)
+
+    const textarea = screen.getByPlaceholderText('uloo.taskInputPlaceholder')
+    fireEvent.change(textarea, { target: { value: '调研竞品 A/B/C，输出对比报告' } })
+    fireEvent.click(screen.getByRole('button', { name: /uloo\.planTask/i }))
+
+    await waitFor(
+      () => {
+        expect(
+          seen.some((entry) => entry.startsWith('POST') && entry.includes('/uloo/tasks')),
+        ).toBe(true)
+        expect(seen.some((entry) => entry.startsWith('POST') && entry.includes('/plan'))).toBe(true)
+        expect(push).toHaveBeenCalledWith('/uloo/tasks/task-new')
+      },
+      { timeout: 3000 },
+    )
+  })
+})

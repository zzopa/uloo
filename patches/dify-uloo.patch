+'use client'
+
+import type { ReactNode } from 'react'
+import { cn } from '@langgenius/dify-ui/cn'
+import { useTranslation } from 'react-i18next'
+import Link, { useLinkStatus } from '@/next/link'
+import { usePathname } from '@/next/navigation'
+import { createUlooRoutes } from './routes'
+
+type NavigationItem = {
+  href: string
+  label: string
+  icon: string
+  exact?: boolean
+}
+
+type NavigationGroup = {
+  label: string
+  items: NavigationItem[]
+}
+
+function isNavigationItemActive(pathname: string, item: NavigationItem) {
+  if (item.exact) return pathname === item.href
+  return pathname === item.href || pathname.startsWith(`${item.href}/`)
+}
+
+function NavigationLinkContent({ item }: { item: NavigationItem }) {
+  const { pending } = useLinkStatus()
+
+  return (
+    <>
+      <span
+        className={cn(
+          pending ? 'i-ri-loader-4-line animate-spin' : item.icon,
+          'shrink-0 text-base',
+        )}
+      />
+      <span className="whitespace-nowrap">{item.label}</span>
+    </>
+  )
+}
+
+function NavigationLink({ item, compact = false }: { item: NavigationItem; compact?: boolean }) {
+  const pathname = usePathname()
+  const active = isNavigationItemActive(pathname, item)
+
+  return (
+    <Link
+      href={item.href}
+      prefetch
+      aria-current={active ? 'page' : undefined}
+      className={cn(
+        'group flex items-center gap-2.5 rounded-lg text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-components-button-primary-bg focus-visible:outline-none',
+        compact ? 'shrink-0 px-3 py-2' : 'px-3 py-2.5',
+        active
+          ? 'bg-state-accent-active text-text-accent'
+          : 'text-text-secondary hover:bg-state-base-hover hover:text-text-primary',
+      )}
+    >
+      <NavigationLinkContent item={item} />
+    </Link>
+  )
+}
+
+export function UlooShell({
+  children,
+  preview = false,
+}: {
+  children: ReactNode
+  preview?: boolean
+}) {
+  const { t } = useTranslation('uloo')
+  const pathname = usePathname()
+  const routes = createUlooRoutes(preview)
+  const groups: NavigationGroup[] = [
+    {
+      label: t(($) => $.navWork),
+      items: [
+        {
+          href: routes.root,
+          label: t(($) => $.newTask),
+          icon: 'i-ri-add-circle-line',
+          exact: true,
+        },
+        { href: routes.tasks, label: t(($) => $.allTasks), icon: 'i-ri-file-list-3-line' },
+      ],
+    },
+    {
+      label: t(($) => $.teams),
+      items: [
+        { href: routes.teams, label: t(($) => $.teams), icon: 'i-ri-team-line' },
+      ],
+    },
+    {
+      label: t(($) => $.agents),
+      items: [
+        {
+          href: routes.agents,
+          label: t(($) => $.agents),
+          icon: 'i-ri-robot-2-line',
+        },
+      ],
+    },
+    {
+      label: t(($) => $.navIntegration),
+      items: [
+        {
+          href: routes.settings,
+          label: t(($) => $.navIntegration),
+          icon: 'i-ri-settings-3-line',
+        },
+      ],
+    },
+  ]
+  const allItems = groups.flatMap((group) => group.items)
+  const currentItem = [
+    ...allItems,
+    { href: routes.skills, label: t(($) => $.skillLibrary), icon: 'i-ri-book-open-line' },
+    { href: routes.tools, label: t(($) => $.toolLibrary), icon: 'i-ri-tools-line' },
+    { href: routes.runs, label: t(($) => $.runs), icon: 'i-ri-pulse-line' },
+    { href: routes.artifacts, label: t(($) => $.artifacts), icon: 'i-ri-folder-chart-line' },
+    { href: routes.runtime, label: t(($) => $.runtime), icon: 'i-ri-server-line' },
+  ].find((item) => isNavigationItemActive(pathname, item))
+
+  return (
+    <div className="flex h-full min-w-0 overflow-hidden bg-background-default-subtle">
+      <aside className="hidden w-60 shrink-0 flex-col border-r border-divider-subtle bg-background-default md:flex lg:w-64">
+        <div className="border-b border-divider-subtle px-5 py-5">
+          <Link
+            href={routes.root}
+            aria-label={t(($) => $.taskCenter)}
+            className="inline-flex rounded-md focus-visible:ring-2 focus-visible:ring-components-button-primary-bg focus-visible:outline-none"
+          >
+            <img
+              src="/images/uloo/logo-horizontal.png"
+              alt="ULOO 驭龙"
+              width={720}
+              height={240}
+              className="h-9 w-auto object-contain dark:brightness-0 dark:invert"
+            />
+          </Link>
+          <p className="mt-3 text-[10px] leading-5 tracking-[0.1em] text-text-quaternary uppercase">
+            Unified Logic Orchestration &amp; Operations
+          </p>
+          {preview && (
+            <div className="bg-components-badge-status-light-info-bg text-components-badge-status-light-info-text mt-3 inline-flex items-center gap-1 rounded-md px-2 py-1 text-[10px] font-semibold">
+              <span className="i-ri-flask-line" />
+              {t(($) => $.previewMode)}
+            </div>
+          )}
+        </div>
+
+        <nav className="min-h-0 flex-1 space-y-5 overflow-y-auto px-3 py-4" aria-label="ULOO">
+          {groups.map((group) => (
+            <section key={group.label}>
+              <div className="mb-1 px-3 text-[10px] font-semibold tracking-[0.12em] text-text-quaternary uppercase">
+                {group.label}
+              </div>
+              <div className="space-y-0.5">
+                {group.items.map((item) => (
+                  <NavigationLink key={item.href} item={item} />
+                ))}
+              </div>
+            </section>
+          ))}
+        </nav>
+
+        <div className="border-t border-divider-subtle p-3">
+          <NavigationLink
+            item={{
+              href: routes.runtime,
+              label: t(($) => $.runtime),
+              icon: 'i-ri-server-line',
+            }}
+          />
+        </div>
+      </aside>
+
+      <div className="flex min-w-0 flex-1 flex-col overflow-hidden">
+        <div className="hidden h-16 shrink-0 items-center justify-between gap-4 border-b border-divider-subtle bg-background-default px-6 md:flex lg:px-8">
+          <div className="flex min-w-0 items-center gap-3 text-sm">
+            <Link
+              href={routes.root}
+              className="text-text-tertiary hover:text-text-accent focus-visible:outline-2 focus-visible:outline-offset-4"
+            >
+              ULOO
+            </Link>
+            <span aria-hidden="true" className="i-ri-arrow-right-s-line text-text-quaternary" />
+            <span className="truncate font-medium text-text-primary">
+              {currentItem?.label ?? t(($) => $.taskCenter)}
+            </span>
+            {preview && (
+              <span className="bg-components-badge-status-light-info-bg text-components-badge-status-light-info-text shrink-0 rounded-full px-2.5 py-1 text-[10px] font-medium">
+                {t(($) => $.previewMode)}
+              </span>
+            )}
+          </div>
+          <div className="flex shrink-0 items-center gap-4">
+            <Link
+              href={routes.runtime}
+              className="inline-flex items-center gap-2 text-xs text-text-secondary hover:text-text-accent focus-visible:outline-2 focus-visible:outline-offset-4"
+            >
+              <span className="i-ri-server-line" />
+              {t(($) => $.runtime)}
+            </Link>
+            <Link
+              href={routes.root}
+              className="inline-flex items-center gap-1.5 rounded-lg bg-components-button-primary-bg px-3 py-2 text-xs font-semibold text-text-primary-on-surface hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4"
+            >
+              <span className="i-ri-add-line" />
+              {t(($) => $.newTask)}
+            </Link>
+          </div>
+        </div>
+        <header className="shrink-0 border-b border-divider-subtle bg-background-default md:hidden">
+          <div className="flex items-center justify-between px-4 py-3">
+            <Link href={routes.root} aria-label={t(($) => $.taskCenter)}>
+              <img
+                src="/images/uloo/logo-horizontal.png"
+                alt="ULOO 驭龙"
+                width={720}
+                height={240}
+                className="h-8 w-auto object-contain dark:brightness-0 dark:invert"
+              />
+            </Link>
+            {preview && (
+              <span className="bg-components-badge-status-light-info-bg text-components-badge-status-light-info-text rounded-md px-2 py-1 text-[10px] font-semibold">
+                {t(($) => $.previewMode)}
+              </span>
+            )}
+          </div>
+          <nav className="flex scrollbar-none gap-1 overflow-x-auto px-3 pb-2" aria-label="ULOO">
+            {allItems.map((item) => (
+              <NavigationLink key={item.href} item={item} compact />
+            ))}
+            <NavigationLink
+              compact
+              item={{
+                href: routes.runtime,
+                label: t(($) => $.runtime),
+                icon: 'i-ri-server-line',
+              }}
+            />
+          </nav>
+        </header>
+
+        <main className="min-h-0 flex-1 overflow-y-auto px-4 py-5 sm:px-6 sm:py-7 lg:px-8">
+          <div key={pathname} className="mx-auto max-w-[1280px]">
+            {children}
+          </div>
+        </main>
+      </div>
+    </div>
+  )
+}

+// AI生成
+'use client'
+
+import { Checkbox } from '@langgenius/dify-ui/checkbox'
+import { useQuery } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+
+type DifyDataset = {
+  id: string
+  name: string
+  description?: string
+  document_count?: number
+  word_count?: number
+}
+
+/**
+ * S1-7: Dataset picker that fetches Dify workspace datasets directly,
+ * so the user can select knowledge bases without manual ID entry.
+ */
+export function UlooDatasetPicker({
+  selected,
+  onChange,
+  preview = false,
+}: {
+  selected: string[]
+  onChange: (refs: string[]) => void
+  preview?: boolean
+}) {
+  const { t } = useTranslation('uloo')
+  const datasets = useQuery({
+    queryKey: ['uloo-dify-datasets-picker'],
+    queryFn: async () => {
+      const res = await fetch('/console/api/uloo/dify-datasets')
+      if (!res.ok) return { datasets: [] as DifyDataset[] }
+      return res.json() as Promise<{ datasets: DifyDataset[] }>
+    },
+    enabled: !preview,
+    retry: false,
+  })
+
+  const available = datasets.data?.datasets ?? []
+  const refs = [...new Set([...available.map((d) => d.id), ...selected])]
+
+  function handleToggle(ref: string, checked: boolean) {
+    onChange(checked ? [...selected, ref] : selected.filter((item) => item !== ref))
+  }
+
+  function getDatasetInfo(ref: string): DifyDataset | undefined {
+    return available.find((d) => d.id === ref)
+  }
+
+  return (
+    <fieldset className="space-y-2 rounded-xl border border-components-panel-border p-3 sm:col-span-2">
+      <legend className="px-1 text-sm font-medium">
+        {t(($) => $.knowledgeReferences)}
+      </legend>
+      {datasets.isLoading && <p role="status">{t(($) => $.toolCatalogLoading)}</p>}
+      {datasets.isError && <p role="alert">{t(($) => $.toolCatalogError)}</p>}
+      {!datasets.isLoading && !datasets.isError && !refs.length && (
+        <p>{t(($) => $.noRegisteredTools)}</p>
+      )}
+      {refs.map((ref) => {
+        const info = getDatasetInfo(ref)
+        return (
+          <label key={ref} className="flex items-start gap-2 text-sm">
+            <Checkbox
+              checked={selected.includes(ref)}
+              onCheckedChange={(checked) => handleToggle(ref, checked === true)}
+            />
+            <span>
+              <span className="font-medium">
+                {info?.name ?? ref}
+                {info && (
+                  <span className="ml-1.5 rounded bg-components-badge-status-light-success-bg px-1.5 py-0.5 text-[10px] font-medium text-components-badge-status-light-success-text">
+                    Dify
+                  </span>
+                )}
+              </span>
+              <span className="ml-2 font-mono text-xs text-text-tertiary">{ref}</span>
+              {info?.description && (
+                <span className="block text-xs text-text-tertiary">{info.description}</span>
+              )}
+              {info?.document_count !== undefined && (
+                <span className="block text-xs text-text-quaternary">
+                  {info.document_count} docs · {info.word_count ?? 0} words
+                </span>
+              )}
+            </span>
+          </label>
+        )
+      })}
+    </fieldset>
+  )
+}

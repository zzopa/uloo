diff --git a/api/controllers/console/uloo_proxy.py b/api/controllers/console/uloo_proxy.py
new file mode 100644
index 0000000000000000000000000000000000000000..fef629fc7e9e540e68f8df08389c60367ec59dcb
--- /dev/null
+++ b/api/controllers/console/uloo_proxy.py
@@ -0,0 +1,391 @@
+# AI生成
+"""Same-origin Console BFF in front of the ULOO Core API.
+
+Dify Web never talks to ULOO Core directly (implementation plan section 5.2): the
+browser only reaches ``/console/api/uloo/**`` and this controller forwards to ULOO
+Core ``/api/v1/**`` over the server network with the service credential attached.
+
+Raw Blueprint routes deliberately stay outside Dify's OpenAPI surface, because ULOO
+Core owns that wire contract (``contracts/openapi.yaml``). Forwarding is confined to
+an explicit root-segment allow-list with traversal-like segments rejected, request
+bodies are capped, SSE responses stream through without being buffered with a
+bounded idle read timeout, and only safe response headers are exposed.
+
+The Dify workspace identity is what ULOO receives as its workspace scope, so a user
+never has to configure a second tenancy.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import uuid
+from collections.abc import Iterator
+from functools import wraps
+from http import HTTPStatus
+from typing import Any
+
+import httpx
+from flask import Response, has_request_context, request, stream_with_context
+from flask.typing import ResponseReturnValue
+from werkzeug.exceptions import NotFound, RequestEntityTooLarge
+
+from configs import dify_config
+from controllers.console import api, bp
+from controllers.console.wraps import account_initialization_required, setup_required
+from core.helper import ssrf_proxy
+from core.tools.errors import ToolSSRFError
+from libs.login import current_account_with_tenant, login_required
+
+logger = logging.getLogger(__name__)
+
+ALLOWED_ROOT_SEGMENTS = frozenset({"tools", "skills", "agents", "teams", "tasks", "runs", "memories", "memory-proposals"})
+
+_MAX_PROXY_BODY_BYTES = 8 * 1024 * 1024
+_MAX_BUFFERED_RESPONSE_BYTES = 16 * 1024 * 1024
+
+_RESPONSE_HEADER_ALLOWLIST = ("Cache-Control", "Content-Type", "Retry-After", "X-Request-Id", "X-Trace-Id")
+
+# Error codes are fixed by implementation plan section 4.4, so the browser can
+# branch on them instead of parsing prose.
+_CODE_TIMEOUT = "TIMEOUT"
+_CODE_RUNTIME_UNAVAILABLE = "RUNTIME_UNAVAILABLE"
+
+
+def _console_api_errors[**P](view: Any) -> Any:
+    """Route raw Blueprint exceptions through the Console API JSON handlers."""
+
+    @wraps(view)
+    def decorated(*args: P.args, **kwargs: P.kwargs) -> ResponseReturnValue:
+        try:
+            return view(*args, **kwargs)
+        except Exception as exc:
+            return api.handle_error(exc)
+
+    return decorated
+
+
+def _uloo_error(status: int, code: str, message: str) -> Response:
+    """A ULOO Core shaped error body, never a leaked upstream traceback."""
+    request_id = request.headers.get("X-Request-ID") if has_request_context() else None
+    trace_id = request.headers.get("X-Trace-ID") if has_request_context() else None
+    request_id = request_id or str(uuid.uuid4())
+    trace_id = trace_id or request_id
+    response = Response(
+        json.dumps(
+            {
+                "code": code,
+                "message": message,
+                "request_id": request_id,
+                "trace_id": trace_id,
+            },
+            ensure_ascii=False,
+        ),
+        status=status,
+        content_type="application/json",
+    )
+    response.headers["X-Request-ID"] = request_id
+    response.headers["X-Trace-ID"] = trace_id
+    return response
+
+
+def _validate_upstream_path(upstream_path: str) -> str:
+    """Return the path if it is allow-listed, otherwise raise NotFound.
+
+    Rejecting empty, dot, dot-dot, backslash, and percent-encoded segments keeps the
+    proxy from being usable as an arbitrary URL or path-traversal device.
+    """
+    segments = upstream_path.split("/")
+    for segment in segments:
+        if not segment or segment in {".", ".."} or "\\" in segment or "%" in segment:
+            raise NotFound()
+
+    if segments[0] not in ALLOWED_ROOT_SEGMENTS:
+        raise NotFound()
+
+    return "/".join(segments)
+
+
+def _upstream_url(upstream_path: str) -> str:
+    """Compose the ULOO Core URL, verified to stay under the configured origin."""
+    base = httpx.URL(dify_config.ULOO_CORE_URL.rstrip("/") + "/")
+    url = base.join(f"api/v1/{upstream_path}")
+
+    if not str(url).startswith(str(base)):
+        raise NotFound()
+
+    return str(url)
+
+
+def _forward_headers() -> dict[str, str]:
+    """Build upstream headers: service credential, correlation ids, and caller identity (S1-6)."""
+    headers = {"X-ULOO-Source": "dify-console-bff"}
+
+    token = dify_config.ULOO_CORE_API_TOKEN
+    if token:
+        headers["Authorization"] = f"Bearer {token}"
+
+    for name in ("X-Request-ID", "X-Trace-ID"):
+        value = request.headers.get(name)
+        if value:
+            headers[name] = value
+
+    # S1-6: Forward the Dify workspace caller identity so Core can invoke
+    # Dify inner APIs with the same user/app context as the console session.
+    try:
+        account, _tenant_id = current_account_with_tenant()
+        headers["X-ULOO-User-Id"] = str(account.id)
+        app_id = request.headers.get("X-App-Id", "")
+        if app_id:
+            headers["X-ULOO-App-Id"] = app_id
+    except Exception:
+        pass
+
+    return headers
+
+
+def _request_body() -> bytes | None:
+    """Read the raw body up to the proxy limit, or None for bodyless methods."""
+    if request.method in {"GET", "HEAD", "DELETE"}:
+        return None
+
+    body = request.stream.read(_MAX_PROXY_BODY_BYTES + 1)
+    if len(body) > _MAX_PROXY_BODY_BYTES:
+        raise RequestEntityTooLarge("ULOO proxy request body is too large")
+
+    return body
+
+
+def _stream_upstream(upstream: httpx.Response) -> Iterator[bytes]:
+    """Yield an upstream SSE body and always release its pooled connection."""
+    try:
+        for chunk in upstream.iter_bytes():
+            yield chunk
+    finally:
+        upstream.close()
+
+
+def _proxy_response(upstream: httpx.Response, *, tenant_id: str) -> Response:
+    """Expose status and allowlisted headers, streaming SSE and buffering the rest."""
+    headers = {
+        name: value
+        for name in _RESPONSE_HEADER_ALLOWLIST
+        if (value := upstream.headers.get(name)) is not None
+    }
+    content_type = upstream.headers.get("content-type", "").partition(";")[0].strip().lower()
+
+    if content_type == "text/event-stream":
+        # A compressed stream cannot be forwarded incrementally, and buffering it
+        # would defeat the point of streaming member events to the browser.
+        encoding = upstream.headers.get("content-encoding", "identity").strip().lower()
+        if encoding not in {"", "identity"}:
+            upstream.close()
+            return _uloo_error(
+                HTTPStatus.BAD_GATEWAY,
+                _CODE_RUNTIME_UNAVAILABLE,
+                "ULOO Core returned a compressed stream, which the BFF cannot forward incrementally",
+            )
+
+        headers["Cache-Control"] = "no-cache"
+        headers["X-Accel-Buffering"] = "no"
+
+        proxied = Response(
+            stream_with_context(_stream_upstream(upstream)),
+            status=upstream.status_code,
+            headers=headers,
+        )
+        proxied.call_on_close(upstream.close)
+        proxied.headers["X-ULOO-Status"] = "streaming"
+
+        logger.debug("proxied ULOO SSE stream for tenant_id=%s status=%s", tenant_id, upstream.status_code)
+        return proxied
+
+    try:
+        buffered = ssrf_proxy.buffer_response(upstream, max_response_bytes=_MAX_BUFFERED_RESPONSE_BYTES)
+    except ssrf_proxy.ResponseLimitError:
+        return _uloo_error(
+            HTTPStatus.BAD_GATEWAY,
+            _CODE_RUNTIME_UNAVAILABLE,
+            "ULOO Core response exceeded the BFF buffer limit",
+        )
+    finally:
+        upstream.close()
+
+    logger.debug("proxied ULOO response for tenant_id=%s status=%s", tenant_id, upstream.status_code)
+    return Response(buffered.content, status=upstream.status_code, headers=headers)
+
+
+def _proxy_request(upstream_path: str, tenant_id: str, *, body: bytes | None = None) -> Response:
+    """Forward the current console request to ULOO Core."""
+    headers = _forward_headers()
+    headers["X-ULOO-Workspace"] = tenant_id
+
+    if request.content_type:
+        headers["Content-Type"] = request.content_type
+
+    try:
+        upstream = ssrf_proxy.make_request(
+            method=request.method,
+            url=_upstream_url(upstream_path),
+            params=request.query_string or None,
+            content=body if body is not None else _request_body(),
+            headers=headers,
+            timeout=httpx.Timeout(
+                timeout=dify_config.ULOO_PROXY_READ_TIMEOUT_SECONDS,
+                connect=dify_config.ULOO_PROXY_CONNECT_TIMEOUT_SECONDS,
+            ),
+            follow_redirects=False,
+            max_retries=0,
+            stream_response=True,
+        )
+    except httpx.TimeoutException:
+        logger.warning("ULOO Core timed out for tenant_id=%s path=%s", tenant_id, upstream_path)
+        return _uloo_error(HTTPStatus.GATEWAY_TIMEOUT, _CODE_TIMEOUT, "ULOO Core request timed out")
+    except ToolSSRFError:
+        logger.error("ULOO Core origin was blocked by outbound policy: %s", dify_config.ULOO_CORE_URL)
+        return _uloo_error(
+            HTTPStatus.SERVICE_UNAVAILABLE,
+            _CODE_RUNTIME_UNAVAILABLE,
+            "ULOO Core origin is blocked by the outbound request policy",
+        )
+    except httpx.RequestError as exc:
+        logger.warning("ULOO Core transport failed for tenant_id=%s path=%s: %s", tenant_id, upstream_path, exc)
+        return _uloo_error(HTTPStatus.SERVICE_UNAVAILABLE, _CODE_RUNTIME_UNAVAILABLE, "ULOO Core is unavailable")
+
+    return _proxy_response(upstream, tenant_id=tenant_id)
+
+
+@bp.route(
+    "/uloo/<path:upstream_path>",
+    methods=["GET", "POST", "PATCH", "PUT", "DELETE", "OPTIONS"],
+    provide_automatic_options=True,
+)
+@_console_api_errors
+@setup_required
+@login_required
+@account_initialization_required
+def proxy_uloo(upstream_path: str) -> ResponseReturnValue:
+    """Forward one authenticated console request to ULOO Core.
+
+    Args:
+        upstream_path: Path captured after ``/console/api/uloo/``.
+
+    Returns:
+        The upstream response, streamed when it is an event stream.
+    """
+    allowed_path = _validate_upstream_path(upstream_path)
+    _, tenant_id = current_account_with_tenant()
+    return _proxy_request(allowed_path, tenant_id)
+
+
+@bp.route("/uloo/dify-tools", methods=["GET"])
+@_console_api_errors
+@setup_required
+@login_required
+@account_initialization_required
+def uloo_tool_catalog():
+    from services.uloo_tool_catalog import list_uloo_tool_catalog
+
+    account, tenant_id = current_account_with_tenant()
+    return list_uloo_tool_catalog(account.id, tenant_id)
+
+
+@bp.route("/uloo/dify-tools/import", methods=["POST"])
+@_console_api_errors
+@setup_required
+@login_required
+@account_initialization_required
+def uloo_import_tool():
+    from services.uloo_tool_catalog import list_uloo_tool_catalog
+
+    account, tenant_id = current_account_with_tenant()
+    try:
+        payload = json.loads(_request_body() or b"{}")
+    except (ValueError, UnicodeDecodeError):
+        return _uloo_error(400, "INVALID_TOOL_REFERENCE", "Invalid JSON request")
+    if not isinstance(payload, dict) or not isinstance(payload.get("key"), str):
+        return _uloo_error(400, "INVALID_TOOL_REFERENCE", "A Dify tool key is required")
+    catalog = list_uloo_tool_catalog(account.id, tenant_id)
+    item = next((item for item in catalog["tools"] if item["key"] == payload["key"]), None)
+    if item is None:
+        return _uloo_error(404, "DIFY_TOOL_NOT_FOUND", "Dify tool is no longer available")
+    if not item["enabled"]:
+        return _uloo_error(422, "DIFY_TOOL_REQUIRES_CONFIGURATION", item["unavailable_reason"])
+    body = {key: item[key] for key in ("key", "name", "description", "enabled", "config")}
+    return _proxy_request("tools", tenant_id, body=json.dumps(body, ensure_ascii=False).encode())
+

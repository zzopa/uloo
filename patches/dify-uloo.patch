+from core.app.entities.app_invoke_entities import InvokeFrom
+from libs.exception import BaseHTTPException
+from models.model import App, AppMode, EndUser
+from services.app_generate_service import AppGenerateService
+
+logger = logging.getLogger(__name__)
+
+
+class WorkflowRunInnerRequest(BaseModel):
+    app_id: str = Field(..., description="Dify workflow app ID")
+    inputs: dict = Field(default_factory=dict, description="Workflow input variables")
+    caller: dict = Field(..., description="Caller identity (tenant_id, app_id, user_id)")
+
+
+class WorkflowRunInnerResponse(BaseModel):
+    workflow_run_id: str | None = None
+    status: str = "succeeded"
+    data: dict = Field(default_factory=dict)
+
+
+class WorkflowRunInnerHttpError(BaseHTTPException):
+    error_code = "workflow_run_inner_failed"
+    description = "Workflow execution failed."
+    code = 500
+
+    def __init__(self, *, error_code: str | None = None, description: str | None = None, status_code: int | None = None):
+        if error_code is not None:
+            self.error_code = error_code
+        if description is not None:
+            self.description = description
+        if status_code is not None:
+            self.code = status_code
+        super().__init__(self.description)
+
+
+@inner_api_ns.route("/workflows/run")
+class WorkflowRunInnerApi(Resource):
+    """Execute a Dify workflow through the inner API."""
+
+    @agent_inner_api_only
+    @inner_api_ns.doc("inner_workflow_run")
+    @with_session
+    def post(self, session: Session) -> dict:
+        try:
+            payload = WorkflowRunInnerRequest.model_validate(request.get_json(silent=True) or {})
+        except ValidationError as exc:
+            raise WorkflowRunInnerHttpError(
+                error_code="invalid_request",
+                description=str(exc),
+                status_code=400,
+            ) from exc
+
+        # Look up the workflow app
+        app_model = session.get(App, payload.app_id)
+        if not app_model:
+            raise WorkflowRunInnerHttpError(
+                error_code="app_not_found",
+                description=f"App {payload.app_id} not found",
+                status_code=404,
+            )
+
+        app_mode = AppMode.value_of(app_model.mode)
+        if app_mode != AppMode.WORKFLOW:
+            raise WorkflowRunInnerHttpError(
+                error_code="not_workflow_app",
+                description=f"App {payload.app_id} is not a workflow app (mode={app_model.mode})",
+                status_code=400,
+            )
+
+        # Create or find an end user for the caller
+        caller = payload.caller
+        end_user_id = caller.get("user_id", "uloo-inner")
+        end_user = session.get(EndUser, end_user_id)
+        if not end_user:
+            end_user = EndUser(
+                id=end_user_id,
+                tenant_id=caller.get("tenant_id", app_model.tenant_id),
+                app_id=payload.app_id,
+                type="browser",
+                session_id="uloo-inner",
+            )
+            session.add(end_user)
+            session.flush()
+
+        args = {
+            "inputs": payload.inputs,
+            "query": "",
+            "streaming": False,
+        }
+
+        try:
+            response = AppGenerateService.generate(
+                session=session,
+                app_model=app_model,
+                user=end_user,
+                args=args,
+                invoke_from=InvokeFrom.SERVICE_API,
+                streaming=False,
+            )
+            # Extract outputs from the response
+            if hasattr(response, "data"):
+                outputs = response.data.get("outputs", {}) if isinstance(response.data, dict) else {}
+                workflow_run_id = response.data.get("workflow_run_id") if isinstance(response.data, dict) else None
+            else:
+                outputs = {}
+                workflow_run_id = None
+
+            return WorkflowRunInnerResponse(
+                workflow_run_id=workflow_run_id,
+                data={"outputs": outputs},
+            ).model_dump(mode="json")
+        except Exception as exc:
+            logger.exception("inner workflow run failed: app_id=%s", payload.app_id)
+            raise WorkflowRunInnerHttpError(
+                error_code="workflow_execution_failed",
+                description=str(exc),
+                status_code=500,
+            ) from exc

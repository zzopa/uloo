+  const entries: [string, string, string][] = [
+    ['模型', buildIntegrationPath('provider'), '在 Dify 配置供应商、凭据和可用模型。'],
+    ['工具与插件', buildIntegrationPath('builtin'), '使用 Dify 的工具与插件管理。'],
+    ['MCP 服务', buildIntegrationPath('mcp'), '在 Dify 管理连接、授权与工具同步。'],
+    ['API 工具', buildIntegrationPath('custom-tool'), '在 Dify 配置自定义 API 工具。'],
+    ['工作流工具', buildIntegrationPath('workflow-tool'), '将固定操作流程封装为团队可调用的工具。'],
+    ['知识库', '/datasets', '使用 Dify 知识库和索引配置。'],

+'use client'
+
+import { useQuery } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import { consoleQuery } from '@/service/client'
+import { UlooPageHeading } from '../shared/page-heading'
+import { UlooPreviewBanner } from '../shared/preview-banner'
+
+const PREVIEW_CHECKS = [
+  ['database', true],
+  ['agno', true],
+  ['model_config', false],
+  ['team_run', false],
+  ['sse_streaming', false],
+  ['memory', false],
+  ['studio_plugin', false],
+] as const
+
+export function UlooRuntimePage({ preview = false }: { preview?: boolean }) {
+  const { t } = useTranslation('uloo')
+  const readiness = useQuery({
+    ...consoleQuery.uloo.health.ready.get.queryOptions(),
+    enabled: !preview,
+    retry: 1,
+  })
+  const capabilities = useQuery({
+    ...consoleQuery.uloo.capabilities.get.queryOptions(),
+    enabled: !preview,
+    retry: 1,
+  })
+  const checks = preview ? PREVIEW_CHECKS : Object.entries(readiness.data?.checks ?? {})
+
+  return (
+    <div className="space-y-6">
+      <UlooPageHeading
+        title={t(($) => $.runtime)}
+        description={t(($) => $.runtimePageHint)}
+        icon="i-ri-server-line"
+        badge={
+          !preview && readiness.data ? (
+            <span
+              className={`rounded-md px-2 py-1 text-[11px] font-semibold ${readiness.data.status === 'ready' ? 'text-components-badge-status-light-success-text bg-components-badge-status-light-success-bg' : 'text-components-badge-status-light-warning-text bg-components-badge-status-light-warning-bg'}`}
+            >
+              {readiness.data.status}
+            </span>
+          ) : undefined
+        }
+        actions={preview ? <UlooPreviewBanner /> : undefined}
+      />
+      {!preview && readiness.isError && (
+        <section className="border-components-badge-status-light-error-border text-components-badge-status-light-error-text rounded-xl border bg-components-badge-status-light-error-bg p-4 text-sm">
+          {t(($) => $.coreUnavailableDetail)}
+        </section>
+      )}
+      <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
+        {(checks.length ? checks : PREVIEW_CHECKS.map(([key]) => [key, false] as const)).map(
+          ([key, value]) => (
+            <article
+              key={key}
+              className="rounded-2xl border border-components-panel-border bg-background-default p-5 shadow-xs"
+            >
+              <div className="flex items-center justify-between">
+                <div className="flex size-10 items-center justify-center rounded-xl bg-background-section-burn text-text-secondary">
+                  <span
+                    className={
+                      value
+                        ? 'text-components-badge-status-light-success-text i-ri-checkbox-circle-line'
+                        : 'text-components-badge-status-light-warning-text i-ri-error-warning-line'
+                    }
+                  />
+                </div>
+                <span
+                  className={`rounded-md px-2 py-1 text-[10px] font-semibold ${value ? 'text-components-badge-status-light-success-text bg-components-badge-status-light-success-bg' : 'text-components-badge-status-light-warning-text bg-components-badge-status-light-warning-bg'}`}
+                >
+                  {value ? t(($) => $.available) : t(($) => $.unavailable)}
+                </span>
+              </div>
+              <h2 className="mt-4 font-mono text-sm font-semibold text-text-primary">{key}</h2>
+              <p className="mt-2 text-xs leading-5 text-text-tertiary">
+                {value ? t(($) => $.connected) : t(($) => $.truthfulUnavailableTitle)}
+              </p>
+            </article>
+          ),
+        )}
+      </section>
+      <section className="rounded-2xl border border-components-panel-border bg-background-default p-5">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <div>
+            <h2 className="text-sm font-semibold text-text-primary">{t(($) => $.capabilities)}</h2>
+            <p className="mt-1 text-xs text-text-tertiary">{t(($) => $.capabilitiesHint)}</p>
+          </div>
+          <span className="font-mono text-xs text-text-tertiary">
+            {preview ? 'preview' : (capabilities.data?.version ?? '—')}
+          </span>
+        </div>
+        <div className="mt-4 flex flex-wrap gap-2">

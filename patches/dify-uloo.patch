+import { Form } from '@langgenius/dify-ui/form'
+import { Textarea } from '@langgenius/dify-ui/textarea'
+import { toast } from '@langgenius/dify-ui/toast'
+import { useMutation } from '@tanstack/react-query'
+import { useQuery } from '@tanstack/react-query'
+import { useMemo, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { consoleQuery } from '@/service/client'
+import { UlooToolPicker } from '../tools/picker'
+import { UlooDatasetPicker } from './dataset-picker'
+import { UlooWorkflowPicker } from './workflow-picker'
+import { getUlooErrorInfo } from './error'
+
+type AgentFormValues = {
+  key: string
+  name: string
+  description: string
+  role: string
+  modelRef: string
+  instructions: string
+  knowledgeRefs: string
+  outputSchema: string
+}
+
+type UlooAgentFormDialogProps = {
+  agent?: UlooAgentResponse
+  open: boolean
+  preview?: boolean
+  onPreviewSave?: (body: UlooAgentCreatePayload) => void
+  onOpenChange: (open: boolean) => void
+  onSaved: () => void
+}
+
+function splitReferences(value: string) {
+  return value
+    .split(/[\n,]/)
+    .map((item) => item.trim())
+    .filter(Boolean)
+}
+
+function parseOutputSchema(value: string): Record<string, unknown> | undefined {
+  const trimmed = value.trim()
+  if (!trimmed) return undefined
+
+  const parsed: unknown = JSON.parse(trimmed)
+  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed))
+    throw new Error('OUTPUT_SCHEMA_NOT_OBJECT')
+
+  return parsed as Record<string, unknown>
+}
+
+function UlooAgentForm({
+  agent,
+  preview,
+  onPreviewSave,
+  onClose,
+  onSaved,
+}: {
+  agent?: UlooAgentResponse
+  preview?: boolean
+  onPreviewSave?: (body: UlooAgentCreatePayload) => void
+  onClose: () => void
+  onSaved: () => void
+}) {
+  const { t } = useTranslation('uloo')
+  const [skillRefs, setSkillRefs] = useState(agent?.skill_refs ?? [])
+  const [toolRefs, setToolRefs] = useState(agent?.tool_refs ?? [])
+  const [knowledgeRefs, setKnowledgeRefs] = useState(agent?.knowledge_refs ?? [])
+  const [workflowRefs, setWorkflowRefs] = useState(agent?.workflow_refs ?? [])
+  const [enabled, setEnabled] = useState(agent?.enabled ?? true)
+  const [formError, setFormError] = useState<string>()
+  const createAgent = useMutation(consoleQuery.uloo.agents.post.mutationOptions())
+  const updateAgent = useMutation(consoleQuery.uloo.agents.byAgentId.patch.mutationOptions())
+  // Model picker: read the configured provider/model catalog from capabilities
+  // so the user picks from what the server actually configured (S1-2). Falls back
+  // to a free-text input when the catalog is empty (preview mode or no provider).
+  // Also fetches Dify workspace models via the BFF endpoint and merges them.
+  const capabilities = useQuery({
+    ...consoleQuery.uloo.capabilities.get.queryOptions(),
+    enabled: !preview,
+    retry: false,
+  })
+  const difyModels = useQuery({
+    queryKey: ['uloo-dify-models'],
+    queryFn: async () => {
+      const res = await fetch('/console/api/uloo/dify-models')
+      if (!res.ok) return { models: [] as { model_ref: string; label: string }[] }
+      return res.json() as Promise<{ models: { model_ref: string; label: string; provider_label: string }[] }>
+    },
+    enabled: !preview,
+    retry: false,
+  })
+  const modelOptions = useMemo(() => {
+    const models = capabilities.data?.models ?? {}
+    const opts: { value: string; label: string }[] = []
+    const seen = new Set<string>()
+    // 1. Core .env-configured models
+    for (const [provider, info] of Object.entries(models)) {
+      const ids = (info?.models ?? []) as string[]
+      if (!ids.length) {
+        const ref = `${provider}:`
+        if (!seen.has(ref)) {
+          seen.add(ref)
+          opts.push({ value: ref, label: `${provider} (provider only)` })
+        }
+      }
+      for (const modelId of ids) {
+        const ref = `${provider}:${modelId}`
+        if (!seen.has(ref)) {
+          seen.add(ref)
+          opts.push({ value: ref, label: `${modelId} · ${provider}` })
+        }
+      }
+    }
+    // 2. Dify workspace models
+    for (const m of difyModels.data?.models ?? []) {
+      if (m.model_ref && !seen.has(m.model_ref)) {
+        seen.add(m.model_ref)
+        opts.push({ value: m.model_ref, label: `${m.label} · ${m.provider_label ?? 'Dify'}` })
+      }
+    }
+    return opts
+  }, [capabilities.data?.models, difyModels.data])
+  const pending = createAgent.isPending || updateAgent.isPending
+
+  function handleSubmit(values: AgentFormValues) {
+    if (pending) return
+
+    setFormError(undefined)
+    let outputSchema: Record<string, unknown> | undefined
+    try {
+      outputSchema = parseOutputSchema(values.outputSchema)
+    } catch {
+      setFormError(t(($) => $.outputSchemaInvalid))
+      return
+    }
+
+    const common = {
+      name: values.name.trim(),
+      description: values.description.trim() || null,
+      role: values.role.trim(),
+      instructions: values.instructions
+        .split('\n')
+        .map((item) => item.trim())
+        .filter(Boolean),
+      model_ref: values.modelRef.trim(),
+      tool_refs: toolRefs,
+      skill_refs: skillRefs,
+      knowledge_refs: knowledgeRefs,
+      workflow_refs: workflowRefs,
+      output_schema: outputSchema ?? null,
+      enabled,
+    }
+
+    const onSuccess = () => {
+      toast.success(agent ? t(($) => $.agentUpdated) : t(($) => $.agentCreated))
+      onSaved()
+      onClose()
+    }
+    const onError = (error: unknown) => {
+      const info = getUlooErrorInfo(error)
+      const correlation = info.traceId || info.requestId
+      setFormError(
+        correlation ? `${info.message} · ${t(($) => $.traceId)} ${correlation}` : info.message,
+      )
+    }
+
+    if (preview) {
+      const body = {
+        ...common,
+        key: agent?.key ?? values.key.trim(),
+      } satisfies UlooAgentCreatePayload
+      onPreviewSave?.(body)
+      onSuccess()
+      return
+    }
+
+    if (agent) {
+      const body = {
+        ...common,
+        expected_version: agent.version,
+      } satisfies UlooAgentUpdatePayload
+      updateAgent.mutate({ params: { agent_id: agent.id }, body }, { onSuccess, onError })
+      return
+    }
+
+    const body = {
+      ...common,
+      key: values.key.trim(),
+    } satisfies UlooAgentCreatePayload
+    createAgent.mutate({ body }, { onSuccess, onError })
+  }
+
+  return (
+    <Form<AgentFormValues> className="flex min-h-0 flex-1 flex-col" onFormSubmit={handleSubmit}>
+      <div className="grid min-h-0 flex-1 gap-4 overflow-y-auto px-6 py-5 sm:grid-cols-2">
+        <Field name="name" className="gap-1.5">
+          <FieldLabel className="system-xs-medium-uppercase text-text-tertiary">
+            {t(($) => $.agentName)}
+          </FieldLabel>
+          <FieldControl required maxLength={256} defaultValue={agent?.name ?? ''} />
+          <FieldError match="valueMissing">{t(($) => $.fieldRequired)}</FieldError>
+        </Field>
+        <Field name="key" className="gap-1.5">
+          <FieldLabel className="system-xs-medium-uppercase text-text-tertiary">
+            {t(($) => $.agentKey)}
+          </FieldLabel>
+          <FieldControl
+            required
+            readOnly={Boolean(agent)}
+            pattern="[A-Za-z0-9][A-Za-z0-9._-]*"
+            maxLength={128}
+            defaultValue={agent?.key ?? ''}
+          />
+          <FieldError match="valueMissing">{t(($) => $.fieldRequired)}</FieldError>
+          <FieldError match="patternMismatch">{t(($) => $.agentKeyInvalid)}</FieldError>
+        </Field>
+        <Field name="role" className="gap-1.5 sm:col-span-2">
+          <FieldLabel className="system-xs-medium-uppercase text-text-tertiary">
+            {t(($) => $.agentRole)}
+          </FieldLabel>
+          <FieldControl required maxLength={256} defaultValue={agent?.role ?? ''} />
+          <FieldError match="valueMissing">{t(($) => $.fieldRequired)}</FieldError>
+        </Field>
+        <Field name="description" className="gap-1.5 sm:col-span-2">
+          <FieldLabel className="system-xs-medium-uppercase text-text-tertiary">
+            {t(($) => $.description)}
+          </FieldLabel>
+          <Textarea className="min-h-20" defaultValue={agent?.description ?? ''} />
+        </Field>
+        <Field name="modelRef" className="gap-1.5 sm:col-span-2">
+          <FieldLabel className="system-xs-medium-uppercase text-text-tertiary">
+            {t(($) => $.modelReference)}
+          </FieldLabel>
+          {modelOptions.length ? (
+            <select
+              name="modelRef"
+              required
+              defaultValue={agent?.model_ref ?? modelOptions[0]?.value ?? 'deepseek:DeepSeek-V3.1'}
+              className="h-9 w-full rounded-lg border border-components-panel-border bg-background-default px-3 text-sm text-text-primary focus-visible:ring-2 focus-visible:ring-components-button-primary-bg focus-visible:outline-none"
+            >
+              {modelOptions.map((opt) => (
+                <option key={opt.value} value={opt.value}>
+                  {opt.label}
+                </option>
+              ))}
+              {/* keep the saved value selectable even if it's no longer in the catalog */}
+              {agent?.model_ref && !modelOptions.some((o) => o.value === agent.model_ref) && (
+                <option value={agent.model_ref}>
+                  {agent.model_ref} · {t(($) => $.modelReferenceSaved)}
+                </option>
+              )}
+            </select>
+          ) : (
+            <FieldControl
+              required
+              maxLength={256}
+              defaultValue={agent?.model_ref ?? 'deepseek:DeepSeek-V3.1'}
+              placeholder="deepseek:DeepSeek-V3.1"
+            />
+          )}
+          <FieldError match="valueMissing">{t(($) => $.fieldRequired)}</FieldError>
+          <div className="text-xs text-text-tertiary">{t(($) => $.modelReferenceHint)}</div>
+        </Field>
+        <Field name="instructions" className="gap-1.5 sm:col-span-2">
+          <FieldLabel className="system-xs-medium-uppercase text-text-tertiary">
+            {t(($) => $.promptInstructions)}
+          </FieldLabel>
+          <Textarea
+            className="min-h-24"
+            defaultValue={agent?.instructions.join('\n') ?? ''}
+            placeholder={t(($) => $.oneInstructionPerLine)}
+          />
+        </Field>
+        <UlooToolPicker selected={toolRefs} onChange={setToolRefs} preview={preview} />
+        <UlooToolPicker kind="skills" selected={skillRefs} onChange={setSkillRefs} preview={preview} />
+        <UlooDatasetPicker selected={knowledgeRefs} onChange={setKnowledgeRefs} preview={preview} />
+        <UlooWorkflowPicker selected={workflowRefs} onChange={setWorkflowRefs} preview={preview} />
+        <Field name="outputSchema" className="gap-1.5 sm:col-span-2">
+          <FieldLabel className="system-xs-medium-uppercase text-text-tertiary">
+            {t(($) => $.outputSchema)}
+          </FieldLabel>
+          <Textarea
+            className="min-h-24 font-mono text-xs"
+            defaultValue={agent?.output_schema ? JSON.stringify(agent.output_schema, null, 2) : ''}
+            placeholder={'{\n  "type": "object"\n}'}
+          />
+        </Field>
+        <label className="flex items-center gap-3 sm:col-span-2">
+          <input
+            type="checkbox"
+            checked={enabled}
+            onChange={(event) => setEnabled(event.currentTarget.checked)}
+            className="size-4 accent-components-checkbox-bg"
+          />
+          <span className="text-sm font-medium text-text-secondary">{t(($) => $.enabled)}</span>
+        </label>
+        {formError && (
+          <div className="border-components-badge-status-light-error-border text-components-badge-status-light-error-text rounded-lg border bg-components-badge-status-light-error-bg px-3 py-2 text-sm sm:col-span-2">
+            {formError}
+          </div>
+        )}
+        {preview && (
+          <div className="border-components-badge-status-light-info-border bg-components-badge-status-light-info-bg text-components-badge-status-light-info-text rounded-lg border px-3 py-2 text-sm sm:col-span-2">
+            {t(($) => $.previewSaveHint)}
+          </div>
+        )}
+      </div>
+      <div className="flex shrink-0 justify-end gap-2 border-t border-divider-subtle px-6 py-4">
+        <Button type="button" variant="secondary" disabled={pending} onClick={onClose}>
+          {t(($) => $.cancel)}
+        </Button>
+        <Button type="submit" variant="primary" loading={pending}>
+          {agent ? t(($) => $.save) : t(($) => $.createAgent)}
+        </Button>
+      </div>
+    </Form>
+  )
+}
+
+export function UlooAgentFormDialog({
+  agent,
+  open,
+  preview,
+  onPreviewSave,
+  onOpenChange,
+  onSaved,
+}: UlooAgentFormDialogProps) {
+  const { t } = useTranslation('uloo')
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange} disablePointerDismissal>
+      <DialogContent className="flex max-h-[calc(100dvh-2rem)] w-[720px] max-w-[calc(100vw-2rem)] flex-col overflow-hidden p-0!">
+        <DialogCloseButton />
+        <div className="shrink-0 border-b border-divider-subtle px-6 py-5 pr-14">
+          <DialogTitle className="title-2xl-semi-bold text-text-primary">
+            {agent ? t(($) => $.editAgent) : t(($) => $.createAgent)}
+          </DialogTitle>
+          <DialogDescription className="mt-1 text-sm text-text-tertiary">
+            {t(($) => $.agentFormHint)}
+          </DialogDescription>
+        </div>
+        <UlooAgentForm
+          key={`${agent?.id ?? 'new'}-${agent?.version ?? 0}-${open}`}
+          agent={agent}
+          preview={preview}
+          onPreviewSave={onPreviewSave}
+          onClose={() => onOpenChange(false)}
+          onSaved={onSaved}
+        />
+      </DialogContent>
+    </Dialog>
+  )
+}

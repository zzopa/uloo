+++ b/web/features/uloo/dashboard.tsx
@@ -0,0 +1,321 @@
+// AI生成
+'use client'
+
+import type {
+  UlooTasksDetailResponse,
+  UlooTasksPageResponse,
+  UlooTTeamsPageResponse,
+} from '@dify/contracts/api/console/uloo/types.gen'
+import { Button } from '@langgenius/dify-ui/button'
+import { toast } from '@langgenius/dify-ui/toast'
+import { useMutation, useQuery } from '@tanstack/react-query'
+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import Link from '@/next/link'
+import { useRouter } from '@/next/navigation'
+import { consoleQuery } from '@/service/client'
+import { getUlooErrorInfo } from './agents/error'
+import { ULOO_PREVIEW_TASKS } from './preview-tasks'
+import { createUlooRoutes } from './routes'
+
+type TeamOption = {
+  id: string
+  name: string
+}
+
+const STATUS_TONE: Record<string, string> = {
+  succeeded:
+    'bg-components-badge-status-light-success-bg text-components-badge-status-light-success-text',
+  running:
+    'bg-components-badge-status-light-warning-bg text-components-badge-status-light-warning-text',
+  failed: 'bg-components-badge-status-light-error-bg text-components-badge-status-light-error-text',
+  cancelled: 'bg-background-section-burn text-text-tertiary',
+}
+
+export function UlooDashboard({ preview = false }: { preview?: boolean }) {
+  const { t } = useTranslation('uloo')
+  const router = useRouter()
+  const routes = createUlooRoutes(preview)
+  const [query, setQuery] = useState('')
+  const [constraints, setConstraints] = useState('')
+
+  const teamsQuery = useQuery({
+    ...consoleQuery.uloo.teams.get.queryOptions({
+      input: { query: { enabled: true, limit: 100 } },
+    }),
+    enabled: !preview,
+    retry: 1,
+  })
+  const tasksQuery = useQuery({
+    ...consoleQuery.uloo.tasks.get.queryOptions({
+      input: { query: { limit: 6 } },
+    }),
+    enabled: !preview,
+    retry: 1,
+  })
+
+  const createTask = useMutation(consoleQuery.uloo.tasks.post.mutationOptions())
+  const planTask = useMutation(consoleQuery.uloo.tasks.byTaskId.plan.post.mutationOptions())
+
+  const teamsData = teamsQuery.data as UlooTTeamsPageResponse | undefined
+  const tasksData = tasksQuery.data as UlooTasksPageResponse | undefined
+  const teams = (teamsData?.items ?? []) as unknown as TeamOption[]
+  const tasks = tasksData?.items ?? []
+  const examples = [
+    { icon: 'i-ri-search-line', label: t(($) => $.exampleCompetitor) },
+    { icon: 'i-ri-lightbulb-flash-line', label: t(($) => $.exampleProposal) },
+    { icon: 'i-ri-bar-chart-2-line', label: t(($) => $.exampleReport) },
+    { icon: 'i-ri-price-tag-3-line', label: t(($) => $.examplePriceResearch) },
+  ]
+
+  function statusLabel(status: string) {
+    if (status === 'draft') return t(($) => $.taskStatusDraft)
+    if (status === 'planning') return t(($) => $.taskStatusPlanning)
+    if (status === 'awaiting_approval') return t(($) => $.taskStatusAwaitingApproval)
+    if (status === 'running') return t(($) => $.taskStatusRunning)
+    if (status === 'succeeded') return t(($) => $.taskStatusSucceeded)
+    if (status === 'failed') return t(($) => $.taskStatusFailed)
+    if (status === 'cancelled') return t(($) => $.taskStatusCancelled)
+    return status
+  }
+
+  const recentTasks = preview ? ULOO_PREVIEW_TASKS : tasks
+
+  function submitTask(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault()
+    const trimmed = query.trim()
+    if (!trimmed) {
+      toast.error(t(($) => $.taskRequired))
+      return
+    }
+    if (preview) {
+      toast.success(t(($) => $.previewTaskCreated))
+      router.push(routes.task('demo-new'))
+      return
+    }
+    const title = (trimmed.split('\n')[0] ?? '').slice(0, 120)
+    const teamId = String(new FormData(event.currentTarget).get('team_id') ?? '') || undefined
+    const trimmedConstraints = constraints.trim() || undefined
+    createTask.mutate(
+      { body: { title, query: trimmed, team_id: teamId, constraints: trimmedConstraints } },
+      {
+        onSuccess: (task) => {
+          const createdTask = task as UlooTasksDetailResponse
+          toast.success(t(($) => $.taskCreated))
+          planTask.mutate(
+            { params: { task_id: createdTask.id }, body: {} },
+            {
+              onSuccess: () => router.push(routes.task(createdTask.id)),
+              onError: (error) => {
+                toast.error(getUlooErrorInfo(error).message)
+                router.push(routes.task(createdTask.id))
+              },
+            },
+          )
+        },
+        onError: (error) => {
+          toast.error(getUlooErrorInfo(error).message || t(($) => $.taskCreateFailed))
+        },
+      },
+    )
+  }
+
+  return (
+    <div className="space-y-7">
+      <ol className="grid grid-cols-2 gap-3 sm:grid-cols-4">
+        {[
+          { label: t(($) => $.flowTaskEntry), icon: 'i-ri-chat-new-line' },
+          { label: t(($) => $.flowTeamPlan), icon: 'i-ri-route-line' },
+          { label: t(($) => $.flowAgentRun), icon: 'i-ri-team-line' },
+          { label: t(($) => $.flowDelivery), icon: 'i-ri-file-check-line' },
+        ].map((step, index) => (
+          <li
+            key={step.label}
+            className="flex items-center gap-3 rounded-xl border border-divider-subtle bg-background-default px-4 py-3"
+          >
+            <span className={`${step.icon} shrink-0 text-lg text-text-accent`} aria-hidden="true" />
+            <span className="text-xs font-medium text-text-secondary">{step.label}</span>
+            <span className="ml-auto font-mono text-[10px] text-text-quaternary">0{index + 1}</span>
+          </li>
+        ))}
+      </ol>
+      <section className="overflow-hidden rounded-2xl border border-components-panel-border bg-background-default shadow-sm">
+        <div className="relative overflow-hidden px-5 py-8 sm:px-8 sm:py-10 lg:px-12 lg:py-12">
+          <div className="absolute -top-24 right-0 size-80 rounded-full bg-util-colors-blue-blue-500 opacity-10 blur-3xl" />
+          <div className="relative">
+            {preview && (
+              <div className="border-components-badge-status-light-warning-border text-components-badge-status-light-warning-text mb-3 inline-flex items-center gap-2 rounded-full border bg-components-badge-status-light-warning-bg px-3 py-1 text-xs font-medium">
+                <span className="i-ri-flask-line" />
+                {t(($) => $.previewMode)}
+              </div>
+            )}
+            <h1 className="max-w-3xl text-[30px] leading-tight font-semibold tracking-tight text-text-primary sm:text-4xl">
+              {t(($) => $.taskHeroTitle)}
+            </h1>
+            <p className="mt-2 max-w-2xl text-sm leading-6 text-text-secondary">
+              {t(($) => $.taskHeroHint)}
+            </p>
+
+            <form onSubmit={submitTask} className="mt-8 space-y-4">
+              <div className="overflow-hidden rounded-2xl border border-components-panel-border bg-background-default shadow-sm focus-within:border-components-input-border-active focus-within:ring-2 focus-within:ring-state-accent-active">
+                <textarea
+                  value={query}
+                  onChange={(event) => setQuery(event.target.value)}
+                  rows={4}
+                  placeholder={t(($) => $.taskInputPlaceholder)}
+                  aria-label={t(($) => $.taskHeroTitle)}
+                  className="block w-full resize-y bg-transparent px-5 py-4 text-base leading-7 text-text-primary outline-none placeholder:text-text-tertiary"
+                />
+                <div className="flex flex-wrap items-center justify-between gap-3 border-t border-divider-subtle bg-background-default-subtle px-5 py-3">
+                  <span className="text-[11px] text-text-tertiary">
+                    {t(($) => $.taskInputHint)}
+                  </span>
+                  <Button
+                    type="submit"
+                    variant="primary"
+                    size="small"
+                    loading={!preview && (createTask.isPending || planTask.isPending)}
+                  >
+                    {preview || (!createTask.isPending && !planTask.isPending)
+                      ? t(($) => $.planTask)
+                      : t(($) => $.planningTask)}
+                  </Button>
+                </div>
+              </div>
+
+              <div className="flex flex-col gap-3 sm:flex-row sm:items-center">
+                <label className="flex min-w-0 flex-1 items-center gap-2 rounded-lg border border-components-panel-border bg-background-default px-3 py-2">
+                  <span className="i-ri-team-line text-base text-text-tertiary" />
+                  <span className="shrink-0 text-xs font-medium text-text-secondary">
+                    {t(($) => $.teams)}
+                  </span>
+                  <select
+                    name="team_id"
+                    disabled={preview}
+                    className="min-w-0 flex-1 bg-transparent text-xs text-text-secondary outline-none"
+                  >
+                    <option value="">{t(($) => $.autoSelectTeam)}</option>
+                    {teams.map((team) => (
+                      <option key={team.id as string} value={team.id as string}>
+                        {team.name as string}
+                      </option>
+                    ))}
+                  </select>
+                </label>
+              </div>
+
+              <div className="rounded-lg border border-components-panel-border bg-background-default">
+                <div className="flex items-center gap-2 px-3 py-2">
+                  <span className="i-ri-list-check-2 text-base text-text-tertiary" />
+                  <span className="text-xs font-medium text-text-secondary">
+                    {t(($) => $.taskConstraintsLabel)}
+                  </span>
+                  <span className="ml-auto text-[10px] text-text-quaternary">
+                    {t(($) => $.taskConstraintsHint)}
+                  </span>
+                </div>
+                <textarea
+                  value={constraints}
+                  onChange={(event) => setConstraints(event.target.value)}
+                  rows={2}
+                  placeholder={t(($) => $.taskConstraintsPlaceholder)}
+                  aria-label={t(($) => $.taskConstraintsLabel)}
+                  className="block w-full resize-y border-t border-divider-subtle bg-transparent px-3 py-2 text-xs leading-5 text-text-secondary outline-none placeholder:text-text-tertiary"
+                />
+              </div>
+            </form>
+
+            <div className="mt-6">
+              <div className="mb-2 text-xs font-medium text-text-tertiary">
+                {t(($) => $.exampleTasks)}
+              </div>
+              <div className="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
+                {examples.map((example) => (
+                  <button
+                    key={example.label}
+                    type="button"
+                    onClick={() => setQuery(example.label)}
+                    className="flex items-start gap-3 rounded-xl border border-divider-subtle bg-background-default px-4 py-3 text-left transition hover:border-components-panel-border-subtle hover:bg-state-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2"

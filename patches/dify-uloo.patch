diff --git a/web/next.config.ts b/web/next.config.ts
index 011a842e7d605a760e6a6612466bbdcd0c612004..638f08d0764a7ca01dec3e49c531b70b38ffbb85 100644
--- a/web/next.config.ts
+++ b/web/next.config.ts
@@ -9,16 +9,70 @@ const allowedDevOrigins = process.env.NEXT_ALLOWED_DEV_ORIGINS?.split(',')
   .map((origin) => origin.trim())
   .filter(Boolean)
 
+// Turbopack allocates outside the V8 heap, so Node's --max-old-space-size does
+// not constrain it: on 2026-09-21 a `next dev` from this checkout committed
+// 26183368704 bytes and exhausted Windows commit charge, taking Docker and an
+// IDE down with it.
+//
+// experimental.turbopackMemoryLimit alone was measured to be insufficient. It
+// bounds the main process, but Turbopack runs every compilation task that needs
+// a Node runtime (a webpack-style loader such as code-inspector-plugin) in its
+// own helper process: a full Dify compile spawned 42 of them at roughly 500 MB
+// each, and RSS still climbed past 21 GB, none of it governed by that limit.
+// turbopackPluginRuntimeStrategy selects how those helpers are hosted. Sharing
+// one process through worker threads does bound the total (measured: 2 processes,
+// 5 GB), but that strategy is broken in this Next version - see below.
+//
+// Turbopack options are omitted unless a ULOO_* variable is set.
+const ulooTurbopackMemoryLimitMB = Number(process.env.ULOO_TURBOPACK_MEMORY_LIMIT_MB ?? 0)
+const ulooPluginRuntime = process.env.ULOO_TURBOPACK_PLUGIN_RUNTIME
+const ulooPluginRuntimeStrategy: 'workerThreads' | 'childProcesses' | undefined =
+  ulooPluginRuntime === 'workerThreads' || ulooPluginRuntime === 'childProcesses'
+    ? ulooPluginRuntime
+    : undefined
+
+const ulooExperimental = {
+  // Keep cold production builds from exhausting this Windows development host.
+  webpackMemoryOptimizations: true,
+  webpackBuildWorker: true,
+  cpus: 2,
+  ...(ulooTurbopackMemoryLimitMB > 0
+    ? { turbopackMemoryLimit: ulooTurbopackMemoryLimitMB * 1024 * 1024 }
+    : {}),
+  ...(ulooPluginRuntimeStrategy
+    ? { turbopackPluginRuntimeStrategy: ulooPluginRuntimeStrategy }
+    : {}),
+}
+
+// code-inspector-plugin rewrites modules so that clicking an element in the
+// browser jumps to its source file. Turbopack runs anything that needs a Node
+// runtime through its own helper processes, one per concurrent task: with this
+// plugin active a full Dify compile spawned 42 helpers at roughly 500 MB each
+// and next-dev RSS passed 21 GB, while turbopackMemoryLimit never engaged
+// because it only governs the main process. Hosting those helpers in worker
+// threads would fix it but is broken in Next 16.2.12 (ERR_SOCKET_BAD_PORT from
+// turbopack-node/child_process createIpc), so the lever left is to not need
+// them. The plugin is a Dify developer convenience rather than product
+// behaviour; ULOO disables it by default through ULOO_CODE_INSPECTOR=off, and
+// an unset variable keeps upstream behaviour.
+const ulooCodeInspector = process.env.ULOO_CODE_INSPECTOR !== 'off'
+
 const nextConfig: NextConfig = {
   basePath: env.NEXT_PUBLIC_BASE_PATH,
+  devIndicators: false,
   ...(allowedDevOrigins?.length ? { allowedDevOrigins } : {}),
   transpilePackages: ['@t3-oss/env-core', '@t3-oss/env-nextjs', 'echarts', 'zrender'],
   serverExternalPackages: ['loro-crdt'],
-  turbopack: {
-    rules: codeInspectorPlugin({
-      bundler: 'turbopack',
-    }),
-  },
+  ...(ulooCodeInspector
+    ? {
+        turbopack: {
+          rules: codeInspectorPlugin({
+            bundler: 'turbopack',
+          }),
+        },

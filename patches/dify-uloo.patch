+# AI生成
+"""ULOO model catalog: surface Dify workspace LLM models for the agent selector.
+
+The agent editor needs a list of available LLM models so the user can pick
+``provider:model_id`` from a dropdown instead of typing ``model_ref`` by hand.
+This service reads the Dify workspace model configuration (the same source the
+Dify LLM node uses) and returns a flat, UI-friendly list.  Credentials and
+base URLs are **never** returned to the browser.
+"""
+
+import logging
+
+from graphon.model_runtime.entities.model_entities import ModelType
+from services.model_provider_service import ModelProviderService
+
+logger = logging.getLogger(__name__)
+
+
+def list_uloo_model_catalog(tenant_id: str) -> dict:
+    """Return LLM models configured in the Dify workspace.
+
+    Structure::
+
+        {
+          "providers": [
+            {"provider": "langgenius/deepseek/deepseek", "label": "DeepSeek", "status": "active"},
+            ...
+          ],
+          "models": [
+            {
+              "provider": "langgenius/deepseek/deepseek",
+              "provider_label": "DeepSeek",
+              "model": "deepseek-chat",
+              "label": "DeepSeek-V3",
+              "model_type": "llm",
+              "status": "active",
+              "model_ref": "langgenius/deepseek/deepseek:deepseek-chat"
+            },
+            ...
+          ],
+          "default_model": "langgenius/deepseek/deepseek:deepseek-chat" | null
+        }
+    """
+    service = ModelProviderService()
+    providers_out: list[dict] = []
+    models_out: list[dict] = []
+
+    try:
+        provider_list = service.get_provider_list(tenant_id=tenant_id, model_type=ModelType.LLM)
+    except Exception:
+        logger.warning("Cannot load ULOO model catalog for tenant %s", tenant_id, exc_info=True)
+        return {"providers": [], "models": [], "default_model": None}
+
+    for provider in provider_list:
+        provider_id = provider.provider
+        provider_label = provider.label.zh_Hans if provider.label else provider_id
+        providers_out.append(
+            {
+                "provider": provider_id,
+                "label": provider_label,
+                "status": provider.status,
+            }
+        )
+        for model in provider.models or []:
+            if model.model_type != ModelType.LLM:
+                continue
+            model_label = model.label.zh_Hans if model.label else model.model
+            models_out.append(
+                {
+                    "provider": provider_id,
+                    "provider_label": provider_label,
+                    "model": model.model,
+                    "label": model_label,
+                    "model_type": model.model_type.value,
+                    "status": model.status,
+                    "model_ref": f"{provider_id}:{model.model}",
+                }
+            )
+
+    default_ref: str | None = None
+    try:
+        default_model = service.get_default_model_of_model_type(
+            tenant_id=tenant_id, model_type=ModelType.LLM
+        )
+        if default_model and default_model.provider and default_model.model:
+            default_ref = f"{default_model.provider}:{default_model.model}"
+    except Exception:
+        logger.debug("No default LLM model for tenant %s", tenant_id, exc_info=True)
+
+    return {"providers": providers_out, "models": models_out, "default_model": default_ref}

index 0000000000000000000000000000000000000000..f83cdc287ad245fae7f60f21477f0199c1c70aa2
--- /dev/null
+++ b/api/extensions/storage/local_storage.py
@@ -0,0 +1,70 @@
+"""Pure Python local filesystem storage.
+
+This backend intentionally avoids OpenDAL so source development also works on
+Windows hosts where application-control policies block native extension DLLs.
+"""
+
+from collections.abc import Generator
+from pathlib import Path
+from shutil import copyfile
+from typing import override
+
+from extensions.storage.base_storage import BaseStorage
+
+
+class LocalStorage(BaseStorage):
+    """Store files below one configured directory without allowing traversal."""
+
+    def __init__(self, root: str):
+        self.root = Path(root).expanduser().resolve()
+        self.root.mkdir(parents=True, exist_ok=True)
+
+    def _resolve(self, filename: str) -> Path:
+        target = (self.root / filename).resolve()
+        if target != self.root and self.root not in target.parents:
+            raise ValueError("storage path escapes the configured local root")
+        return target
+
+    @override
+    def save(self, filename: str, data: bytes):
+        target = self._resolve(filename)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(data)
+
+    @override
+    def load_once(self, filename: str) -> bytes:
+        return self._resolve(filename).read_bytes()
+
+    @override
+    def load_stream(self, filename: str) -> Generator[bytes, None, None]:
+        with self._resolve(filename).open("rb") as source:
+            while chunk := source.read(64 * 1024):
+                yield chunk
+
+    @override
+    def download(self, filename: str, target_filepath: str) -> None:
+        target = Path(target_filepath)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        copyfile(self._resolve(filename), target)
+
+    @override
+    def exists(self, filename: str) -> bool:
+        return self._resolve(filename).is_file()
+
+    @override
+    def delete(self, filename: str):
+        target = self._resolve(filename)
+        if target.exists():
+            target.unlink()
+
+    @override
+    def scan(self, path: str, files: bool = True, directories: bool = False) -> list[str]:
+        base = self._resolve(path)
+        if not base.exists():
+            return []
+
+        matches: list[str] = []
+        for item in base.rglob("*"):
+            if (item.is_file() and files) or (item.is_dir() and directories):
+                matches.append(item.relative_to(self.root).as_posix())
+        return sorted(matches)

+from pydantic import Field, PositiveFloat
+from pydantic_settings import BaseSettings
+
+
+class UlooConfig(BaseSettings):
+    """
+    Configuration settings for the ULOO Core integration.
+
+    ULOO Core is the Agent / Team / Run / Event / Memory service that the ULOO
+    console pages and the ``ULOO / Agno Team`` agent strategy talk to. It is only
+    ever reached through the same-origin console BFF, never directly from the
+    browser.
+    """
+
+    ULOO_CORE_URL: str = Field(
+        description="Base URL of the ULOO Core API, e.g. http://localhost:8200.",
+        default="http://localhost:8200",
+    )
+
+    ULOO_CORE_API_TOKEN: str | None = Field(
+        description=(
+            "Service-to-service credential injected by the console BFF into upstream "
+            "requests. Must never be returned to the browser."
+        ),
+        default=None,
+    )
+
+    ULOO_PROXY_CONNECT_TIMEOUT_SECONDS: PositiveFloat = Field(
+        description="Connect timeout when the BFF opens an upstream request.",
+        default=10,
+    )
+
+    ULOO_PROXY_READ_TIMEOUT_SECONDS: PositiveFloat = Field(
+        description=(
+            "Read timeout between two upstream chunks. Applies to streaming SSE "
+            "responses as well, so it must exceed the slowest gap between events."
+        ),
+        default=600,
+    )

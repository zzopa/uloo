+  await userEvent.click(await screen.findByRole('button', { name: 'uloo.editResource' }))
+  await userEvent.clear(screen.getByRole('spinbutton'))
+  await userEvent.type(screen.getByRole('spinbutton'), '3')
+  await userEvent.click(screen.getByRole('checkbox', { name: 'uloo.enabled' }))
+  await userEvent.click(screen.getByRole('button', { name: 'uloo.save' }))

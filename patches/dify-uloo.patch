+  mount(<UlooToolPicker selected={['legacy-tool']} onChange={vi.fn()} />)
+  await waitFor(() => expect(screen.getByRole('alert')).toHaveTextContent('uloo.toolCatalogError'))
+  expect(screen.getByRole('checkbox', { name: /legacy-tool/ })).toBeChecked()

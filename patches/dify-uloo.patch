+export function UlooPageHeading({
+  title,
+  description,
+  icon,
+  backHref,
+  backLabel,
+  badge,
+  actions,
+}: {
+  title: string
+  description?: string
+  icon: string
+  backHref?: string
+  backLabel?: string
+  badge?: ReactNode
+  actions?: ReactNode
+}) {
+  return (
+    <header className="flex flex-col gap-4 border-b border-divider-subtle pb-6 sm:flex-row sm:items-start sm:justify-between">

@@ -0,0 +1,56 @@
+import inspect
+import json
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+from flask import Flask
+
+from controllers.console.uloo_proxy import uloo_import_tool
+
+
+@pytest.mark.parametrize(("body", "status"), [("{", 400), ("[]", 400), ('{"key":"missing"}', 404)])
+def test_import_rejects_invalid_or_foreign_tool_keys(body, status):
+    app = Flask(__name__)
+    with (
+        app.test_request_context(
+            "/console/api/uloo/dify-tools/import", method="POST", data=body, content_type="application/json"
+        ),
+        patch(
+            "controllers.console.uloo_proxy.current_account_with_tenant",
+            return_value=(SimpleNamespace(id="account"), "workspace"),
+        ),
+        patch("services.uloo_tool_catalog.list_uloo_tool_catalog", return_value={"tools": [], "unavailable": []}),
+    ):
+        response = inspect.unwrap(uloo_import_tool)()
+    assert response.status_code == status
+
+
+def test_import_uses_server_schema_and_current_workspace():
+    item = {
+        "key": "dify-search",
+        "name": "Search",
+        "description": "Search",
+        "enabled": True,
+        "config": {"tool_type": "dify", "tool_schema": {"type": "object"}},
+    }
+    app = Flask(__name__)
+    with (
+        app.test_request_context(
+            "/console/api/uloo/dify-tools/import",
+            method="POST",
+            json={"key": "dify-search", "config": {"secret": "browser-value"}},
+        ),
+        patch(
+            "controllers.console.uloo_proxy.current_account_with_tenant",
+            return_value=(SimpleNamespace(id="account"), "workspace"),
+        ),
+        patch(
+            "services.uloo_tool_catalog.list_uloo_tool_catalog", return_value={"tools": [item], "unavailable": []}
+        ) as catalog,
+        patch("controllers.console.uloo_proxy._proxy_request") as proxy,
+    ):
+        inspect.unwrap(uloo_import_tool)()
+    catalog.assert_called_once_with("account", "workspace")
+    assert proxy.call_args.args == ("tools", "workspace")
+    assert json.loads(proxy.call_args.kwargs["body"]) == item
diff --git a/api/tests/unit_tests/services/test_uloo_tool_catalog.py b/api/tests/unit_tests/services/test_uloo_tool_catalog.py
new file mode 100644
index 0000000000000000000000000000000000000000..13c40b47c367fe1a65df931bf66334c3f7dc3533
--- /dev/null
+++ b/api/tests/unit_tests/services/test_uloo_tool_catalog.py
@@ -0,0 +1,66 @@
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from core.tools.entities.tool_entities import ToolProviderType
+from services.uloo_tool_catalog import list_uloo_tool_catalog
+
+
+def test_catalog_exports_only_tool_metadata_and_native_schema():
+    provider = SimpleNamespace(
+        type=ToolProviderType.BUILT_IN,
+        id="provider",
+        name="provider",
+        label=SimpleNamespace(zh_Hans="工具"),
+        original_credentials={"key": "secret"},
+    )
+    tool = MagicMock()
+    tool.entity.identity.name = "search"
+    tool.entity.identity.label.zh_Hans = "搜索"
+    tool.entity.description.llm = "Search"
+    tool.entity.parameters = []
+    tool.get_llm_parameters_json_schema.return_value = {"type": "object", "properties": {}}
+    controller = MagicMock()
+    controller.get_tools.return_value = [tool]
+    with (
+        patch(
+            "services.uloo_tool_catalog.ToolManager.list_providers_from_api",
+            side_effect=lambda u, t, kind: [provider] if kind == "builtin" else [],
+        ) as providers,
+        patch("services.uloo_tool_catalog.ToolManager.get_builtin_provider", return_value=controller),
+    ):
+        catalog = list_uloo_tool_catalog("account", "workspace")
+    assert providers.call_count == 4
+    assert all(call.args[:2] == ("account", "workspace") for call in providers.call_args_list)
+    assert len(catalog["tools"]) == 1
+    assert catalog["tools"][0]["config"]["tool_schema"] == {"type": "object", "properties": {}}
+    assert "secret" not in str(catalog)
+    assert "original_credentials" not in str(catalog)
+
+
+def test_failed_provider_does_not_leak_errors_or_hide_other_providers():
+    provider = SimpleNamespace(type=ToolProviderType.MCP, id="bad", name="bad", server_identifier="bad-server")
+    with (
+        patch(
+            "services.uloo_tool_catalog.ToolManager.list_providers_from_api",
+            side_effect=lambda u, t, kind: [provider] if kind == "mcp" else [],
+        ),
+        patch(
+            "services.uloo_tool_catalog.ToolManager.get_mcp_provider_controller", side_effect=ValueError("secret-url")
+        ),
+    ):
+        catalog = list_uloo_tool_catalog("account", "workspace")
+    assert catalog["tools"] == []
+    assert len(catalog["unavailable"]) == 1
+    assert "secret-url" not in str(catalog)
+
+
+def test_failed_category_does_not_block_other_categories():
+    def providers(user, tenant, category):
+        if category == "builtin":
+            raise ValueError("secret-plugin-url")
+        return []
+    with patch("services.uloo_tool_catalog.ToolManager.list_providers_from_api", side_effect=providers):
+        catalog = list_uloo_tool_catalog("account", "workspace")
+    assert len(catalog["unavailable"]) == 1
+    assert catalog["unavailable"][0]["provider_name"] == "builtin"
+    assert "secret-plugin-url" not in str(catalog)

index 0000000000000000000000000000000000000000..a0dc9b23f345c3d5afc84294b3a281ec9f642c82
--- /dev/null
+++ b/api/services/uloo_model_sync.py
@@ -0,0 +1,98 @@
+# AI生成
+"""Sync Dify workspace model provider credentials to ULOO Core.
+
+This eliminates the need for .env configuration (S1-3). The BFF reads
+model provider credentials from the Dify workspace and pushes them to
+Core's ``PUT /api/v1/models/config`` endpoint.
+"""
+
+import logging
+
+import httpx
+from graphon.model_runtime.entities.model_entities import ModelType
+from services.model_provider_service import ModelProviderService
+
+from configs import dify_config
+
+logger = logging.getLogger(__name__)
+
+
+def sync_model_config_to_core(tenant_id: str) -> dict:
+    """Extract Dify workspace model credentials and push them to ULOO Core.
+
+    Returns a summary dict with ``synced_providers`` and ``total_models``.
+    On failure, returns ``{"error": "..."}``  without raising.
+    """
+    service = ModelProviderService()
+    providers_payload: list[dict] = []
+    aliases: dict[str, str] = {}
+
+    try:
+        provider_list = service.get_provider_list(tenant_id=tenant_id, model_type=ModelType.LLM)
+    except Exception:
+        logger.warning("Cannot list model providers for tenant %s", tenant_id, exc_info=True)
+        return {"error": "cannot_list_providers"}
+
+    for provider in provider_list:
+        provider_id = provider.provider
+        if provider.status != "active":
+            continue
+
+        # Extract credentials
+        try:
+            creds = service.get_provider_credential(tenant_id=tenant_id, provider=provider_id)
+        except Exception:
+            logger.debug("No credentials for provider %s", provider_id, exc_info=True)
+            continue
+        if not creds:
+            continue
+
+        # Map common credential field names
+        api_key = creds.get("api_key") or creds.get("API_KEY") or ""
+        base_url = creds.get("base_url") or creds.get("openai_api_base") or ""
+        if not api_key:
+            continue
+
+        # Collect model IDs
+        model_ids = []
+        for model in provider.models or []:
+            if model.model_type == ModelType.LLM and model.status == "active":
+                model_ids.append(model.model)
+
+        # Use the last path segment as the ULOO provider name (e.g.
+        # "langgenius/deepseek/deepseek" → "deepseek")
+        short_name = provider_id.rsplit("/", 1)[-1] if "/" in provider_id else provider_id
+        aliases[provider_id] = short_name
+
+        providers_payload.append(
+            {
+                "provider": short_name,
+                "base_url": base_url,
+                "api_key": api_key,
+                "model_ids": model_ids,
+            }
+        )
+
+    if not providers_payload:
+        return {"synced_providers": [], "total_models": 0}
+
+    # Push to Core
+    core_url = f"{dify_config.ULOO_CORE_URL}/api/v1/models/config"
+    try:
+        resp = httpx.put(
+            core_url,
+            json={"providers": providers_payload, "aliases": aliases},
+            headers={
+                "X-ULOO-Workspace": tenant_id,
+                "X-ULOO-Service-Credential": dify_config.ULOO_SERVICE_CREDENTIAL,
+                "Content-Type": "application/json",
+            },
+            timeout=10.0,
+        )
+        if resp.status_code == 200:
+            return resp.json()
+        logger.warning("Core rejected model config sync: %s %s", resp.status_code, resp.text[:200])
+        return {"error": f"core_rejected_{resp.status_code}"}
+    except Exception:
+        logger.warning("Cannot sync model config to Core at %s", core_url, exc_info=True)
+        return {"error": "core_unreachable"}

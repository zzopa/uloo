+            {t(($) => $.toolsCount, { count: agent.tool_refs.length })}
+          </span>
+          <span className="rounded-md border border-divider-subtle px-2 py-1 text-[11px] text-text-tertiary">
+            {t(($) => $.knowledgeCount, { count: agent.knowledge_refs.length })}
+          </span>
+        </div>
+      </div>
+      <div className="flex items-center gap-1 border-t border-divider-subtle px-2 py-2">
+        <Button size="small" variant="ghost" className="gap-1" onClick={onDebug}>
+          <span className="i-ri-chat-3-line" />
+          {t(($) => $.debug)}
+        </Button>
+        <Button size="small" variant="ghost" className="gap-1" onClick={onEdit}>
+          <span className="i-ri-edit-line" />
+          {t(($) => $.edit)}
+        </Button>
+        <Button
+          size="small"
+          variant="ghost"
+          className="gap-1"
+          disabled={validateAgent.isPending}
+          onClick={validate}
+        >
+          <span className="i-ri-shield-check-line" />
+          {t(($) => $.validate)}
+        </Button>
+        <div className="flex-1" />
+        <button
+          type="button"
+          aria-label={agent.enabled ? t(($) => $.disableAgent) : t(($) => $.enableAgent)}
+          disabled={updateAgent.isPending}

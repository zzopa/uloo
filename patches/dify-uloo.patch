+          {taskRuns.isLoading && <p className="mt-3 text-xs text-text-tertiary" role="status">{t(($) => $.loadingRuns)}</p>}
+          {taskRuns.isError && <p className="mt-3 text-xs text-text-tertiary" role="alert">{t(($) => $.runsUnavailable)}</p>}
+          {taskRuns.data?.items.length === 0 && (
+            <div className="mt-3 rounded-lg border border-dashed border-divider-subtle px-4 py-6 text-center">
+              <div className="text-xs text-text-tertiary">{t(($) => $.noRunsYet)}</div>
+            </div>
+          )}
+          <div className="mt-3 space-y-2">
+            {taskRuns.data?.items.map(run => (
+              <Link key={run.id} href={routes.run(run.id)} className="block rounded-lg border border-divider-subtle px-3 py-2 text-xs text-text-accent hover:bg-state-base-hover">
+                {formatTime(run.created_at)} · {run.status} · {t(($) => $.viewRunDetail)}
+              </Link>
+            ))}
+          </div>
+        </section>
+
+        {/* 问题 */}
+        <section className="rounded-2xl border border-components-panel-border bg-background-default p-5">
+          <h2 className="text-sm font-semibold text-text-primary">{t(($) => $.detailSectionIssues)}</h2>
+          {plans.length > 0 && plans[0].questions.length > 0 ? (
+            <div className="mt-3">
+              <div className="text-xs font-medium text-text-secondary">{t(($) => $.planQuestionsLabel)}</div>
+              <ul className="mt-1 list-disc space-y-1 pl-4 text-xs text-text-tertiary">
+                {plans[0].questions.map((question, index) => (
+                  <li key={index}>{question}</li>
+                ))}
+              </ul>
+            </div>
+          ) : (
+            <div className="mt-3 rounded-lg border border-dashed border-divider-subtle px-4 py-6 text-center">
+              <div className="text-xs text-text-tertiary">{t(($) => $.noIssues)}</div>
+            </div>
+          )}
+          {plans.length > 0 && plans[0].assumptions.length > 0 && (
+            <div className="mt-3">
+              <div className="text-xs font-medium text-text-secondary">{t(($) => $.planAssumptions)}</div>
+              <ul className="mt-1 list-disc space-y-1 pl-4 text-xs text-text-tertiary">
+                {plans[0].assumptions.map((assumption, index) => (
+                  <li key={index}>{assumption}</li>
+                ))}
+              </ul>
+            </div>
+          )}
+        </section>
+      </div>
+    </div>
+  )
+}

+              <button
+                key={value}
+                type="button"
+                onClick={() => setTab(value)}
+                className={`rounded-md px-4 py-2 text-xs font-semibold ${tab === value ? 'bg-background-default text-text-primary shadow-xs' : 'text-text-tertiary'}`}

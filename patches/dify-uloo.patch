diff --git a/web/features/uloo/tools/picker.tsx b/web/features/uloo/tools/picker.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..38059332f36c7403463972f78ff6014a6e93465a
--- /dev/null
+++ b/web/features/uloo/tools/picker.tsx
@@ -0,0 +1,137 @@
+// AI生成
+'use client'
+
+import type { ResourceKind } from './library'
+import { Checkbox } from '@langgenius/dify-ui/checkbox'
+import { useQuery, useMutation } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import { resourceQuery } from './library'
+
+type DifyTool = {
+  key: string
+  name: string
+  description: string
+  enabled: boolean
+  unavailable_reason?: string
+  provider_type?: string
+  category?: string
+}
+
+export function UlooToolPicker({
+  selected,
+  onChange,
+  preview = false,
+  kind = 'tools',
+}: {
+  selected: string[]
+  onChange: (refs: string[]) => void
+  preview?: boolean
+  kind?: ResourceKind
+}) {
+  const { t } = useTranslation('uloo')
+  const catalog = useQuery({
+    ...resourceQuery(kind),
+    enabled: !preview,
+    retry: false,
+  })
+  // S1-4: Also fetch Dify workspace tools so the user can select them directly
+  // without going to a separate import page.
+  const difyTools = useQuery({
+    queryKey: ['uloo-dify-tools-picker', kind],
+    queryFn: async () => {
+      const res = await fetch('/console/api/uloo/dify-tools')
+      if (!res.ok) return { tools: [] as DifyTool[] }
+      return res.json() as Promise<{ tools: DifyTool[] }>
+    },
+    enabled: !preview && kind === 'tools',
+    retry: false,
+  })
+  // Auto-import a Dify tool when the user selects it (S1-4)
+  const importTool = useMutation({
+    mutationFn: async (toolKey: string) => {
+      const res = await fetch('/console/api/uloo/dify-tools/import', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ key: toolKey }),
+      })
+      if (!res.ok) throw new Error('import failed')
+      return res.json()
+    },
+  })
+
+  const available = (catalog.data ?? []).filter((item) => item.enabled).map((item) => item.key)
+  // Merge imported tools with Dify tools that haven't been imported yet
+  const difyAvailable = (difyTools.data?.tools ?? []).filter((item) => item.enabled)
+  const importedKeys = new Set((catalog.data ?? []).map((item) => item.key))
+  const difyOnly = difyAvailable.filter((item) => !importedKeys.has(item.key))
+  const refs = [...new Set([...available, ...selected, ...difyOnly.map((item) => item.key)])]
+
+  function handleToggle(ref: string, checked: boolean) {
+    if (checked) {
+      // If it's a Dify-only tool, auto-import it first
+      const isDifyOnly = difyOnly.some((item) => item.key === ref)
+      if (isDifyOnly && !importTool.isPending) {
+        importTool.mutate(ref, {
+          onSuccess: () => {
+            onChange([...selected, ref])
+          },
+        })
+      } else {
+        onChange([...selected, ref])
+      }
+    } else {
+      onChange(selected.filter((item) => item !== ref))
+    }
+  }
+
+  function getToolInfo(ref: string): { name: string; description: string; isDify: boolean; category?: string } {
+    const imported = catalog.data?.find((item) => item.key === ref)
+    if (imported) return { name: imported.name, description: imported.description || '', isDify: false }
+    const dify = difyAvailable.find((item) => item.key === ref)
+    if (dify) return { name: dify.name, description: dify.description || '', isDify: true, category: dify.category }
+    return { name: ref, description: '', isDify: false }
+  }
+
+  return (
+    <fieldset className="space-y-2 rounded-xl border border-components-panel-border p-3 sm:col-span-2">
+      <legend className="px-1 text-sm font-medium">
+        {kind === 'tools' ? t(($) => $.toolLibrary) : t(($) => $.skillLibrary)}
+      </legend>
+      {catalog.isLoading && <p role="status">{t(($) => $.toolCatalogLoading)}</p>}
+      {catalog.isError && <p role="alert">{t(($) => $.toolCatalogError)}</p>}
+      {!catalog.isLoading && !catalog.isError && !refs.length && (
+        <p>{t(($) => $.noRegisteredTools)}</p>
+      )}
+      {refs.map((ref) => {
+        const info = getToolInfo(ref)
+        return (
+          <label key={ref} className="flex items-start gap-2 text-sm">
+            <Checkbox
+              checked={selected.includes(ref)}
+              onCheckedChange={(checked) => handleToggle(ref, checked === true)}
+            />
+            <span>
+              <span className="font-medium">
+                {info.name}
+                {info.isDify && (
+                  <span className="ml-1.5 rounded bg-components-badge-status-light-info-bg px-1.5 py-0.5 text-[10px] font-medium text-components-badge-status-light-info-text">
+                    {info.category ?? 'Dify'}
+                  </span>
+                )}
+              </span>
+              <span className="ml-2 font-mono text-xs text-text-tertiary">{ref}</span>
+              <span className="block text-xs text-text-tertiary">
+                {available.includes(ref)
+                  ? info.description || t(($) => $.available)
+                  : info.isDify
+                    ? info.description || t(($) => $.available)
+                    : t(($) => $.unregisteredTool)}
+              </span>
+            </span>
+          </label>
+        )
+      })}
+      <p className="text-xs text-text-tertiary">{t(($) => $.toolSelectionHint)}</p>
+    </fieldset>
+  )
+}

+import { UlooShell } from '@/features/uloo/shell'
+
+const navigation = vi.hoisted(() => ({ pathname: '/uloo' }))
+
+vi.mock('@/next/navigation', () => ({
+  usePathname: () => navigation.pathname,
+}))
+
+describe('UlooShell navigation', () => {
+  beforeEach(() => {
+    navigation.pathname = '/uloo'
+  })
+
+  it('keeps every preview navigation link inside the preview route tree', () => {
+    navigation.pathname = '/uloo-preview/tasks'
+    render(
+      <UlooShell preview>
+        <div>content</div>
+      </UlooShell>,
+    )
+
+    const links = screen.getAllByRole('link')
+    expect(links.length).toBeGreaterThan(0)
+    links.forEach((link) => {
+      expect(link).toHaveAttribute('href', expect.stringMatching(/^\/uloo-preview(?:\/|$)/))
+    })
+    screen.getAllByRole('link', { name: 'uloo.allTasks' }).forEach((link) => {
+      expect(link).toHaveAttribute('aria-current', 'page')
+    })
+  })
+
+  it('exposes the complete formal product navigation', () => {
+    navigation.pathname = '/uloo/integrations/settings'
+    render(
+      <UlooShell>
+        <div>content</div>
+      </UlooShell>,
+    )
+
+    expect(screen.getAllByRole('link', { name: 'uloo.newTask' })[0]).toHaveAttribute(
+      'href',
+      '/uloo',
+    )
+    expect(screen.getAllByRole('link', { name: 'uloo.navIntegration' })[0]).toHaveAttribute(
+      'aria-current',
+      'page',
+    )
+    expect(screen.getAllByRole('link', { name: 'uloo.navIntegration' })[0]).toHaveAttribute(
+      'href',
+      '/uloo/integrations/settings',
+    )
+    expect(screen.getAllByRole('link', { name: 'uloo.runtime' })[0]).toHaveAttribute(
+      'href',
+      '/uloo/runtime',
+    )
+    for (const name of ['uloo.runs', 'uloo.artifacts', 'uloo.memory', 'uloo.toolLibrary', 'uloo.studioIntegration'])
+      expect(screen.queryByRole('link', { name })).not.toBeInTheDocument()
+  })
+
+  it('keeps detail navigation in its parent module and provides a task-entry shortcut', () => {
+    navigation.pathname = '/uloo-preview/resources/agents/demo-agent'
+    render(
+      <UlooShell preview>
+        <div>detail</div>
+      </UlooShell>,
+    )
+    screen.getAllByRole('link', { name: 'uloo.agents' }).forEach((link) => {
+      expect(link).toHaveAttribute('aria-current', 'page')
+    })
+    screen.getAllByRole('link', { name: 'uloo.newTask' }).forEach((link) => {
+      expect(link).toHaveAttribute('href', '/uloo-preview')
+    })
+  })
+})

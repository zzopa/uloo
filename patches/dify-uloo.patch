@@ -0,0 +1,46 @@
+'use client'
+
+import { useTranslation } from 'react-i18next'
+
+export function UlooTaskStageTracker({ activeIndex }: { activeIndex: number }) {
+  const { t } = useTranslation('uloo')
+  const stages = [
+    { label: t(($) => $.flowTeamPlan), icon: 'i-ri-route-line' },
+    { label: t(($) => $.planReady), icon: 'i-ri-checkbox-circle-line' },
+    { label: t(($) => $.flowAgentRun), icon: 'i-ri-team-line' },
+    { label: t(($) => $.flowDelivery), icon: 'i-ri-file-check-line' },
+  ]
+
+  return (
+    <ol className="grid gap-2 rounded-2xl border border-components-panel-border bg-background-default p-3 sm:grid-cols-4">
+      {stages.map((stage, index) => {
+        const reached = index <= activeIndex
+        const current = index === activeIndex
+        return (
+          <li
+            key={stage.label}
+            aria-current={current ? 'step' : undefined}
+            className={`flex items-center gap-3 rounded-xl border px-3 py-3 ${current ? 'border-components-input-border-active bg-state-accent-hover shadow-xs' : 'border-transparent'} ${!reached ? 'bg-background-section-burn' : ''}`}
+          >
+            <span
+              className={`flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold ${reached ? 'bg-text-accent text-text-primary-on-surface' : 'bg-background-default text-text-tertiary'}`}
+            >
+              {index < activeIndex ? (
+                <span className="i-ri-check-line" />
+              ) : current ? (
+                <span className={stage.icon} />
+              ) : (
+                index + 1
+              )}
+            </span>
+            <span
+              className={`text-xs font-medium ${reached ? 'text-text-accent' : 'text-text-tertiary'}`}
+            >
+              {stage.label}
+            </span>
+          </li>
+        )
+      })}
+    </ol>
+  )
+}
diff --git a/web/features/uloo/tasks-list.tsx b/web/features/uloo/tasks-list.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b67715f0b7b1f1377069efe850277c5a23c510a6
--- /dev/null
+++ b/web/features/uloo/tasks-list.tsx
@@ -0,0 +1,162 @@
+'use client'
+
+import type { UlooTasksPageResponse } from '@dify/contracts/api/console/uloo/types.gen'
+import { useQuery } from '@tanstack/react-query'
+import { useTranslation } from 'react-i18next'
+import Link from '@/next/link'
+import { consoleQuery } from '@/service/client'
+import { ULOO_PREVIEW_TASKS } from './preview-tasks'
+import { createUlooRoutes } from './routes'
+import { UlooPageHeading } from './shared/page-heading'
+import { UlooPreviewBanner } from './shared/preview-banner'
+
+type TaskListItem = {
+  id: string
+  title: string
+  query: string
+  status: string
+  created_at?: string | null
+}
+
+const STATUS_TONE: Record<string, string> = {
+  succeeded:
+    'bg-components-badge-status-light-success-bg text-components-badge-status-light-success-text',
+  running:
+    'bg-components-badge-status-light-warning-bg text-components-badge-status-light-warning-text',
+  planning:
+    'bg-components-badge-status-light-warning-bg text-components-badge-status-light-warning-text',
+  awaiting_approval:
+    'bg-components-badge-status-light-info-bg text-components-badge-status-light-info-text',
+  failed: 'bg-components-badge-status-light-error-bg text-components-badge-status-light-error-text',
+  cancelled: 'bg-background-section-burn text-text-tertiary',
+}
+
+function formatTime(value: string | undefined | null) {
+  if (!value) return '—'
+  const date = new Date(value)
+  if (Number.isNaN(date.getTime())) return '—'
+  return date.toLocaleString()
+}
+
+export function UlooTasksList({ preview = false }: { preview?: boolean }) {
+  const { t } = useTranslation('uloo')
+  const routes = createUlooRoutes(preview)
+  const tasksQuery = useQuery({
+    ...consoleQuery.uloo.tasks.get.queryOptions({
+      input: { query: { limit: 50 } },
+    }),
+    enabled: !preview,
+    retry: 1,
+  })
+
+  const tasksData = tasksQuery.data as UlooTasksPageResponse | undefined
+  const tasks: TaskListItem[] = preview ? ULOO_PREVIEW_TASKS : (tasksData?.items ?? [])
+
+  function statusLabel(status: string) {
+    switch (status) {
+      case 'draft':
+        return t(($) => $.taskStatusDraft)
+      case 'planning':
+        return t(($) => $.taskStatusPlanning)
+      case 'awaiting_approval':
+        return t(($) => $.taskStatusAwaitingApproval)
+      case 'running':
+        return t(($) => $.taskStatusRunning)
+      case 'succeeded':
+        return t(($) => $.taskStatusSucceeded)
+      case 'failed':
+        return t(($) => $.taskStatusFailed)
+      case 'cancelled':
+        return t(($) => $.taskStatusCancelled)
+      default:
+        return status
+    }
+  }
+
+  return (
+    <div className="space-y-5">
+      <UlooPageHeading
+        title={t(($) => $.allTasks)}
+        description={t(($) => $.recentTasksHint)}
+        icon="i-ri-file-list-3-line"
+        actions={
+          <Link
+            href={routes.root}
+            className="rounded-lg border border-components-button-secondary-border px-3 py-1.5 text-xs font-medium text-components-button-secondary-text hover:bg-state-base-hover"
+          >
+            {t(($) => $.newTask)}
+          </Link>
+        }
+      />
+
+      {preview && <UlooPreviewBanner />}
+      {!preview && tasksQuery.isLoading ? (
+        <div className="h-64 animate-pulse rounded-xl bg-background-section-burn" />
+      ) : !preview && tasksQuery.isError ? (
+        <div className="rounded-xl border border-components-panel-border bg-background-default p-4 text-xs text-text-secondary">
+          {t(($) => $.coreUnavailableDetail)}
+        </div>
+      ) : tasks.length === 0 ? (
+        <div className="rounded-xl border border-dashed border-divider-subtle bg-background-default px-6 py-12 text-center">
+          <div className="mx-auto i-ri-file-list-3-line text-2xl text-text-quaternary" />
+          <div className="mt-3 text-sm font-medium text-text-secondary">
+            {t(($) => $.noRecentTasks)}
+          </div>
+          <div className="mt-1 text-xs text-text-tertiary">{t(($) => $.noRecentTasksHint)}</div>
+          <Link
+            href={routes.root}
+            className="mt-4 inline-block rounded-lg border border-components-button-secondary-border px-3 py-1.5 text-xs font-medium text-components-button-secondary-text hover:bg-state-base-hover"
+          >
+            {t(($) => $.newTask)}
+          </Link>
+        </div>
+      ) : (
+        <div className="overflow-hidden rounded-xl border border-components-panel-border bg-background-default">
+          <table className="w-full text-left text-sm">
+            <thead>
+              <tr className="border-b border-divider-subtle text-xs text-text-tertiary">
+                <th className="px-4 py-3 font-medium">{t(($) => $.taskDetailTitle)}</th>
+                <th className="hidden px-4 py-3 font-medium sm:table-cell">
+                  {t(($) => $.taskStatusRunning)}
+                </th>
+                <th className="hidden px-4 py-3 font-medium md:table-cell">{t(($) => $.taskId)}</th>
+                <th className="px-4 py-3 text-right font-medium">{t(($) => $.taskCreatedAt)}</th>
+              </tr>
+            </thead>
+            <tbody>
+              {tasks.map((task) => (
+                <tr
+                  key={task.id}
+                  className="border-b border-divider-subtle last:border-b-0 hover:bg-state-base-hover"
+                >
+                  <td className="max-w-0 px-4 py-3">
+                    <Link
+                      href={routes.task(task.id)}
+                      className="block truncate font-medium text-text-primary hover:text-text-accent"
+                    >
+                      {task.title}
+                    </Link>
+                    <div className="mt-0.5 truncate text-xs text-text-tertiary">{task.query}</div>
+                  </td>
+                  <td className="hidden px-4 py-3 sm:table-cell">
+                    <span
+                      className={`rounded-md px-2 py-1 text-[11px] font-semibold ${STATUS_TONE[task.status] ?? 'bg-background-section-burn text-text-tertiary'}`}
+                    >
+                      {statusLabel(task.status)}
+                    </span>
+                  </td>
+                  <td className="hidden px-4 py-3 font-mono text-xs text-text-tertiary md:table-cell">
+                    {task.id}
+                  </td>
+                  <td className="px-4 py-3 text-right text-xs text-text-tertiary">
+                    {formatTime(task.created_at)}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+    </div>
+  )
+}

+}
diff --git a/web/features/uloo/agents/error.ts b/web/features/uloo/agents/error.ts
new file mode 100644
index 0000000000000000000000000000000000000000..688708971ec5934bdcc412e0e5930b9065ad7ab3
--- /dev/null
+++ b/web/features/uloo/agents/error.ts
@@ -0,0 +1,47 @@
+export type UlooErrorInfo = {
+  code?: string
+  message: string
+  requestId?: string
+  traceId?: string
+}
+
+function asRecord(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === 'object' && value !== null
+    ? (value as Record<string, unknown>)
+    : undefined
+}
+
+function readString(record: Record<string, unknown>, ...keys: string[]) {
+  for (const key of keys) {
+    const value = record[key]
+    if (typeof value === 'string' && value) return value
+  }
+}
+
+export function getUlooErrorInfo(error: unknown): UlooErrorInfo {
+  const queue: unknown[] = [error]
+  const visited = new Set<unknown>()
+
+  while (queue.length) {
+    const candidate = queue.shift()
+    if (visited.has(candidate)) continue
+    visited.add(candidate)
+
+    const record = asRecord(candidate)
+    if (!record) continue
+
+    const message = readString(record, 'message')
+    const code = readString(record, 'code')
+    const requestId = readString(record, 'request_id', 'requestId')
+    const traceId = readString(record, 'trace_id', 'traceId')
+    if (message && (code || requestId || traceId)) return { code, message, requestId, traceId }
+
+    for (const key of ['data', 'body', 'cause', 'error']) {
+      if (record[key] !== undefined) queue.push(record[key])
+    }
+  }
+
+  return {
+    message: error instanceof Error ? error.message : 'ULOO request failed',
+  }
+}

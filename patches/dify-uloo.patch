index 0000000000000000000000000000000000000000..8dc683ec60786a9b89c370a6886cf0753d530b2c
--- /dev/null
+++ b/web/features/uloo/agents/agent-debug-dialog.tsx
@@ -0,0 +1,249 @@
+'use client'
+
+import type {
+  UlooAgentResponse,
+  UlooAgentTestRunResponse,
+} from '@dify/contracts/api/console/uloo/types.gen'
+import { Button } from '@langgenius/dify-ui/button'
+import {
+  Dialog,
+  DialogCloseButton,
+  DialogContent,
+  DialogDescription,
+  DialogTitle,
+} from '@langgenius/dify-ui/dialog'
+import { Textarea } from '@langgenius/dify-ui/textarea'
+import { useMutation } from '@tanstack/react-query'
+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { consoleQuery } from '@/service/client'
+import { getUlooErrorInfo } from './error'
+
+type DebugMessage = {
+  id: string
+  role: 'user' | 'agent'
+  content: string
+  simulated?: boolean
+  result?: UlooAgentTestRunResponse
+}
+
+type UlooAgentDebugDialogProps = {
+  agent?: UlooAgentResponse
+  open: boolean
+  preview?: boolean
+  onOpenChange: (open: boolean) => void
+}
+
+function resultText(result: UlooAgentTestRunResponse) {
+  if (result.error) return result.error
+  if (!result.output) return ''
+
+  const content = result.output.content
+  if (typeof content === 'string') return content
+  const response = result.output.response
+  if (typeof response === 'string') return response
+  return JSON.stringify(result.output, null, 2)
+}
+
+function usageText(usage: Record<string, number>) {
+  return Object.entries(usage)
+    .map(([key, value]) => `${key}: ${value}`)
+    .join(' · ')
+}
+
+function UlooAgentDebugSession({
+  agent,
+  preview,
+}: {
+  agent: UlooAgentResponse
+  preview?: boolean
+}) {
+  const { t } = useTranslation('uloo')
+  const [prompt, setPrompt] = useState('')
+  const [messages, setMessages] = useState<DebugMessage[]>([])
+  const [requestError, setRequestError] = useState<string>()
+  const testRun = useMutation(consoleQuery.uloo.agents.byAgentId.testRuns.post.mutationOptions())
+
+  function appendAgentResult(result: UlooAgentTestRunResponse) {
+    setMessages((current) => [
+      ...current,
+      {
+        id: crypto.randomUUID(),
+        role: 'agent',
+        content: resultText(result) || t(($) => $.debugEmptyResponse),
+        result,
+      },
+    ])
+  }
+
+  function submit() {
+    const submittedPrompt = prompt.trim()
+    if (!submittedPrompt || testRun.isPending || !agent.enabled) return
+
+    setRequestError(undefined)
+    setPrompt('')
+    setMessages((current) => [
+      ...current,
+      { id: crypto.randomUUID(), role: 'user', content: submittedPrompt },
+    ])
+
+    if (preview) {
+      setMessages((current) => [
+        ...current,
+        {
+          id: crypto.randomUUID(),
+          role: 'agent',
+          simulated: true,
+          content: t(($) => $.demoDebugResponse, {
+            name: agent.name,
+            role: agent.role,
+            prompt: submittedPrompt,
+          }),
+        },
+      ])
+      return
+    }
+
+    testRun.mutate(
+      { params: { agent_id: agent.id }, body: { prompt: submittedPrompt } },
+      {
+        onSuccess: appendAgentResult,
+        onError: (error) => {
+          const info = getUlooErrorInfo(error)
+          const correlation = info.traceId || info.requestId
+          setRequestError(
+            correlation ? `${info.message} · ${t(($) => $.traceId)} ${correlation}` : info.message,
+          )
+        },
+      },
+    )
+  }
+
+  return (
+    <div className="flex min-h-0 flex-1 flex-col">
+      <div className="min-h-0 flex-1 space-y-4 overflow-y-auto bg-background-section px-6 py-5">
+        <div className="flex justify-center">
+          <span
+            className={`rounded-full border px-3 py-1 text-xs font-medium ${preview ? 'border-components-badge-status-light-warning-border text-components-badge-status-light-warning-text bg-components-badge-status-light-warning-bg' : 'border-components-badge-status-light-success-border text-components-badge-status-light-success-text bg-components-badge-status-light-success-bg'}`}
+          >
+            {preview ? t(($) => $.demoConversation) : t(($) => $.realAgnoConversation)}
+          </span>
+        </div>
+
+        {messages.length === 0 && (
+          <div className="flex min-h-64 flex-col items-center justify-center text-center">
+            <div className="flex size-12 items-center justify-center rounded-2xl bg-background-default text-text-accent shadow-xs">
+              <span className="i-ri-chat-3-line text-xl" />
+            </div>
+            <h3 className="mt-4 text-base font-semibold text-text-primary">
+              {t(($) => $.debugStartTitle, { name: agent.name })}
+            </h3>
+            <p className="mt-1 max-w-md text-sm leading-5 text-text-tertiary">
+              {preview ? t(($) => $.demoDebugHint) : t(($) => $.realDebugHint)}
+            </p>
+          </div>
+        )}
+
+        {messages.map((message) => (
+          <div
+            key={message.id}
+            className={`flex ${message.role === 'user' ? 'justify-end' : 'justify-start'}`}
+          >
+            <div
+              className={`max-w-[85%] rounded-2xl px-4 py-3 text-sm leading-6 ${message.role === 'user' ? 'bg-components-button-primary-bg text-text-primary-on-surface' : 'border border-components-panel-border bg-background-default text-text-secondary shadow-xs'}`}
+            >
+              {message.simulated && (
+                <div className="text-components-badge-status-light-warning-text mb-2 text-xs font-semibold">
+                  {t(($) => $.simulatedResponseLabel)}
+                </div>
+              )}
+              <div className="break-words whitespace-pre-wrap">{message.content}</div>
+              {message.result && (
+                <div className="mt-3 space-y-1 border-t border-divider-subtle pt-2 font-mono text-[11px] text-text-quaternary">
+                  {message.result.run_id && <div>Run ID: {message.result.run_id}</div>}
+                  {message.result.trace_id && <div>Trace ID: {message.result.trace_id}</div>}
+                  {message.result.usage && <div>{usageText(message.result.usage)}</div>}
+                  <div>
+                    {message.result.runtime_type} · {message.result.status}
+                  </div>
+                </div>
+              )}
+            </div>
+          </div>
+        ))}
+      </div>
+
+      <div className="shrink-0 border-t border-divider-subtle bg-background-default px-6 py-4">
+        {!agent.enabled && (
+          <div className="text-components-badge-status-light-warning-text mb-3 rounded-lg bg-components-badge-status-light-warning-bg px-3 py-2 text-sm">
+            {t(($) => $.debugDisabledHint)}
+          </div>
+        )}
+        {requestError && (
+          <div className="border-components-badge-status-light-error-border text-components-badge-status-light-error-text mb-3 rounded-lg border bg-components-badge-status-light-error-bg px-3 py-2 text-sm">
+            {requestError}
+          </div>
+        )}
+        <Textarea
+          aria-label={t(($) => $.debugPrompt)}
+          className="min-h-24 resize-none"
+          disabled={!agent.enabled || testRun.isPending}
+          maxLength={20000}
+          placeholder={t(($) => $.debugPlaceholder)}
+          value={prompt}
+          onValueChange={setPrompt}
+          onKeyDown={(event) => {
+            if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
+              event.preventDefault()
+              submit()
+            }
+          }}
+        />
+        <div className="mt-3 flex items-center justify-between gap-3">
+          <span className="text-xs text-text-quaternary">{t(($) => $.debugShortcut)}</span>
+          <Button
+            variant="primary"
+            className="gap-1"
+            disabled={!prompt.trim() || !agent.enabled}
+            loading={testRun.isPending}
+            onClick={submit}
+          >
+            <span className="i-ri-send-plane-2-line" />
+            {t(($) => $.sendMessage)}
+          </Button>
+        </div>
+      </div>
+    </div>
+  )
+}
+
+export function UlooAgentDebugDialog({
+  agent,
+  open,
+  preview,
+  onOpenChange,
+}: UlooAgentDebugDialogProps) {
+  const { t } = useTranslation('uloo')
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange} disablePointerDismissal>
+      <DialogContent className="flex h-[min(760px,calc(100dvh-2rem))] w-[760px] max-w-[calc(100vw-2rem)] flex-col overflow-hidden p-0!">
+        <DialogCloseButton />
+        <div className="shrink-0 border-b border-divider-subtle px-6 py-5 pr-14">
+          <DialogTitle className="title-2xl-semi-bold text-text-primary">
+            {t(($) => $.debugAgent, { name: agent?.name ?? '' })}
+          </DialogTitle>
+          <DialogDescription className="mt-1 text-sm text-text-tertiary">
+            {agent ? `${agent.role} · ${agent.model_ref}` : ''}
+          </DialogDescription>
+        </div>
+        {agent && (
+          <UlooAgentDebugSession
+            key={`${agent.id}-${agent.version}-${open}`}
+            agent={agent}
+            preview={preview}
+          />
+        )}
+      </DialogContent>
+    </Dialog>
+  )
+}

+        name: 'Research',
+        description: '',
+        config: {
+          instructions: ['Cite sources', 'Compare dates'],
+          tool_refs: ['web-search'],
+          scenarios: '',
+          steps: [],
+          result_format: '',
+          quality_checks: [],
+        },
+        enabled: true,
+      },
